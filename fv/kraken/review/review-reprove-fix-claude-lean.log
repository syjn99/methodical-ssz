def Fk.Regress.Joint : Nat → BitVec 64 → Prop :=
fun S ty =>
  MakesliceC bumpHeap ty 1 S ∧
    MemmoveC S ∧
      GrowsliceC bumpHeap ty 1 S ∧
        NewobjectC bumpHeap ty 16 S ∧
          FmtErrorfNilC S ∧
            FmtErrorfWC bumpHeap S ∧ ConvT64C bumpHeap S ∧ ValidateBitlistC S ∧ ValidateBitlistErrC bumpHeap S
WitLcA1.lc_accept_runs : ∀ (zmms : RegZmms) (flags : StatusFlags),
  Eventually (step1 Host.exe) (fun st => st.pc = Int64.ofBitVec (UInt64.toBitVec 0) ∧ st.data.regs.rax = 0)
    { data := WitLcA1.s0 zmms flags, pc := Host.addrOf 5 }
WitBlR.bl_marshal_reject_runs : ∀ (zmms : RegZmms) (flags : StatusFlags),
  Eventually (step1 Host.exe)
    (fun st => st.pc = Int64.ofBitVec (UInt64.toBitVec 0) ∧ st.data.regs.rax = 0 ∧ st.data.regs.rdi ≠ 0)
    { data := WitBlR.s0 zmms flags, pc := Host.addrOf 5 }
WitVbvR.vbv_reject_pad_runs : ∀ (b : UInt8),
  16 ≤ b.toNat →
    ∀ (zmms : RegZmms) (flags : StatusFlags),
      Eventually (step1 Host.exe)
        (fun st =>
          st.pc = Int64.ofBitVec (UInt64.toBitVec 0) ∧
            st.data.regs.rax.toBitVec = (label "go_itab._errors.errorString_error").toBitVec)
        { data := WitVbvR.s0 b zmms flags, pc := Host.addrOf 5 }
WitLuG.lum_grow_runs : ∀ (zmms : RegZmms) (flags : StatusFlags),
  Eventually (step1 Host.exe) (fun st => st.pc = Host.addrOf (5 + 25) ∧ 6 ≤ st.data.regs.rdi.toNat)
    { data := WitLuG.s0 zmms flags, pc := Host.addrOf (5 + 13) }
'lu_unmarshal_then_marshal' depends on axioms: [propext, Classical.choice, Quot.sound]
'Fk.Regress.joint_models' depends on axioms: [propext, Classical.choice, Quot.sound]
'Fk.WitLcA1.lc_accept_runs' depends on axioms: [propext, Classical.choice, Quot.sound]
'Fk.WitBlR.bl_marshal_reject_runs' depends on axioms: [propext, Classical.choice, Quot.sound]
'Fk.WitVbvR.vbv_reject_pad_runs' depends on axioms: [propext, Classical.choice, Quot.sound]
'Fk.WitLuG.lum_grow_runs' depends on axioms: [propext, Classical.choice, Quot.sound]
'bv_errstr' depends on axioms: [propext, Classical.choice, Quot.sound]
