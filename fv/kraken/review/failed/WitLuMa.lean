      ⋆ Eq ([4, 0, 0, 0].At s.regs.rbx.toBitVec)
      ⋆ Eq ((Int.toBytes 8 (65544 : UInt64).toBitVec.toInt).At (label "ssz.ErrIncorrectListSize").toBitVec)
      ⋆ Eq ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt).At (label "ssz.ErrIncorrectListSize" + 8).toBitVec)
      ⋆ Eq ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt).At ((65544 : UInt64).toBitVec + 8)) ⋆ Eq ((z 24).At (s.regs.rsp.toBitVec - 96)) ⋆ Eq ((z 32).At (s.regs.rsp.toBitVec - 40))
      ⋆ Eq ((z 8).At (s.regs.rsp.toBitVec + 8)) ⋆ Eq ((z 42435).At (label "go_string._" + 211).toBitVec) ⋆ fun _ => True := by
  intro s
  have H : Eq ((block ).At (0x10000 : BitVec 64)) (mem ) := rfl
  conv at H => lhs; unfold block
  repeat rw [Mem.At_append_sep _ _ _ (by simp only [List.length_append, List.length_replicate, Int.toBytes_length, List.length_cons, List.length_nil]; omega)] at H
  simp only [List.length_replicate, Int.toBytes_length, List.length_cons, List.length_nil, Nat.reduceAdd,
    BitVec.ofNat_eq_ofNat, BitVec.reduceAdd] at H
  rw [label_err, label_gs]
  simp only [Int64.toBitVec_add, Int64.toBitVec_ofNat, BitVec.reduceAdd]
  simp only [s, s0, UInt64.toBitVec_ofNat, BitVec.ofNat_eq_ofNat, BitVec.reduceAdd, BitVec.reduceSub,
