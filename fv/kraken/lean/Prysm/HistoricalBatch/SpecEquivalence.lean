import Prysm.HistoricalBatch.Spec
import Prysm.HistoricalBatch.SpecChecker

/-!
# The hand `Desc` of HistoricalBatch and the Desc checker's `Desc`

The text of `Prysm.SyncCommittee.SpecEquivalence`. `Prysm.HistoricalBatch.checkerDesc` (`Prysm/HistoricalBatch/SpecChecker.lean`, generated by
`gen/e2e/lvdescterm.py` from the producer file whose sha256 is the checker record) has the same kinds in the same
order as `desc`; only the field names differ. EthLib's codec ignores the names, so the two `Desc`s accept the
same inputs with the same values.
-/

namespace Prysm.HistoricalBatch
open EthLib.Serialization.Ssz Spec

theorem desc_checker :
    desc = .container ["block_roots", "state_roots"] [.vector (.byteVector 32) 8192, .vector (.byteVector 32) 8192]
    ∧ checkerDesc = .container ["BlockRoots", "StateRoots"]
      [.vector (.byteVector 32) 8192, .vector (.byteVector 32) 8192] :=
  ⟨rfl, rfl⟩

theorem checker_wellFormed : checkerDesc.wellFormed = .ok () := by rfl

/-- EthLib's `serialize` ignores container names. -/
theorem desc_serialize_checker (v : Value) : serialize desc v = serialize checkerDesc v := by
  unfold desc checkerDesc
  cases v <;> (try simp only [serialize, serializeStruct]) <;> rfl

theorem serialize_checker (g : SszValue) : serialize checkerDesc g.toValue = .ok (SszValue.encode g) := by
  rw [← desc_serialize_checker]; exact toValue_serialize g

theorem toValue_fits_checker (g : SszValue) : Value.fits checkerDesc g.toValue = true := by
  simp [checkerDesc, SszValue.toValue, Value.fits, Value.fieldsFit, Codec.allFit_map_byteVector32]

theorem toValue_surjective_checker (v : Value) (h : Value.fits checkerDesc v = true) :
    ∃ g : SszValue, g.toValue = v := by
  have h' : Value.fits desc v = true := by
    cases v <;> simp_all [desc, checkerDesc, Value.fits]
  exact toValue_surjective v h'

/-- **Codec equality on the accepted inputs.** -/
theorem desc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize desc bs = .ok v ↔ deserialize checkerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_encode h
    rw [hb]
    exact deserialize_enc (G := SszValue) (toV := SszValue.toValue) (enc := SszValue.encode) checker_wellFormed
      serialize_checker toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := SszValue) (toV := SszValue.toValue) (enc := SszValue.encode) checker_wellFormed
      serialize_checker toValue_surjective_checker h
    rw [hb]; exact encode_roundtrip g

end Prysm.HistoricalBatch
