import Prysm.IndexedAttestation.Spec
import Prysm.IndexedAttestation.SpecChecker

/-!
# The hand `Desc` of IndexedAttestation and the Desc checker's `Desc`

`checkerDesc` (`Prysm/IndexedAttestation/SpecChecker.lean`, generated by `gen/e2e/lvdescterm.py` from the producer file whose sha256 is the
checker record) has the same kinds in the same order as `desc`; only the field names differ, also in the nested
AttestationData and Checkpoint containers. EthLib's codec ignores the names (`Prysm.AttestationData.desc_serialize_checker` for
the nested part), so the two `Desc`s accept the same inputs with the same values. The text of `Prysm/SyncCommittee/SpecEquivalence.lean` and of
the checker section of `Prysm/AttestationData/Spec.lean`.
-/

namespace Prysm.IndexedAttestation
open EthLib.Serialization.Ssz Spec TestTarget

theorem desc_checker :
    desc = .container ["attesting_indices", "data", "signature"]
      [.list (.uint 8) 2048, Prysm.AttestationData.desc, .byteVector 96]
    ∧ checkerDesc = .container ["AttestingIndices", "Data", "Signature"]
      [.list (.uint 8) 2048, Prysm.AttestationData.checkerDesc, .byteVector 96] :=
  ⟨rfl, rfl⟩

theorem checker_wellFormed : checkerDesc.wellFormed = .ok () := by rfl

/-- EthLib's `serialize` ignores container names, also the nested ones. -/
theorem desc_serialize_checker (v : Value) : serialize desc v = serialize checkerDesc v := by
  rw [desc_checker.1, desc_checker.2]
  cases v <;> simp only [serialize]
  rename_i vs
  simp only [serializeStruct]
  rw [Prysm.AttestationData.serializeFields_congr _ [.list (.uint 8) 2048, Prysm.AttestationData.checkerDesc, .byteVector 96] vs
    (.cons (fun _ => rfl) (.cons Prysm.AttestationData.desc_serialize_checker (.cons (fun _ => rfl) .nil)))]
  rfl

theorem serialize_checker (g : SszValue) : serialize checkerDesc g.toValue = .ok (SszValue.encode g) := by
  rw [← desc_serialize_checker]; exact toValue_serialize g

theorem toValue_fits_checker (g : SszValue) : Value.fits checkerDesc g.toValue = true := by
  have h1 := Prysm.AttestationData.SszValue.toValue_fits_checker g.data
  have h2 := g.hidx
  rw [desc_checker.2]
  simp only [SszValue.toValue, Value.fits, Value.fieldsFit]
  simp [h1, allFit_u64, h2]

theorem toValue_surjective_checker (v : Value) (h : Value.fits checkerDesc v = true) :
    ∃ g : SszValue, g.toValue = v := by
  rw [desc_checker.2] at h
  obtain ⟨vs, rfl, hf⟩ := fits_container h
  have hl := fieldsFit_length hf
  match vs, hl with
  | [v0, v1, v2], _ =>
    simp only [fieldsFit_cons] at hf
    obtain ⟨h0, h1, h2, -⟩ := hf
    obtain ⟨es, rfl, hlen, hall⟩ : ∃ es, v0 = .seq es ∧ es.length ≤ 2048 ∧ Value.allFit (.uint 8) es = true := by
      cases v0 <;> simp [Value.fits] at h0 ⊢; exact h0
    obtain ⟨l, rfl⟩ := allFit_u64_inv es hall
    obtain ⟨d, rfl⟩ := Prysm.AttestationData.SszValue.toValue_surjective_checker v1 h1
    obtain ⟨z, rfl, hz⟩ : ∃ d, v2 = .bytes d ∧ d.size = 96 := by
      cases v2 <;> simp [Value.fits] at h2 ⊢; exact h2
    exact ⟨⟨l, by simpa using hlen, d, ⟨z, hz⟩⟩, rfl⟩

/-- **Codec equality on the accepted inputs.** -/
theorem desc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize desc bs = .ok v ↔ deserialize checkerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_encode h
    rw [hb]
    exact deserialize_enc (G := SszValue) (toV := SszValue.toValue) (enc := SszValue.encode) checker_wellFormed
      serialize_checker toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := SszValue) (toV := SszValue.toValue) (enc := SszValue.encode) checker_wellFormed
      serialize_checker toValue_surjective_checker h
    rw [hb]; exact encode_roundtrip g

end Prysm.IndexedAttestation
