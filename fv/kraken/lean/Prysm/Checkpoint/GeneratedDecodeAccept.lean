  simp only at hrsp' hrbp' hr14' hrY Hm'
  subst rsp2 rbp2 r142
  apply Decode.generated_s75 k hk hf (rsp.toBitVec - 88) (rsp.toBitVec - 32) p1 (by simp only [Int64.toBitVec_ofNat] <;> bv_omega) _ _ _ (by rfl) (by ecancel)
