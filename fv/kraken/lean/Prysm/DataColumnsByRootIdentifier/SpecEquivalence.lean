import Prysm.DataColumnsByRootIdentifier.SpecDecodeBridge
import Prysm.DataColumnsByRootIdentifier.SpecChecker

/-!
# The hand `Desc` of DataColumnsByRootIdentifier and the Desc checker's `Desc`

`Prysm.DataColumnsByRootIdentifier.checkerDesc` (`Prysm/DataColumnsByRootIdentifier/SpecChecker.lean`, generated by `gen/e2e/lvdescterm.py` from the producer file whose sha256
`832fc183…` is the checker record in `gen/desc/results/main.result.json`) has the same kinds in the same order as
`desc`; only the field names differ. EthLib's codec ignores the names, so the two `Desc`s serialize every value
alike and accept the same inputs with the same values. The text of `Prysm/IndexedAttestation/SpecEquivalence.lean`.
-/

namespace Prysm.DataColumnsByRootIdentifier
open EthLib.Serialization.Ssz Spec TestTarget

theorem desc_checker :
    desc = .container ["block_root", "columns"] [.byteVector 32, .list (.uint 8) 128]
    ∧ Prysm.DataColumnsByRootIdentifier.checkerDesc = .container ["BlockRoot", "Columns"] [.byteVector 32, .list (.uint 8) 128] :=
  ⟨rfl, rfl⟩

theorem checker_wellFormed : Prysm.DataColumnsByRootIdentifier.checkerDesc.wellFormed = .ok () := by rfl

/-- EthLib's `serialize` ignores container names. -/
theorem desc_serialize_checker (v : Value) : serialize desc v = serialize Prysm.DataColumnsByRootIdentifier.checkerDesc v := by
  rw [desc_checker.1, desc_checker.2]
  cases v <;> simp only [serialize]

theorem serialize_checker (g : SszValue) : serialize Prysm.DataColumnsByRootIdentifier.checkerDesc g.toValue = .ok (SszValue.encode g) := by
  rw [← desc_serialize_checker]; exact toValue_serialize g

theorem toValue_fits_checker (g : SszValue) : Value.fits Prysm.DataColumnsByRootIdentifier.checkerDesc g.toValue = true := by
  have h2 := g.hcols
  rw [desc_checker.2]
  simp only [SszValue.toValue, receiverValue, Value.fits, Value.fieldsFit]
  simp [allFit_u64, h2]

theorem toValue_surjective_checker (v : Value) (h : Value.fits Prysm.DataColumnsByRootIdentifier.checkerDesc v = true) :
    ∃ g : SszValue, g.toValue = v := by
  apply toValue_surjective
  rw [desc_checker.1]; rw [desc_checker.2] at h
  cases v <;> simp_all [Value.fits]

/-- **Codec equality on the accepted inputs.** -/
theorem desc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize desc bs = .ok v ↔ deserialize Prysm.DataColumnsByRootIdentifier.checkerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_encode h
    rw [hb]
    exact deserialize_enc (G := SszValue) (toV := SszValue.toValue) (enc := SszValue.encode) checker_wellFormed
      serialize_checker toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := SszValue) (toV := SszValue.toValue) (enc := SszValue.encode) checker_wellFormed
      serialize_checker toValue_surjective_checker h
    rw [hb]; exact encode_roundtrip g

end Prysm.DataColumnsByRootIdentifier
