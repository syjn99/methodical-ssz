import Prysm.Checkpoint.Spec
import Prysm.Checkpoint.SpecEquivalence
import Prysm.Eth1Data.SpecDescription
import Prysm.Eth1Data.SpecChecker

/-!
# Spec bridge for the real Prysm `v1alpha1.Eth1Data` (hold-out)

Hand-written (the text of `Prysm/BeaconBlockHeader/Spec.lean` with the Eth1Data fields).
`desc` (`Prysm/Eth1Data/SpecDescription.lean`) is the independent hand `Desc` from consensus-specs phase0; it was committed
(c43359b) before `checkerDesc` was rendered and printed.
`checkerDesc` (generated by `gen/checks/desc_to_lean.py`) is the Desc checker's Desc of `(v1alpha1, Eth1Data)`
(producer output sha256 `6064a3dc…` = the checker record in `gen/desc/results/main.result.json`).
`desc_checker`: same kinds in the same order (only the names differ);
`desc_serialize_checker`: equal `serialize` on every value; `desc_deserialize_checker`:
the same accepted inputs with the same values (EthLib error values are not compared).
`SszValue` is the SSZ content of a Go `v1alpha1.Eth1Data` whose two roots have length 32.
-/

namespace Prysm.Eth1Data
open EthLib.Serialization.Ssz
open Spec hiding readUint_lt

/-- The checker's Desc has the same kinds in the same order; only the names differ. -/
theorem desc_checker :
    desc = .container ["deposit_root", "deposit_count", "block_hash"]
      [.byteVector 32, .uint 8, .byteVector 32]
    ∧ checkerDesc = .container ["DepositRoot", "DepositCount", "BlockHash"]
      [.byteVector 32, .uint 8, .byteVector 32] :=
  ⟨rfl, rfl⟩

theorem desc_wellFormed : desc.wellFormed = .ok () := by rfl
theorem desc_fixedSize : desc.fixedSize = some 72 := by rfl

/-- EthLib's `serialize` ignores container names: the hand Desc and the checker Desc encode every value
the same way. -/
theorem desc_serialize_checker (v : Value) : serialize desc v = serialize checkerDesc v := by
  unfold desc checkerDesc
  cases v <;> (try simp only [serialize, serializeStruct]) <;> rfl

/-- The SSZ content of a Go `v1alpha1.Eth1Data` (both roots of length 32). -/
structure SszValue where
  depositRoot : Vector UInt8 32
  depositCount : UInt64
  blockHash : Vector UInt8 32

def SszValue.toValue (g : SszValue) : Value :=
  .seq [.bytes g.depositRoot.toArray, .uint g.depositCount.toNat, .bytes g.blockHash.toArray]

/-- `depositRoot ++ uintBytes 8 depositCount ++ blockHash`. -/
def SszValue.encode (g : SszValue) : Array UInt8 :=
  g.depositRoot.toArray ++ uintBytes 8 g.depositCount.toNat ++ g.blockHash.toArray

theorem SszValue.encode_size (g : SszValue) : (SszValue.encode g).size = 72 := by
  simp [SszValue.encode, Spec.uintBytes_size]

theorem SszValue.toValue_fits (g : SszValue) : Value.fits desc g.toValue = true := by
  have := g.depositCount.toNat_lt
  simp only [desc, SszValue.toValue, Value.fits, Value.fieldsFit] at *
  simp; omega

theorem SszValue.toValue_injective (g h : SszValue) (e : g.toValue = h.toValue) : g = h := by
  obtain ⟨r, a, t⟩ := g; obtain ⟨r', a', t'⟩ := h
  simp only [SszValue.toValue, Value.seq.injEq, List.cons.injEq, Value.uint.injEq, Value.bytes.injEq,
    and_true] at e
  obtain ⟨e1, e2, e3⟩ := e
  rw [Vector.toArray_inj.mp e1, UInt64.toNat_inj.mp e2, Vector.toArray_inj.mp e3]

theorem SszValue.toValue_surjective (D : Desc)
    (hD : D = desc ∨ D = checkerDesc) (v : Value) (h : Value.fits D v = true) :
    ∃ g : SszValue, g.toValue = v := by
  have h' : Value.fits desc v = true := by
    rcases hD with rfl | rfl
    · exact h
    · cases v <;> simp_all [desc, checkerDesc, Value.fits]
  obtain ⟨vs, rfl, hf⟩ := fits_container h'
  have hl := fieldsFit_length hf
  match vs, hl with
  | [v1, v2, v3], _ =>
    simp only [fieldsFit_cons] at hf
    obtain ⟨h1, h2, h3, -⟩ := hf
    obtain ⟨d, rfl, hd⟩ : ∃ d, v1 = .bytes d ∧ d.size = 32 := by
      cases v1 <;> simp [Value.fits] at h1 ⊢; exact h1
    obtain ⟨a, rfl, ha⟩ := fits_uint h2
    obtain ⟨f, rfl, hf⟩ : ∃ d, v3 = .bytes d ∧ d.size = 32 := by
      cases v3 <;> simp [Value.fits] at h3 ⊢; exact h3
    simp only [Nat.reduceMul, Nat.reducePow] at ha
    exact ⟨⟨⟨d, hd⟩, UInt64.ofNat a, ⟨f, hf⟩⟩, by simp [SszValue.toValue, Nat.mod_eq_of_lt ha]⟩

theorem SszValue.toValue_surjective' (v : Value) (h : Value.fits desc v = true) : ∃ g : SszValue, g.toValue = v :=
  SszValue.toValue_surjective _ (.inl rfl) v h

/-- **`serialize g = depositRoot ‖ depositCount ‖ blockHash`.** -/
theorem SszValue.serialize_eq (g : SszValue) : serialize desc g.toValue = .ok (SszValue.encode g) := by
  obtain ⟨⟨r, hr⟩, a, ⟨t, ht⟩⟩ := g
  have := a.toNat_lt
  simp only [desc, SszValue.toValue, serialize, serializeStruct, serializeFields, Vector.toArray_mk, hr, ht]
  simp (config := {decide := true}) [*, bind, Except.bind, pure, Except.pure, assemble, headWidth, bodyWidth,
    headOf, bodiesOf, Desc.isFixed, Desc.fixedSize, Spec.uintBytes_size, bytesPerOffset, SszValue.encode,
    Desc.fieldsFixedSize, Array.append_assoc]

/-- **Spec roundtrip.** -/
theorem SszValue.roundtrip (g : SszValue) : deserialize desc (SszValue.encode g) = .ok g.toValue :=
  deserialize_encoding (G := SszValue) (toV := SszValue.toValue) (enc := SszValue.encode) desc_wellFormed SszValue.serialize_eq
    SszValue.toValue_fits g

theorem SszValue.accepted_is_encoding {bs : Array UInt8} {v : Value} (h : deserialize desc bs = .ok v) :
    ∃ g : SszValue, v = g.toValue ∧ bs = SszValue.encode g :=
  accepted_input_is_encoding (G := SszValue) (toV := SszValue.toValue) (enc := SszValue.encode) desc_wellFormed SszValue.serialize_eq
    SszValue.toValue_surjective' h

/-- **EthLib accepts exactly the 72-byte inputs.** -/
theorem SszValue.spec_accepts_iff (bs : Array UInt8) : (∃ v, deserialize desc bs = .ok v) ↔ bs.size = 72 := by
  constructor
  · rintro ⟨v, hd⟩
    obtain ⟨g, rfl, rfl⟩ := SszValue.accepted_is_encoding hd
    exact SszValue.encode_size g
  · intro h
    have r0 := readUint_lt bs 32 8
    simp only [Nat.reducePow, Nat.reduceMul] at r0
    let g : SszValue := ⟨⟨bs.extract 0 32, by simp; omega⟩, UInt64.ofNat (readUint bs 32 8),
      ⟨bs.extract 40 72, by simp; omega⟩⟩
    have e : bs = SszValue.encode g := by
      simp only [g, SszValue.encode, UInt64.toNat_ofNat_of_lt' r0, uintBytes_readUint_slice bs 32 8 (by omega)]
      simp only [Nat.zero_add, Nat.reduceAdd]
      simp (config := {decide := true}) only [Array.extract_append_extract, Nat.min_def, Nat.max_def, ↓reduceIte]
      rw [← h]; simp
    rw [e]
    exact ⟨_, SszValue.roundtrip g⟩

/-- `len(buf) ≠ 72`: EthLib rejects. -/
theorem SszValue.spec_rejects (bs : Array UInt8) (h : bs.size ≠ 72) : ∃ e, deserialize desc bs = .error e := by
  cases hd : deserialize desc bs with
  | error e => exact ⟨e, rfl⟩
  | ok v => exact absurd ((SszValue.spec_accepts_iff bs).mp ⟨v, hd⟩) h

/-! ### The checker Desc decodes like the hand Desc (accepted inputs and values) -/

theorem checker_wellFormed : checkerDesc.wellFormed = .ok () := by rfl

theorem SszValue.serialize_eq_checker (g : SszValue) : serialize checkerDesc g.toValue = .ok (SszValue.encode g) := by
  rw [← desc_serialize_checker]; exact SszValue.serialize_eq g

theorem SszValue.toValue_fits_checker (g : SszValue) : Value.fits checkerDesc g.toValue = true := by
  have := g.depositCount.toNat_lt
  simp [checkerDesc, SszValue.toValue, Value.fits, Value.fieldsFit]; omega

/-- **Codec equality on the accepted inputs**: the checker Desc accepts `bs` with value `v` exactly when
the hand Desc does. -/
theorem desc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize desc bs = .ok v ↔ deserialize checkerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, rfl⟩ := SszValue.accepted_is_encoding h
    exact deserialize_encoding (G := SszValue) (toV := SszValue.toValue) (enc := SszValue.encode) checker_wellFormed
      SszValue.serialize_eq_checker SszValue.toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, rfl⟩ := accepted_input_is_encoding (G := SszValue) (toV := SszValue.toValue) (enc := SszValue.encode) checker_wellFormed
      SszValue.serialize_eq_checker (SszValue.toValue_surjective _ (.inr rfl)) h
    exact SszValue.roundtrip g

end Prysm.Eth1Data
