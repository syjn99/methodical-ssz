    _ (k + 88) (k + 91) (win hk 88 3) (by rfl) (by rfl) hl
    _ (k + 92) (win hk 91 1) (by rfl) (by rfl) _ (win hk 92 2) (by rfl)
    s ra guard e0 e1 fp s2 hfp h2 R h_mem hguard (fun h => hlen (h.trans (by rfl)))
