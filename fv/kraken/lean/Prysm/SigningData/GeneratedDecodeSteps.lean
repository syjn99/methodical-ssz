    (final : MachineState → Prop) (s : MachineData)
    (hb : s.regs.get64 Reg64.rdx = base) (hm : (Eq (bs.At a) ⋆ F) s.dmem)
    (hk' : ∀ m' : DataMem, (Eq ((Int.toBytes 8 (@BitVec.toInt 64 (s.regs.get64 Reg64.rsi))).At a) ⋆ F) m' →
      Eventually (step1 Host.exe) final ⟨{ s with dmem := m' }, Host.addrOf (k + 83)⟩),
    Eventually (step1 Host.exe) final ⟨s, Host.addrOf (k + 82)⟩ := by
  have hq := Codec.win hk 82 1
  have he : Codec.eraseNop ((unmarshalSSZ.drop 82).take 1) = [Codec.iSt Reg64.rsi Reg64.rdx 24] := by rfl
  have hend : k + 82 + ((unmarshalSSZ.drop 82).take 1).length = k + 83 := by rfl
  with_reducible exact Codec.kstep_st Reg64.rsi Reg64.rdx 24 _ (k + 82) (k + 83) hq he hend
theorem Decode.generated_step_s82_kind : ∀ (h : Host), type_of% (@Decode.generated_step_s82 h) = @Codec.stepStKind h unmarshalSSZ Reg64.rsi Reg64.rdx 24 82 83 := by
  intro h; with_reducible rfl

end Prysm.SigningData
