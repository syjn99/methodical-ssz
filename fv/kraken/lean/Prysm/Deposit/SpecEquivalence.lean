import Prysm.Deposit.Spec
import Prysm.Deposit.SpecChecker

/-!
# The hand `Desc` of Deposit and the Desc checker's `Desc`

The text of `Prysm.HistoricalBatch.SpecEquivalence`. `Prysm.Deposit.checkerDesc` (`Prysm/Deposit/SpecChecker.lean`, generated by `gen/e2e/lvdescterm.py` from
the producer file whose sha256 `cd4b71f0…` is the checker record) has the same kinds in the same order as
`desc`; only the field names differ (also in the nested Deposit_Data container). EthLib's codec ignores the
names, so the two `Desc`s accept the same inputs with the same values.
-/

namespace Prysm.Deposit
open EthLib.Serialization.Ssz Spec Codec.Segment

theorem desc_checker :
    desc = .container ["proof", "data"] [.vector (.byteVector 32) 33, .container
      ["pubkey", "withdrawal_credentials", "amount", "signature"] [.byteVector 48, .byteVector 32, .uint 8, .byteVector 96]]
    ∧ checkerDesc = .container ["Proof", "Data"] [.vector (.byteVector 32) 33, .container
      ["PublicKey", "WithdrawalCredentials", "Amount", "Signature"] [.byteVector 48, .byteVector 32, .uint 8, .byteVector 96]] :=
  ⟨rfl, rfl⟩

theorem checker_wellFormed : checkerDesc.wellFormed = .ok () := by rfl

theorem serialize_checker (g : SszValue) : serialize checkerDesc g.toValue = .ok (SszValue.encode g) := by
  obtain ⟨pr, d⟩ := g
  have hl1 := vN_flatten_length 33 pr
  have hs1 := vN_serialize 33 (by decide) pr
  have hs2 := Prysm.Deposit_Data.SszValue.serialize_eq_checker d
  have hl2 := Prysm.Deposit_Data.SszValue.enc_size d
  simp only [Prysm.Deposit_Data.checkerDesc] at hs2
  simp only [checkerDesc, SszValue.toValue, serialize, serializeStruct, serializeFields] at hs1 ⊢
  simp only [List.length_map, Vector.length_toList, beq_self_eq_true, ↓reduceIte] at hs1 ⊢
  rw [hs1, hs2]
  simp (config := {decide := true}) [bind, Except.bind, pure, Except.pure, assemble, headWidth, bodyWidth,
    headOf, bodiesOf, Desc.isFixed, Desc.fixedSize, bytesPerOffset, SszValue.encode, SszValue.proofs, Desc.fieldsFixedSize,
    Array.append_assoc, hl1, hl2]

theorem toValue_fits_checker (g : SszValue) : Value.fits checkerDesc g.toValue = true := by
  have h := Prysm.Deposit_Data.SszValue.toValue_fits_checker g.data
  simp only [Prysm.Deposit_Data.checkerDesc] at h
  simp [checkerDesc, SszValue.toValue, Value.fits, Value.fieldsFit, Codec.allFit_map_byteVector32, h]

theorem toValue_surjective_checker (v : Value) (h : Value.fits checkerDesc v = true) :
    ∃ g : SszValue, g.toValue = v := by
  have hr : ∀ w : Value, Value.fits (.container ["PublicKey", "WithdrawalCredentials", "Amount", "Signature"]
      [.byteVector 48, .byteVector 32, .uint 8, .byteVector 96]) w = Value.fits (.container
      ["pubkey", "withdrawal_credentials", "amount", "signature"] [.byteVector 48, .byteVector 32, .uint 8,
      .byteVector 96]) w := by
    intro w; cases w <;> simp [Value.fits]
  have h' : Value.fits desc v = true := by
    cases v <;> simp_all [desc, checkerDesc, Prysm.Deposit_Data.desc, Value.fits]
    rename_i es
    rcases es with _ | ⟨e0, _ | ⟨e1, _ | _⟩⟩ <;> simp_all [Value.fieldsFit]
  exact toValue_surjective v h'

/-- **Codec equality on the accepted inputs.** -/
theorem desc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize desc bs = .ok v ↔ deserialize checkerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_encode h
    rw [hb]
    exact deserialize_encoding (G := SszValue) (toV := SszValue.toValue) (enc := SszValue.encode) checker_wellFormed
      serialize_checker toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_input_is_encoding (G := SszValue) (toV := SszValue.toValue) (enc := SszValue.encode) checker_wellFormed
      serialize_checker toValue_surjective_checker h
    rw [hb]; exact encode_roundtrip g

end Prysm.Deposit
