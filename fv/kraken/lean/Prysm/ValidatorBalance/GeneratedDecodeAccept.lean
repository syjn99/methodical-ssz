    (rsp.toBitVec - 72) (rsp.toBitVec - 80) (rsp.toBitVec - 56) (by bv_omega) (by bv_omega) (by bv_omega)
    { toBitVec := rsp.toBitVec - 8#64 } r14 guard fv0 rslot lo sp1 aN0
    hfv0 hrslot hlo hsp1 haN0 hg _ _
    (by rfl) (by rfl) (by rfl) (by rfl) (by rfl) (by first | rfl | decide) (by ecancel)) ?_
  rintro ⟨d', pc'⟩ ⟨hpc', hrax', hrbx', hrsp', hrbp', hr14', Hm'⟩
  dsimp only at hpc' hrax' hrbx' hrsp' hrbp' hr14' Hm'
  apply Eventually.done
  refine ⟨hpc', hrsp', hrbp', hr14', (congrArg UInt64.toBitVec hrax'), (congrArg UInt64.toBitVec hrbx'), (Int.toBytes 8 rbx.toBitVec.toInt), (Int.toBytes 8 (rsp.toBitVec - 8#64).toInt),
    (Int.toBytes_length 8 _), (Int.toBytes_length 8 _), ?_⟩
  dsimp only
  rw [show k + 17 + 1 = k + 18 from rfl] at Hm'
  ecancel
