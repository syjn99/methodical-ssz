import E2e.Spec
import E2e.SpecEq
import E2eScal.PdDesc
import E2eScal.PdSpecChecker

/-!
# Spec bridge for the real Prysm `v1alpha1.PendingDeposit` (hold-out, full-proof type)

Hand-written: the text of `DdSpec.lean` with the fifth field `slot` (uint64).
`prysmPdDesc` (`PdDesc.lean`) is the independent hand `Desc` from consensus-specs electra; it was committed
before `pdCheckerDesc` was rendered and printed.
`pdCheckerDesc` (generated by `gen/e2e/descterm.py`) is the Desc checker's Desc of `(v1alpha1, PendingDeposit)`
(producer output sha256 `0dc63871…` = the checker record in `gen/desc/results/main.result.json`).
`PPd` is the SSZ content of a Go `v1alpha1.PendingDeposit` whose PublicKey, WithdrawalCredentials and Signature have
lengths 48, 32 and 96.
-/

namespace E2e
open EthLib.Serialization.Ssz Fv1

/-- The checker's Desc has the same kinds in the same order; only the names differ. -/
theorem prysmPdDesc_checker :
    prysmPdDesc = .container ["pubkey", "withdrawal_credentials", "amount", "signature", "slot"]
      [.byteVector 48, .byteVector 32, .uint 8, .byteVector 96, .uint 8]
    ∧ pdCheckerDesc = .container ["PublicKey", "WithdrawalCredentials", "Amount", "Signature", "Slot"]
      [.byteVector 48, .byteVector 32, .uint 8, .byteVector 96, .uint 8] :=
  ⟨rfl, rfl⟩

theorem prysmPdDesc_wellFormed : prysmPdDesc.wellFormed = .ok () := by rfl
theorem prysmPdDesc_fixedSize : prysmPdDesc.fixedSize = some 192 := by rfl

/-- EthLib's `serialize` ignores container names. -/
theorem prysmPdDesc_serialize_checker (v : Value) : serialize prysmPdDesc v = serialize pdCheckerDesc v := by
  unfold prysmPdDesc pdCheckerDesc
  cases v <;> (try simp only [serialize, serializeStruct]) <;> rfl

/-- The SSZ content of a Go `v1alpha1.PendingDeposit` (PublicKey 48, WithdrawalCredentials 32, Signature 96 bytes). -/
structure PPd where
  pubkey : Vector UInt8 48
  withdrawalCredentials : Vector UInt8 32
  amount : UInt64
  signature : Vector UInt8 96
  slot : UInt64

def PPd.toValue (g : PPd) : Value :=
  .seq [.bytes g.pubkey.toArray, .bytes g.withdrawalCredentials.toArray, .uint g.amount.toNat,
    .bytes g.signature.toArray, .uint g.slot.toNat]

/-- `pubkey ++ withdrawalCredentials ++ uintBytes 8 amount ++ signature ++ uintBytes 8 slot`. -/
def ppdEnc (g : PPd) : Array UInt8 :=
  g.pubkey.toArray ++ g.withdrawalCredentials.toArray ++ uintBytes 8 g.amount.toNat ++ g.signature.toArray
    ++ uintBytes 8 g.slot.toNat

theorem ppd_enc_size (g : PPd) : (ppdEnc g).size = 192 := by
  simp [ppdEnc, Fv.uintBytes_size]

theorem ppd_toValue_fits (g : PPd) : Value.fits prysmPdDesc g.toValue = true := by
  have := g.amount.toNat_lt
  have := g.slot.toNat_lt
  simp only [prysmPdDesc, PPd.toValue, Value.fits, Value.fieldsFit] at *
  simp; omega

theorem ppd_toValue_injective (g h : PPd) (e : g.toValue = h.toValue) : g = h := by
  obtain ⟨p, r, a, q, l⟩ := g; obtain ⟨p', r', a', q', l'⟩ := h
  simp only [PPd.toValue, Value.seq.injEq, List.cons.injEq, Value.uint.injEq, Value.bytes.injEq,
    and_true] at e
  obtain ⟨e0, e1, e2, e3, e4⟩ := e
  rw [Vector.toArray_inj.mp e0, Vector.toArray_inj.mp e1, UInt64.toNat_inj.mp e2, Vector.toArray_inj.mp e3,
    UInt64.toNat_inj.mp e4]

theorem ppd_toValue_surjective (D : Desc)
    (hD : D = prysmPdDesc ∨ D = pdCheckerDesc) (v : Value) (h : Value.fits D v = true) :
    ∃ g : PPd, g.toValue = v := by
  have h' : Value.fits prysmPdDesc v = true := by
    rcases hD with rfl | rfl
    · exact h
    · cases v <;> simp_all [prysmPdDesc, pdCheckerDesc, Value.fits]
  obtain ⟨vs, rfl, hf⟩ := fits_container h'
  have hl := fieldsFit_length hf
  match vs, hl with
  | [v0, v1, v2, v3, v4], _ =>
    simp only [fieldsFit_cons] at hf
    obtain ⟨h0, h1, h2, h3, h4, -⟩ := hf
    obtain ⟨q, rfl, hq⟩ : ∃ d, v0 = .bytes d ∧ d.size = 48 := by
      cases v0 <;> simp [Value.fits] at h0 ⊢; exact h0
    obtain ⟨d, rfl, hd⟩ : ∃ d, v1 = .bytes d ∧ d.size = 32 := by
      cases v1 <;> simp [Value.fits] at h1 ⊢; exact h1
    obtain ⟨a, rfl, ha⟩ := fits_uint h2
    obtain ⟨z, rfl, hz⟩ : ∃ d, v3 = .bytes d ∧ d.size = 96 := by
      cases v3 <;> simp [Value.fits] at h3 ⊢; exact h3
    obtain ⟨b, rfl, hb⟩ := fits_uint h4
    simp only [Nat.reduceMul, Nat.reducePow] at ha hb
    exact ⟨⟨⟨q, hq⟩, ⟨d, hd⟩, UInt64.ofNat a, ⟨z, hz⟩, UInt64.ofNat b⟩,
      by simp [PPd.toValue, Nat.mod_eq_of_lt ha, Nat.mod_eq_of_lt hb]⟩

theorem ppd_toValue_surjective' (v : Value) (h : Value.fits prysmPdDesc v = true) : ∃ g : PPd, g.toValue = v :=
  ppd_toValue_surjective _ (.inl rfl) v h

/-- **`serialize g = pubkey ‖ withdrawalCredentials ‖ amount ‖ signature ‖ slot`.** -/
theorem ppd_serialize (g : PPd) : serialize prysmPdDesc g.toValue = .ok (ppdEnc g) := by
  obtain ⟨⟨q, hq⟩, ⟨r, hr⟩, a, ⟨z, hz⟩, l⟩ := g
  have := a.toNat_lt
  have := l.toNat_lt
  simp only [prysmPdDesc, PPd.toValue, serialize, serializeStruct, serializeFields, Vector.toArray_mk, hq, hr, hz]
  simp (config := {decide := true}) [*, bind, Except.bind, pure, Except.pure, assemble, headWidth, bodyWidth,
    headOf, bodiesOf, Desc.isFixed, Desc.fixedSize, Fv.uintBytes_size, bytesPerOffset, ppdEnc,
    Desc.fieldsFixedSize, Array.append_assoc]

/-- **Spec roundtrip.** -/
theorem ppd_roundtrip (g : PPd) : deserialize prysmPdDesc (ppdEnc g) = .ok g.toValue :=
  deserialize_enc (G := PPd) (toV := PPd.toValue) (enc := ppdEnc) prysmPdDesc_wellFormed ppd_serialize
    ppd_toValue_fits g

theorem ppd_accepted_is_enc {bs : Array UInt8} {v : Value} (h : deserialize prysmPdDesc bs = .ok v) :
    ∃ g : PPd, v = g.toValue ∧ bs = ppdEnc g :=
  accepted_is_enc (G := PPd) (toV := PPd.toValue) (enc := ppdEnc) prysmPdDesc_wellFormed ppd_serialize
    ppd_toValue_surjective' h

/-- **EthLib accepts exactly the 192-byte inputs.** -/
theorem ppd_spec_accepts_iff (bs : Array UInt8) : (∃ v, deserialize prysmPdDesc bs = .ok v) ↔ bs.size = 192 := by
  constructor
  · rintro ⟨v, hd⟩
    obtain ⟨g, rfl, hb⟩ := ppd_accepted_is_enc hd
    rw [hb]; exact ppd_enc_size g
  · intro h
    have r0 := readUint_lt bs 80 8
    have r1 := readUint_lt bs 184 8
    simp only [Nat.reducePow, Nat.reduceMul] at r0 r1
    let g : PPd := ⟨⟨bs.extract 0 48, by simp; omega⟩, ⟨bs.extract 48 80, by simp; omega⟩,
      UInt64.ofNat (readUint bs 80 8), ⟨bs.extract 88 184, by simp; omega⟩, UInt64.ofNat (readUint bs 184 8)⟩
    have e : bs = ppdEnc g := by
      simp only [g, ppdEnc, UInt64.toNat_ofNat_of_lt' r0, UInt64.toNat_ofNat_of_lt' r1,
        uintBytes_readUint_slice bs 80 8 (by omega), uintBytes_readUint_slice bs 184 8 (by omega)]
      simp only [Nat.zero_add, Nat.reduceAdd]
      simp (config := {decide := true}) only [Array.extract_append_extract, Nat.min_def, Nat.max_def, ↓reduceIte]
      rw [← h]; simp
    rw [e]
    exact ⟨_, ppd_roundtrip g⟩

/-- `len(buf) ≠ 192`: EthLib rejects. -/
theorem ppd_spec_rejects (bs : Array UInt8) (h : bs.size ≠ 192) : ∃ e, deserialize prysmPdDesc bs = .error e := by
  cases hd : deserialize prysmPdDesc bs with
  | error e => exact ⟨e, rfl⟩
  | ok v => exact absurd ((ppd_spec_accepts_iff bs).mp ⟨v, hd⟩) h

/-! ### The checker Desc decodes like the hand Desc (accepted inputs and values) -/

theorem pdChecker_wellFormed : pdCheckerDesc.wellFormed = .ok () := by rfl

theorem ppd_serialize_checker (g : PPd) : serialize pdCheckerDesc g.toValue = .ok (ppdEnc g) := by
  rw [← prysmPdDesc_serialize_checker]; exact ppd_serialize g

theorem ppd_toValue_fits_checker (g : PPd) : Value.fits pdCheckerDesc g.toValue = true := by
  have := g.amount.toNat_lt
  have := g.slot.toNat_lt
  simp [pdCheckerDesc, PPd.toValue, Value.fits, Value.fieldsFit]; omega

/-- **Codec equality on the accepted inputs**. -/
theorem prysmPdDesc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize prysmPdDesc bs = .ok v ↔ deserialize pdCheckerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := ppd_accepted_is_enc h
    rw [hb]
    exact deserialize_enc (G := PPd) (toV := PPd.toValue) (enc := ppdEnc) pdChecker_wellFormed
      ppd_serialize_checker ppd_toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := PPd) (toV := PPd.toValue) (enc := ppdEnc) pdChecker_wellFormed
      ppd_serialize_checker (ppd_toValue_surjective _ (.inr rfl)) h
    rw [hb]; exact ppd_roundtrip g

end E2e
