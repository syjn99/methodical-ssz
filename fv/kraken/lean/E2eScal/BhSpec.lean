import E2e.Spec
import E2e.SpecEq
import E2eScal.BhSpecChecker

/-!
# Spec bridge for the real Prysm `v1alpha1.BeaconBlockHeader` (H1 hold-out (ii))

Hand-written by the evaluation session. Independent hand `Desc`, written from consensus-specs phase0
(`specs/phase0/beacon-chain.md`):

    class BeaconBlockHeader(Container):
        slot: Slot                     # uint64
        proposer_index: ValidatorIndex # uint64
        parent_root: Root              # Bytes32
        state_root: Root
        body_root: Root

`bhCheckerDesc` (generated by `gen/e2e/descterm.py`) is the Desc checker's Desc of
`(v1alpha1, BeaconBlockHeader)` (producer output sha256 `e20b65c3…` = the checker record).
`prysmBhDesc_checker`: same kinds in the same order (only the names differ);
`prysmBhDesc_serialize_checker`: equal `serialize` on every value; `prysmBhDesc_deserialize_checker`:
the same accepted inputs with the same values (EthLib error values are not compared).
`PBh` is the SSZ content of a Go `v1alpha1.BeaconBlockHeader` whose three roots have length 32.
The proofs are the text of `E2eAd/Spec.lean` (AttestationData) with the nested Checkpoints removed.
-/

namespace E2e
open EthLib.Serialization.Ssz Fv1

/-- consensus-specs phase0 `BeaconBlockHeader`. -/
def prysmBhDesc : Desc := .container ["slot", "proposer_index", "parent_root", "state_root", "body_root"]
  [.uint 8, .uint 8, .byteVector 32, .byteVector 32, .byteVector 32]

/-- The checker's Desc has the same kinds in the same order; only the names differ. -/
theorem prysmBhDesc_checker :
    prysmBhDesc = .container ["slot", "proposer_index", "parent_root", "state_root", "body_root"]
      [.uint 8, .uint 8, .byteVector 32, .byteVector 32, .byteVector 32]
    ∧ bhCheckerDesc = .container ["Slot", "ProposerIndex", "ParentRoot", "StateRoot", "BodyRoot"]
      [.uint 8, .uint 8, .byteVector 32, .byteVector 32, .byteVector 32] :=
  ⟨rfl, rfl⟩

theorem prysmBhDesc_wellFormed : prysmBhDesc.wellFormed = .ok () := by rfl
theorem prysmBhDesc_fixedSize : prysmBhDesc.fixedSize = some 112 := by rfl

/-- EthLib's `serialize` ignores container names: the hand Desc and the checker Desc encode every value
the same way. -/
theorem prysmBhDesc_serialize_checker (v : Value) : serialize prysmBhDesc v = serialize bhCheckerDesc v := by
  unfold prysmBhDesc bhCheckerDesc
  cases v <;> (try simp only [serialize, serializeStruct]) <;> rfl

/-- The SSZ content of a Go `v1alpha1.BeaconBlockHeader` (all three roots of length 32). -/
structure PBh where
  slot : UInt64
  proposer : UInt64
  parent : Vector UInt8 32
  state : Vector UInt8 32
  body : Vector UInt8 32

def PBh.toValue (g : PBh) : Value :=
  .seq [.uint g.slot.toNat, .uint g.proposer.toNat, .bytes g.parent.toArray, .bytes g.state.toArray,
    .bytes g.body.toArray]

/-- `uintBytes 8 slot ++ uintBytes 8 proposer ++ parent ++ state ++ body`. -/
def pbhEnc (g : PBh) : Array UInt8 :=
  uintBytes 8 g.slot.toNat ++ uintBytes 8 g.proposer.toNat ++ g.parent.toArray ++ g.state.toArray ++ g.body.toArray

theorem pbh_enc_size (g : PBh) : (pbhEnc g).size = 112 := by
  simp [pbhEnc, Fv.uintBytes_size]

theorem pbh_toValue_fits (g : PBh) : Value.fits prysmBhDesc g.toValue = true := by
  have := g.slot.toNat_lt; have := g.proposer.toNat_lt
  simp only [prysmBhDesc, PBh.toValue, Value.fits, Value.fieldsFit] at *
  simp; omega

theorem pbh_toValue_injective (g h : PBh) (e : g.toValue = h.toValue) : g = h := by
  obtain ⟨a, b, r, s, t⟩ := g; obtain ⟨a', b', r', s', t'⟩ := h
  simp only [PBh.toValue, Value.seq.injEq, List.cons.injEq, Value.uint.injEq, Value.bytes.injEq,
    and_true] at e
  obtain ⟨e1, e2, e3, e4, e5⟩ := e
  rw [UInt64.toNat_inj.mp e1, UInt64.toNat_inj.mp e2, Vector.toArray_inj.mp e3, Vector.toArray_inj.mp e4,
    Vector.toArray_inj.mp e5]

theorem pbh_toValue_surjective (D : Desc)
    (hD : D = prysmBhDesc ∨ D = bhCheckerDesc) (v : Value) (h : Value.fits D v = true) :
    ∃ g : PBh, g.toValue = v := by
  have h' : Value.fits prysmBhDesc v = true := by
    rcases hD with rfl | rfl
    · exact h
    · cases v <;> simp_all [prysmBhDesc, bhCheckerDesc, Value.fits]
  obtain ⟨vs, rfl, hf⟩ := fits_container h'
  have hl := fieldsFit_length hf
  match vs, hl with
  | [v1, v2, v3, v4, v5], _ =>
    simp only [fieldsFit_cons] at hf
    obtain ⟨h1, h2, h3, h4, h5, -⟩ := hf
    obtain ⟨a, rfl, ha⟩ := fits_uint h1
    obtain ⟨b, rfl, hb⟩ := fits_uint h2
    obtain ⟨d, rfl, hd⟩ : ∃ d, v3 = .bytes d ∧ d.size = 32 := by
      cases v3 <;> simp [Value.fits] at h3 ⊢; exact h3
    obtain ⟨e, rfl, he⟩ : ∃ d, v4 = .bytes d ∧ d.size = 32 := by
      cases v4 <;> simp [Value.fits] at h4 ⊢; exact h4
    obtain ⟨f, rfl, hf⟩ : ∃ d, v5 = .bytes d ∧ d.size = 32 := by
      cases v5 <;> simp [Value.fits] at h5 ⊢; exact h5
    simp only [Nat.reduceMul, Nat.reducePow] at ha hb
    exact ⟨⟨UInt64.ofNat a, UInt64.ofNat b, ⟨d, hd⟩, ⟨e, he⟩, ⟨f, hf⟩⟩,
      by simp [PBh.toValue, Nat.mod_eq_of_lt ha, Nat.mod_eq_of_lt hb]⟩

theorem pbh_toValue_surjective' (v : Value) (h : Value.fits prysmBhDesc v = true) : ∃ g : PBh, g.toValue = v :=
  pbh_toValue_surjective _ (.inl rfl) v h

/-- **`serialize g = slot ‖ proposer ‖ parent ‖ state ‖ body`.** -/
theorem pbh_serialize (g : PBh) : serialize prysmBhDesc g.toValue = .ok (pbhEnc g) := by
  obtain ⟨a, b, ⟨r, hr⟩, ⟨s, hs⟩, ⟨t, ht⟩⟩ := g
  have := a.toNat_lt; have := b.toNat_lt
  simp only [prysmBhDesc, PBh.toValue, serialize, serializeStruct, serializeFields, Vector.toArray_mk, hr, hs, ht]
  simp (config := {decide := true}) [*, bind, Except.bind, pure, Except.pure, assemble, headWidth, bodyWidth,
    headOf, bodiesOf, Desc.isFixed, Desc.fixedSize, Fv.uintBytes_size, bytesPerOffset, pbhEnc,
    Desc.fieldsFixedSize, Array.append_assoc]

/-- **Spec roundtrip.** -/
theorem pbh_roundtrip (g : PBh) : deserialize prysmBhDesc (pbhEnc g) = .ok g.toValue :=
  deserialize_enc (G := PBh) (toV := PBh.toValue) (enc := pbhEnc) prysmBhDesc_wellFormed pbh_serialize
    pbh_toValue_fits g

theorem pbh_accepted_is_enc {bs : Array UInt8} {v : Value} (h : deserialize prysmBhDesc bs = .ok v) :
    ∃ g : PBh, v = g.toValue ∧ bs = pbhEnc g :=
  accepted_is_enc (G := PBh) (toV := PBh.toValue) (enc := pbhEnc) prysmBhDesc_wellFormed pbh_serialize
    pbh_toValue_surjective' h

/-- **EthLib accepts exactly the 112-byte inputs.** -/
theorem pbh_spec_accepts_iff (bs : Array UInt8) : (∃ v, deserialize prysmBhDesc bs = .ok v) ↔ bs.size = 112 := by
  constructor
  · rintro ⟨v, hd⟩
    obtain ⟨g, rfl, rfl⟩ := pbh_accepted_is_enc hd
    exact pbh_enc_size g
  · intro h
    have r0 := readUint_lt bs 0 8; have r1 := readUint_lt bs 8 8
    simp only [Nat.reducePow, Nat.reduceMul] at r0 r1
    let g : PBh := ⟨UInt64.ofNat (readUint bs 0 8), UInt64.ofNat (readUint bs 8 8),
      ⟨bs.extract 16 48, by simp; omega⟩, ⟨bs.extract 48 80, by simp; omega⟩, ⟨bs.extract 80 112, by simp; omega⟩⟩
    have e : bs = pbhEnc g := by
      simp only [g, pbhEnc, UInt64.toNat_ofNat_of_lt' r0, UInt64.toNat_ofNat_of_lt' r1,
        uintBytes_readUint_slice bs 0 8 (by omega), uintBytes_readUint_slice bs 8 8 (by omega)]
      simp only [Nat.zero_add, Nat.reduceAdd]
      simp (config := {decide := true}) only [Array.extract_append_extract, Nat.min_def, Nat.max_def, ↓reduceIte]
      rw [← h]; simp
    rw [e]
    exact ⟨_, pbh_roundtrip g⟩

/-- `len(buf) ≠ 112`: EthLib rejects. -/
theorem pbh_spec_rejects (bs : Array UInt8) (h : bs.size ≠ 112) : ∃ e, deserialize prysmBhDesc bs = .error e := by
  cases hd : deserialize prysmBhDesc bs with
  | error e => exact ⟨e, rfl⟩
  | ok v => exact absurd ((pbh_spec_accepts_iff bs).mp ⟨v, hd⟩) h

/-! ### The checker Desc decodes like the hand Desc (accepted inputs and values) -/

theorem bhChecker_wellFormed : bhCheckerDesc.wellFormed = .ok () := by rfl

theorem pbh_serialize_checker (g : PBh) : serialize bhCheckerDesc g.toValue = .ok (pbhEnc g) := by
  rw [← prysmBhDesc_serialize_checker]; exact pbh_serialize g

theorem pbh_toValue_fits_checker (g : PBh) : Value.fits bhCheckerDesc g.toValue = true := by
  have := g.slot.toNat_lt; have := g.proposer.toNat_lt
  simp [bhCheckerDesc, PBh.toValue, Value.fits, Value.fieldsFit]; omega

/-- **Codec equality on the accepted inputs**: the checker Desc accepts `bs` with value `v` exactly when
the hand Desc does. -/
theorem prysmBhDesc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize prysmBhDesc bs = .ok v ↔ deserialize bhCheckerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, rfl⟩ := pbh_accepted_is_enc h
    exact deserialize_enc (G := PBh) (toV := PBh.toValue) (enc := pbhEnc) bhChecker_wellFormed
      pbh_serialize_checker pbh_toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, rfl⟩ := accepted_is_enc (G := PBh) (toV := PBh.toValue) (enc := pbhEnc) bhChecker_wellFormed
      pbh_serialize_checker (pbh_toValue_surjective _ (.inr rfl)) h
    exact pbh_roundtrip g

end E2e
