import E2e.Spec
import E2e.SpecEq
import E2eScal.HsDesc
import E2eScal.HsSpecChecker

/-!
# Spec bridge for the real Prysm `v1alpha1.HistoricalSummary` (unit G5-C)

Written by the G5-C session (the shape of `PbSpec.lean` without its uint256 field, and the codec equality of
`PcSpec.lean`). `prysmHsDesc` (`HsDesc.lean`) is the independent hand `Desc` from consensus-specs; it was
committed before `hsCheckerDesc` was rendered and printed. `hsCheckerDesc` (generated by `gen/e2e/descterm.py`) is
the Desc checker's Desc of `(v1alpha1, HistoricalSummary)` (producer output = the checker record in
`gen/desc/results/main.result.json`, same sha256; copy in `prysm/go1.26.10/e2e/g5c/`).
`PHs` is the SSZ content of a Go `v1alpha1.HistoricalSummary`: two 32-byte roots.
-/

namespace E2e
open EthLib.Serialization.Ssz Fv1

/-- The checker's Desc has the same kinds in the same order; only the names differ. -/
theorem prysmHsDesc_checker :
    prysmHsDesc = .container ["block_summary_root", "state_summary_root"] [.byteVector 32, .byteVector 32]
    ∧ hsCheckerDesc = .container ["BlockSummaryRoot", "StateSummaryRoot"] [.byteVector 32, .byteVector 32] :=
  ⟨rfl, rfl⟩

theorem prysmHsDesc_wellFormed : prysmHsDesc.wellFormed = .ok () := by rfl
theorem prysmHsDesc_fixedSize : prysmHsDesc.fixedSize = some 64 := by rfl
theorem hsChecker_wellFormed : hsCheckerDesc.wellFormed = .ok () := by rfl

/-- EthLib's `serialize` ignores container names. -/
theorem prysmHsDesc_serialize_checker (v : Value) : serialize prysmHsDesc v = serialize hsCheckerDesc v := by
  unfold prysmHsDesc hsCheckerDesc
  cases v <;> (try simp only [serialize, serializeStruct]) <;> rfl

/-- The SSZ content of a Go `v1alpha1.HistoricalSummary` (two 32-byte roots). -/
structure PHs where
  blockSummaryRoot : Vector UInt8 32
  stateSummaryRoot : Vector UInt8 32

def PHs.toValue (g : PHs) : Value :=
  .seq [.bytes g.blockSummaryRoot.toArray, .bytes g.stateSummaryRoot.toArray]

/-- `blockSummaryRoot ++ stateSummaryRoot`. -/
def phsEnc (g : PHs) : Array UInt8 :=
  g.blockSummaryRoot.toArray ++ g.stateSummaryRoot.toArray

theorem phs_enc_size (g : PHs) : (phsEnc g).size = 64 := by
  simp [phsEnc]

theorem phs_toValue_fits (g : PHs) : Value.fits prysmHsDesc g.toValue = true := by
  simp [prysmHsDesc, PHs.toValue, Value.fits, Value.fieldsFit]

theorem phs_toValue_fits_checker (g : PHs) : Value.fits hsCheckerDesc g.toValue = true := by
  simp [hsCheckerDesc, PHs.toValue, Value.fits, Value.fieldsFit]

theorem phs_toValue_injective (g h : PHs) (e : g.toValue = h.toValue) : g = h := by
  obtain ⟨p, r⟩ := g; obtain ⟨p', r'⟩ := h
  simp only [PHs.toValue, Value.seq.injEq, List.cons.injEq, Value.bytes.injEq, and_true] at e
  obtain ⟨e0, e1⟩ := e
  rw [Vector.toArray_inj.mp e0, Vector.toArray_inj.mp e1]

theorem phs_toValue_surjective (D : Desc)
    (hD : D = prysmHsDesc ∨ D = hsCheckerDesc) (v : Value) (h : Value.fits D v = true) :
    ∃ g : PHs, g.toValue = v := by
  have h' : Value.fits prysmHsDesc v = true := by
    rcases hD with rfl | rfl
    · exact h
    · cases v <;> simp_all [prysmHsDesc, hsCheckerDesc, Value.fits]
  obtain ⟨vs, rfl, hf⟩ := fits_container h'
  have hl := fieldsFit_length hf
  match vs, hl with
  | [v0, v1], _ =>
    simp only [fieldsFit_cons] at hf
    obtain ⟨h0, h1, -⟩ := hf
    obtain ⟨q, rfl, hq⟩ : ∃ d, v0 = .bytes d ∧ d.size = 32 := by
      cases v0 <;> simp [Value.fits] at h0 ⊢; exact h0
    obtain ⟨d, rfl, hd⟩ : ∃ d, v1 = .bytes d ∧ d.size = 32 := by
      cases v1 <;> simp [Value.fits] at h1 ⊢; exact h1
    exact ⟨⟨⟨q, hq⟩, ⟨d, hd⟩⟩, by simp [PHs.toValue]⟩

theorem phs_toValue_surjective' (v : Value) (h : Value.fits prysmHsDesc v = true) : ∃ g : PHs, g.toValue = v :=
  phs_toValue_surjective _ (.inl rfl) v h

/-- **`serialize g = blockSummaryRoot ‖ stateSummaryRoot`.** -/
theorem phs_serialize (g : PHs) : serialize prysmHsDesc g.toValue = .ok (phsEnc g) := by
  obtain ⟨⟨q, hq⟩, ⟨r, hr⟩⟩ := g
  simp only [prysmHsDesc, PHs.toValue, serialize, serializeStruct, serializeFields, Vector.toArray_mk, hq, hr]
  simp (config := {decide := true}) [*, bind, Except.bind, pure, Except.pure, assemble, headWidth, bodyWidth,
    headOf, bodiesOf, Desc.isFixed, Desc.fixedSize, bytesPerOffset, phsEnc,
    Desc.fieldsFixedSize, Array.append_assoc]

/-- **Spec roundtrip.** -/
theorem phs_roundtrip (g : PHs) : deserialize prysmHsDesc (phsEnc g) = .ok g.toValue :=
  deserialize_enc (G := PHs) (toV := PHs.toValue) (enc := phsEnc) prysmHsDesc_wellFormed phs_serialize
    phs_toValue_fits g

theorem phs_accepted_is_enc {bs : Array UInt8} {v : Value} (h : deserialize prysmHsDesc bs = .ok v) :
    ∃ g : PHs, v = g.toValue ∧ bs = phsEnc g :=
  accepted_is_enc (G := PHs) (toV := PHs.toValue) (enc := phsEnc) prysmHsDesc_wellFormed phs_serialize
    phs_toValue_surjective' h

/-- **EthLib accepts exactly the 64-byte inputs.** -/
theorem phs_spec_accepts_iff (bs : Array UInt8) : (∃ v, deserialize prysmHsDesc bs = .ok v) ↔ bs.size = 64 := by
  constructor
  · rintro ⟨v, hd⟩
    obtain ⟨g, rfl, hb⟩ := phs_accepted_is_enc hd
    rw [hb]; exact phs_enc_size g
  · intro h
    let g : PHs := ⟨⟨bs.extract 0 32, by simp; omega⟩, ⟨bs.extract 32 64, by simp; omega⟩⟩
    have e : bs = phsEnc g := by
      simp only [g, phsEnc]
      simp (config := {decide := true}) only [Array.extract_append_extract, Nat.min_def, Nat.max_def, ↓reduceIte]
      rw [← h]; simp
    rw [e]
    exact ⟨_, phs_roundtrip g⟩

/-- `len(buf) ≠ 64`: EthLib rejects. -/
theorem phs_spec_rejects (bs : Array UInt8) (h : bs.size ≠ 64) : ∃ e, deserialize prysmHsDesc bs = .error e := by
  cases hd : deserialize prysmHsDesc bs with
  | error e => exact ⟨e, rfl⟩
  | ok v => exact absurd ((phs_spec_accepts_iff bs).mp ⟨v, hd⟩) h

/-! ### The checker Desc decodes like the hand Desc (accepted inputs and values) -/

theorem phs_serialize_checker (g : PHs) : serialize hsCheckerDesc g.toValue = .ok (phsEnc g) := by
  rw [← prysmHsDesc_serialize_checker]; exact phs_serialize g

/-- **Codec equality on the accepted inputs**. -/
theorem prysmHsDesc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize prysmHsDesc bs = .ok v ↔ deserialize hsCheckerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := phs_accepted_is_enc h
    rw [hb]
    exact deserialize_enc (G := PHs) (toV := PHs.toValue) (enc := phsEnc) hsChecker_wellFormed
      phs_serialize_checker phs_toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := PHs) (toV := PHs.toValue) (enc := phsEnc) hsChecker_wellFormed
      phs_serialize_checker (phs_toValue_surjective _ (.inr rfl)) h
    rw [hb]; exact phs_roundtrip g

end E2e
