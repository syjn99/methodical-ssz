import E2e.Spec
import E2e.SpecEq
import E2eScal.SaDesc
import E2eScal.SaSpecChecker

/-!
# Spec bridge for the real Prysm `v1alpha1.SyncAggregatorSelectionData`

The text of `PcSpec.lean` with names changed (two uint64 fields).
`prysmSaDesc` (`SaDesc.lean`) is the independent hand `Desc` (consensus-specs); it was committed before
`saCheckerDesc` was rendered and printed. `saCheckerDesc` (generated by `gen/e2e/descterm.py`) is the Desc checker's
Desc of `(v1alpha1, SyncAggregatorSelectionData)` (producer output = the checker record in `gen/desc/results/main.result.json`, same
sha256; copy in `prysm/go1.26.10/e2e/g5c/`).
`PSa` is the SSZ content of a Go `v1alpha1.SyncAggregatorSelectionData` (two uint64 values).
-/

namespace E2e
open EthLib.Serialization.Ssz
open Spec hiding readUint_lt

/-- The checker's Desc has the same kinds in the same order; only the names differ. -/
theorem prysmSaDesc_checker :
    prysmSaDesc = .container ["slot", "subcommittee_index"]
      [.uint 8, .uint 8]
    ∧ saCheckerDesc = .container ["Slot", "SubcommitteeIndex"]
      [.uint 8, .uint 8] :=
  ⟨rfl, rfl⟩

theorem prysmSaDesc_wellFormed : prysmSaDesc.wellFormed = .ok () := by rfl
theorem prysmSaDesc_fixedSize : prysmSaDesc.fixedSize = some 16 := by rfl

/-- EthLib's `serialize` ignores container names. -/
theorem prysmSaDesc_serialize_checker (v : Value) : serialize prysmSaDesc v = serialize saCheckerDesc v := by
  unfold prysmSaDesc saCheckerDesc
  cases v <;> (try simp only [serialize, serializeStruct]) <;> rfl

/-- The SSZ content of a Go `v1alpha1.SyncAggregatorSelectionData` (two uint64 values). -/
structure PSa where
  slot : UInt64
  subcommitteeIndex : UInt64

def PSa.toValue (g : PSa) : Value :=
  .seq [.uint g.slot.toNat, .uint g.subcommitteeIndex.toNat]

/-- `uintBytes 8 slot ++ uintBytes 8 subcommitteeIndex`. -/
def psaEnc (g : PSa) : Array UInt8 :=
  uintBytes 8 g.slot.toNat ++ uintBytes 8 g.subcommitteeIndex.toNat

theorem psa_enc_size (g : PSa) : (psaEnc g).size = 16 := by
  simp [psaEnc, Spec.uintBytes_size]

theorem psa_toValue_fits (g : PSa) : Value.fits prysmSaDesc g.toValue = true := by
  have := g.slot.toNat_lt; have := g.subcommitteeIndex.toNat_lt
  simp only [prysmSaDesc, PSa.toValue, Value.fits, Value.fieldsFit] at *
  simp; omega

theorem psa_toValue_injective (g h : PSa) (e : g.toValue = h.toValue) : g = h := by
  obtain ⟨p, r⟩ := g; obtain ⟨p', r'⟩ := h
  simp only [PSa.toValue, Value.seq.injEq, List.cons.injEq, Value.uint.injEq, Value.bytes.injEq,
    and_true] at e
  obtain ⟨e0, e1⟩ := e
  rw [UInt64.toNat_inj.mp e0, UInt64.toNat_inj.mp e1]

theorem psa_toValue_surjective (D : Desc)
    (hD : D = prysmSaDesc ∨ D = saCheckerDesc) (v : Value) (h : Value.fits D v = true) :
    ∃ g : PSa, g.toValue = v := by
  have h' : Value.fits prysmSaDesc v = true := by
    rcases hD with rfl | rfl
    · exact h
    · cases v <;> simp_all [prysmSaDesc, saCheckerDesc, Value.fits]
  obtain ⟨vs, rfl, hf⟩ := fits_container h'
  have hl := fieldsFit_length hf
  match vs, hl with
  | [v0, v1], _ =>
    simp only [fieldsFit_cons] at hf
    obtain ⟨h0, h1, -⟩ := hf
    obtain ⟨a0, rfl, ha0⟩ := fits_uint h0
    obtain ⟨a1, rfl, ha1⟩ := fits_uint h1
    simp only [Nat.reduceMul, Nat.reducePow] at ha0 ha1
    exact ⟨⟨UInt64.ofNat a0, UInt64.ofNat a1⟩,
      by simp [PSa.toValue, Nat.mod_eq_of_lt ha0, Nat.mod_eq_of_lt ha1]⟩

theorem psa_toValue_surjective' (v : Value) (h : Value.fits prysmSaDesc v = true) : ∃ g : PSa, g.toValue = v :=
  psa_toValue_surjective _ (.inl rfl) v h

/-- **`serialize g = slot ‖ subcommitteeIndex`.** -/
theorem psa_serialize (g : PSa) : serialize prysmSaDesc g.toValue = .ok (psaEnc g) := by
  obtain ⟨a0, a1⟩ := g
  have := a0.toNat_lt; have := a1.toNat_lt
  simp only [prysmSaDesc, PSa.toValue, serialize, serializeStruct, serializeFields, Vector.toArray_mk]
  simp (config := {decide := true}) [*, bind, Except.bind, pure, Except.pure, assemble, headWidth, bodyWidth,
    headOf, bodiesOf, Desc.isFixed, Desc.fixedSize, Spec.uintBytes_size, bytesPerOffset, psaEnc,
    Desc.fieldsFixedSize, Array.append_assoc]

/-- **Spec roundtrip.** -/
theorem psa_roundtrip (g : PSa) : deserialize prysmSaDesc (psaEnc g) = .ok g.toValue :=
  deserialize_enc (G := PSa) (toV := PSa.toValue) (enc := psaEnc) prysmSaDesc_wellFormed psa_serialize
    psa_toValue_fits g

theorem psa_accepted_is_enc {bs : Array UInt8} {v : Value} (h : deserialize prysmSaDesc bs = .ok v) :
    ∃ g : PSa, v = g.toValue ∧ bs = psaEnc g :=
  accepted_is_enc (G := PSa) (toV := PSa.toValue) (enc := psaEnc) prysmSaDesc_wellFormed psa_serialize
    psa_toValue_surjective' h

/-- **EthLib accepts exactly the 16-byte inputs.** -/
theorem psa_spec_accepts_iff (bs : Array UInt8) : (∃ v, deserialize prysmSaDesc bs = .ok v) ↔ bs.size = 16 := by
  constructor
  · rintro ⟨v, hd⟩
    obtain ⟨g, rfl, hb⟩ := psa_accepted_is_enc hd
    rw [hb]; exact psa_enc_size g
  · intro h
    have r0 := readUint_lt bs 0 8
    have r1 := readUint_lt bs 8 8
    simp only [Nat.reducePow, Nat.reduceMul] at r0 r1
    let g : PSa := ⟨UInt64.ofNat (readUint bs 0 8), UInt64.ofNat (readUint bs 8 8)⟩
    have e : bs = psaEnc g := by
      simp only [g, psaEnc, UInt64.toNat_ofNat_of_lt' r0, UInt64.toNat_ofNat_of_lt' r1,
        uintBytes_readUint_slice bs 0 8 (by omega), uintBytes_readUint_slice bs 8 8 (by omega)]
      simp only [Nat.zero_add, Nat.reduceAdd]
      simp (config := {decide := true}) only [Array.extract_append_extract, Nat.min_def, Nat.max_def, ↓reduceIte]
      rw [← h]; simp
    rw [e]
    exact ⟨_, psa_roundtrip g⟩

/-- `len(buf) ≠ 16`: EthLib rejects. -/
theorem psa_spec_rejects (bs : Array UInt8) (h : bs.size ≠ 16) : ∃ e, deserialize prysmSaDesc bs = .error e := by
  cases hd : deserialize prysmSaDesc bs with
  | error e => exact ⟨e, rfl⟩
  | ok v => exact absurd ((psa_spec_accepts_iff bs).mp ⟨v, hd⟩) h

/-! ### The checker Desc decodes like the hand Desc (accepted inputs and values) -/

theorem saChecker_wellFormed : saCheckerDesc.wellFormed = .ok () := by rfl

theorem psa_serialize_checker (g : PSa) : serialize saCheckerDesc g.toValue = .ok (psaEnc g) := by
  rw [← prysmSaDesc_serialize_checker]; exact psa_serialize g

theorem psa_toValue_fits_checker (g : PSa) : Value.fits saCheckerDesc g.toValue = true := by
  have := g.slot.toNat_lt; have := g.subcommitteeIndex.toNat_lt
  simp [saCheckerDesc, PSa.toValue, Value.fits, Value.fieldsFit]; omega

/-- **Codec equality on the accepted inputs**. -/
theorem prysmSaDesc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize prysmSaDesc bs = .ok v ↔ deserialize saCheckerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := psa_accepted_is_enc h
    rw [hb]
    exact deserialize_enc (G := PSa) (toV := PSa.toValue) (enc := psaEnc) saChecker_wellFormed
      psa_serialize_checker psa_toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := PSa) (toV := PSa.toValue) (enc := psaEnc) saChecker_wellFormed
      psa_serialize_checker (psa_toValue_surjective _ (.inr rfl)) h
    rw [hb]; exact psa_roundtrip g

end E2e
