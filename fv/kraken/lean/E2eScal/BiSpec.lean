import E2e.Spec
import E2e.SpecEq
import E2eScal.BiDesc
import E2eScal.BiSpecChecker

/-!
# Spec bridge for the real Prysm `v1alpha1.BlobIdentifier` (H3 hold-out)

Hand-written by the H3 evaluation session (the text of `E1Spec.lean`; `obtain … rfl` on `bs = enc g` is `rw` here:
`subst` of that equation timed out in `whnf` (job 18, minimal reproduction); with the BlobIdentifier fields).
`prysmBiDesc` (`BiDesc.lean`) is the independent hand `Desc` from consensus-specs deneb; it was committed
before `biCheckerDesc` was rendered and printed.
`biCheckerDesc` (generated by `gen/e2e/descterm.py`) is the Desc checker's Desc of `(v1alpha1, BlobIdentifier)`
(producer output sha256 `944b13a1…` = the checker record in `gen/desc/results/main.result.json`).
`PBi` is the SSZ content of a Go `v1alpha1.BlobIdentifier` whose root has length 32.
-/

namespace E2e
open EthLib.Serialization.Ssz Fv1

/-- The checker's Desc has the same kinds in the same order; only the names differ. -/
theorem prysmBiDesc_checker :
    prysmBiDesc = .container ["block_root", "index"] [.byteVector 32, .uint 8]
    ∧ biCheckerDesc = .container ["BlockRoot", "Index"] [.byteVector 32, .uint 8] :=
  ⟨rfl, rfl⟩

theorem prysmBiDesc_wellFormed : prysmBiDesc.wellFormed = .ok () := by rfl
theorem prysmBiDesc_fixedSize : prysmBiDesc.fixedSize = some 40 := by rfl

/-- EthLib's `serialize` ignores container names. -/
theorem prysmBiDesc_serialize_checker (v : Value) : serialize prysmBiDesc v = serialize biCheckerDesc v := by
  unfold prysmBiDesc biCheckerDesc
  cases v <;> (try simp only [serialize, serializeStruct]) <;> rfl

/-- The SSZ content of a Go `v1alpha1.BlobIdentifier` (root of length 32). -/
structure PBi where
  blockRoot : Vector UInt8 32
  index : UInt64

def PBi.toValue (g : PBi) : Value :=
  .seq [.bytes g.blockRoot.toArray, .uint g.index.toNat]

/-- `blockRoot ++ uintBytes 8 index`. -/
def pbiEnc (g : PBi) : Array UInt8 :=
  g.blockRoot.toArray ++ uintBytes 8 g.index.toNat

theorem pbi_enc_size (g : PBi) : (pbiEnc g).size = 40 := by
  simp [pbiEnc, Fv.uintBytes_size]

theorem pbi_toValue_fits (g : PBi) : Value.fits prysmBiDesc g.toValue = true := by
  have := g.index.toNat_lt
  simp only [prysmBiDesc, PBi.toValue, Value.fits, Value.fieldsFit] at *
  simp; omega

theorem pbi_toValue_injective (g h : PBi) (e : g.toValue = h.toValue) : g = h := by
  obtain ⟨r, a⟩ := g; obtain ⟨r', a'⟩ := h
  simp only [PBi.toValue, Value.seq.injEq, List.cons.injEq, Value.uint.injEq, Value.bytes.injEq,
    and_true] at e
  obtain ⟨e1, e2⟩ := e
  rw [Vector.toArray_inj.mp e1, UInt64.toNat_inj.mp e2]

theorem pbi_toValue_surjective (D : Desc)
    (hD : D = prysmBiDesc ∨ D = biCheckerDesc) (v : Value) (h : Value.fits D v = true) :
    ∃ g : PBi, g.toValue = v := by
  have h' : Value.fits prysmBiDesc v = true := by
    rcases hD with rfl | rfl
    · exact h
    · cases v <;> simp_all [prysmBiDesc, biCheckerDesc, Value.fits]
  obtain ⟨vs, rfl, hf⟩ := fits_container h'
  have hl := fieldsFit_length hf
  match vs, hl with
  | [v1, v2], _ =>
    simp only [fieldsFit_cons] at hf
    obtain ⟨h1, h2, -⟩ := hf
    obtain ⟨d, rfl, hd⟩ : ∃ d, v1 = .bytes d ∧ d.size = 32 := by
      cases v1 <;> simp [Value.fits] at h1 ⊢; exact h1
    obtain ⟨a, rfl, ha⟩ := fits_uint h2
    simp only [Nat.reduceMul, Nat.reducePow] at ha
    exact ⟨⟨⟨d, hd⟩, UInt64.ofNat a⟩, by simp [PBi.toValue, Nat.mod_eq_of_lt ha]⟩

theorem pbi_toValue_surjective' (v : Value) (h : Value.fits prysmBiDesc v = true) : ∃ g : PBi, g.toValue = v :=
  pbi_toValue_surjective _ (.inl rfl) v h

/-- **`serialize g = blockRoot ‖ index`.** -/
theorem pbi_serialize (g : PBi) : serialize prysmBiDesc g.toValue = .ok (pbiEnc g) := by
  obtain ⟨⟨r, hr⟩, a⟩ := g
  have := a.toNat_lt
  simp only [prysmBiDesc, PBi.toValue, serialize, serializeStruct, serializeFields, Vector.toArray_mk, hr]
  simp (config := {decide := true}) [*, bind, Except.bind, pure, Except.pure, assemble, headWidth, bodyWidth,
    headOf, bodiesOf, Desc.isFixed, Desc.fixedSize, Fv.uintBytes_size, bytesPerOffset, pbiEnc,
    Desc.fieldsFixedSize, Array.append_assoc]

/-- **Spec roundtrip.** -/
theorem pbi_roundtrip (g : PBi) : deserialize prysmBiDesc (pbiEnc g) = .ok g.toValue :=
  deserialize_enc (G := PBi) (toV := PBi.toValue) (enc := pbiEnc) prysmBiDesc_wellFormed pbi_serialize
    pbi_toValue_fits g

theorem pbi_accepted_is_enc {bs : Array UInt8} {v : Value} (h : deserialize prysmBiDesc bs = .ok v) :
    ∃ g : PBi, v = g.toValue ∧ bs = pbiEnc g :=
  accepted_is_enc (G := PBi) (toV := PBi.toValue) (enc := pbiEnc) prysmBiDesc_wellFormed pbi_serialize
    pbi_toValue_surjective' h

/-- **EthLib accepts exactly the 40-byte inputs.** -/
theorem pbi_spec_accepts_iff (bs : Array UInt8) : (∃ v, deserialize prysmBiDesc bs = .ok v) ↔ bs.size = 40 := by
  constructor
  · rintro ⟨v, hd⟩
    obtain ⟨g, rfl, hb⟩ := pbi_accepted_is_enc hd
    rw [hb]; exact pbi_enc_size g
  · intro h
    have r0 := readUint_lt bs 32 8
    simp only [Nat.reducePow, Nat.reduceMul] at r0
    let g : PBi := ⟨⟨bs.extract 0 32, by simp; omega⟩, UInt64.ofNat (readUint bs 32 8)⟩
    have e : bs = pbiEnc g := by
      simp only [g, pbiEnc, UInt64.toNat_ofNat_of_lt' r0, uintBytes_readUint_slice bs 32 8 (by omega)]
      simp only [Nat.zero_add, Nat.reduceAdd]
      simp (config := {decide := true}) only [Array.extract_append_extract, Nat.min_def, Nat.max_def, ↓reduceIte]
      rw [← h]; simp
    rw [e]
    exact ⟨_, pbi_roundtrip g⟩

/-- `len(buf) ≠ 40`: EthLib rejects. -/
theorem pbi_spec_rejects (bs : Array UInt8) (h : bs.size ≠ 40) : ∃ e, deserialize prysmBiDesc bs = .error e := by
  cases hd : deserialize prysmBiDesc bs with
  | error e => exact ⟨e, rfl⟩
  | ok v => exact absurd ((pbi_spec_accepts_iff bs).mp ⟨v, hd⟩) h

/-! ### The checker Desc decodes like the hand Desc (accepted inputs and values) -/

theorem biChecker_wellFormed : biCheckerDesc.wellFormed = .ok () := by rfl

theorem pbi_serialize_checker (g : PBi) : serialize biCheckerDesc g.toValue = .ok (pbiEnc g) := by
  rw [← prysmBiDesc_serialize_checker]; exact pbi_serialize g

theorem pbi_toValue_fits_checker (g : PBi) : Value.fits biCheckerDesc g.toValue = true := by
  have := g.index.toNat_lt
  simp [biCheckerDesc, PBi.toValue, Value.fits, Value.fieldsFit]; omega

/-- **Codec equality on the accepted inputs**. -/
theorem prysmBiDesc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize prysmBiDesc bs = .ok v ↔ deserialize biCheckerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := pbi_accepted_is_enc h
    rw [hb]
    exact deserialize_enc (G := PBi) (toV := PBi.toValue) (enc := pbiEnc) biChecker_wellFormed
      pbi_serialize_checker pbi_toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := PBi) (toV := PBi.toValue) (enc := pbiEnc) biChecker_wellFormed
      pbi_serialize_checker (pbi_toValue_surjective _ (.inr rfl)) h
    rw [hb]; exact pbi_roundtrip g

end E2e
