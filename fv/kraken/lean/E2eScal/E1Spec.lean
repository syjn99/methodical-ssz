import E2e.Spec
import E2e.SpecEq
import E2eScal.E1Desc
import E2eScal.E1SpecChecker

/-!
# Spec bridge for the real Prysm `v1alpha1.Eth1Data` (hold-out)

Hand-written (the text of `BhSpec.lean` with the Eth1Data fields).
`prysmE1Desc` (`E1Desc.lean`) is the independent hand `Desc` from consensus-specs phase0; it was committed
(c43359b) before `e1CheckerDesc` was rendered and printed.
`e1CheckerDesc` (generated by `gen/e2e/descterm.py`) is the Desc checker's Desc of `(v1alpha1, Eth1Data)`
(producer output sha256 `6064a3dc…` = the checker record in `gen/desc/results/main.result.json`).
`prysmE1Desc_checker`: same kinds in the same order (only the names differ);
`prysmE1Desc_serialize_checker`: equal `serialize` on every value; `prysmE1Desc_deserialize_checker`:
the same accepted inputs with the same values (EthLib error values are not compared).
`PE1` is the SSZ content of a Go `v1alpha1.Eth1Data` whose two roots have length 32.
-/

namespace E2e
open EthLib.Serialization.Ssz Fv1

/-- The checker's Desc has the same kinds in the same order; only the names differ. -/
theorem prysmE1Desc_checker :
    prysmE1Desc = .container ["deposit_root", "deposit_count", "block_hash"]
      [.byteVector 32, .uint 8, .byteVector 32]
    ∧ e1CheckerDesc = .container ["DepositRoot", "DepositCount", "BlockHash"]
      [.byteVector 32, .uint 8, .byteVector 32] :=
  ⟨rfl, rfl⟩

theorem prysmE1Desc_wellFormed : prysmE1Desc.wellFormed = .ok () := by rfl
theorem prysmE1Desc_fixedSize : prysmE1Desc.fixedSize = some 72 := by rfl

/-- EthLib's `serialize` ignores container names: the hand Desc and the checker Desc encode every value
the same way. -/
theorem prysmE1Desc_serialize_checker (v : Value) : serialize prysmE1Desc v = serialize e1CheckerDesc v := by
  unfold prysmE1Desc e1CheckerDesc
  cases v <;> (try simp only [serialize, serializeStruct]) <;> rfl

/-- The SSZ content of a Go `v1alpha1.Eth1Data` (both roots of length 32). -/
structure PE1 where
  depositRoot : Vector UInt8 32
  depositCount : UInt64
  blockHash : Vector UInt8 32

def PE1.toValue (g : PE1) : Value :=
  .seq [.bytes g.depositRoot.toArray, .uint g.depositCount.toNat, .bytes g.blockHash.toArray]

/-- `depositRoot ++ uintBytes 8 depositCount ++ blockHash`. -/
def pe1Enc (g : PE1) : Array UInt8 :=
  g.depositRoot.toArray ++ uintBytes 8 g.depositCount.toNat ++ g.blockHash.toArray

theorem pe1_enc_size (g : PE1) : (pe1Enc g).size = 72 := by
  simp [pe1Enc, Fv.uintBytes_size]

theorem pe1_toValue_fits (g : PE1) : Value.fits prysmE1Desc g.toValue = true := by
  have := g.depositCount.toNat_lt
  simp only [prysmE1Desc, PE1.toValue, Value.fits, Value.fieldsFit] at *
  simp; omega

theorem pe1_toValue_injective (g h : PE1) (e : g.toValue = h.toValue) : g = h := by
  obtain ⟨r, a, t⟩ := g; obtain ⟨r', a', t'⟩ := h
  simp only [PE1.toValue, Value.seq.injEq, List.cons.injEq, Value.uint.injEq, Value.bytes.injEq,
    and_true] at e
  obtain ⟨e1, e2, e3⟩ := e
  rw [Vector.toArray_inj.mp e1, UInt64.toNat_inj.mp e2, Vector.toArray_inj.mp e3]

theorem pe1_toValue_surjective (D : Desc)
    (hD : D = prysmE1Desc ∨ D = e1CheckerDesc) (v : Value) (h : Value.fits D v = true) :
    ∃ g : PE1, g.toValue = v := by
  have h' : Value.fits prysmE1Desc v = true := by
    rcases hD with rfl | rfl
    · exact h
    · cases v <;> simp_all [prysmE1Desc, e1CheckerDesc, Value.fits]
  obtain ⟨vs, rfl, hf⟩ := fits_container h'
  have hl := fieldsFit_length hf
  match vs, hl with
  | [v1, v2, v3], _ =>
    simp only [fieldsFit_cons] at hf
    obtain ⟨h1, h2, h3, -⟩ := hf
    obtain ⟨d, rfl, hd⟩ : ∃ d, v1 = .bytes d ∧ d.size = 32 := by
      cases v1 <;> simp [Value.fits] at h1 ⊢; exact h1
    obtain ⟨a, rfl, ha⟩ := fits_uint h2
    obtain ⟨f, rfl, hf⟩ : ∃ d, v3 = .bytes d ∧ d.size = 32 := by
      cases v3 <;> simp [Value.fits] at h3 ⊢; exact h3
    simp only [Nat.reduceMul, Nat.reducePow] at ha
    exact ⟨⟨⟨d, hd⟩, UInt64.ofNat a, ⟨f, hf⟩⟩, by simp [PE1.toValue, Nat.mod_eq_of_lt ha]⟩

theorem pe1_toValue_surjective' (v : Value) (h : Value.fits prysmE1Desc v = true) : ∃ g : PE1, g.toValue = v :=
  pe1_toValue_surjective _ (.inl rfl) v h

/-- **`serialize g = depositRoot ‖ depositCount ‖ blockHash`.** -/
theorem pe1_serialize (g : PE1) : serialize prysmE1Desc g.toValue = .ok (pe1Enc g) := by
  obtain ⟨⟨r, hr⟩, a, ⟨t, ht⟩⟩ := g
  have := a.toNat_lt
  simp only [prysmE1Desc, PE1.toValue, serialize, serializeStruct, serializeFields, Vector.toArray_mk, hr, ht]
  simp (config := {decide := true}) [*, bind, Except.bind, pure, Except.pure, assemble, headWidth, bodyWidth,
    headOf, bodiesOf, Desc.isFixed, Desc.fixedSize, Fv.uintBytes_size, bytesPerOffset, pe1Enc,
    Desc.fieldsFixedSize, Array.append_assoc]

/-- **Spec roundtrip.** -/
theorem pe1_roundtrip (g : PE1) : deserialize prysmE1Desc (pe1Enc g) = .ok g.toValue :=
  deserialize_enc (G := PE1) (toV := PE1.toValue) (enc := pe1Enc) prysmE1Desc_wellFormed pe1_serialize
    pe1_toValue_fits g

theorem pe1_accepted_is_enc {bs : Array UInt8} {v : Value} (h : deserialize prysmE1Desc bs = .ok v) :
    ∃ g : PE1, v = g.toValue ∧ bs = pe1Enc g :=
  accepted_is_enc (G := PE1) (toV := PE1.toValue) (enc := pe1Enc) prysmE1Desc_wellFormed pe1_serialize
    pe1_toValue_surjective' h

/-- **EthLib accepts exactly the 72-byte inputs.** -/
theorem pe1_spec_accepts_iff (bs : Array UInt8) : (∃ v, deserialize prysmE1Desc bs = .ok v) ↔ bs.size = 72 := by
  constructor
  · rintro ⟨v, hd⟩
    obtain ⟨g, rfl, rfl⟩ := pe1_accepted_is_enc hd
    exact pe1_enc_size g
  · intro h
    have r0 := readUint_lt bs 32 8
    simp only [Nat.reducePow, Nat.reduceMul] at r0
    let g : PE1 := ⟨⟨bs.extract 0 32, by simp; omega⟩, UInt64.ofNat (readUint bs 32 8),
      ⟨bs.extract 40 72, by simp; omega⟩⟩
    have e : bs = pe1Enc g := by
      simp only [g, pe1Enc, UInt64.toNat_ofNat_of_lt' r0, uintBytes_readUint_slice bs 32 8 (by omega)]
      simp only [Nat.zero_add, Nat.reduceAdd]
      simp (config := {decide := true}) only [Array.extract_append_extract, Nat.min_def, Nat.max_def, ↓reduceIte]
      rw [← h]; simp
    rw [e]
    exact ⟨_, pe1_roundtrip g⟩

/-- `len(buf) ≠ 72`: EthLib rejects. -/
theorem pe1_spec_rejects (bs : Array UInt8) (h : bs.size ≠ 72) : ∃ e, deserialize prysmE1Desc bs = .error e := by
  cases hd : deserialize prysmE1Desc bs with
  | error e => exact ⟨e, rfl⟩
  | ok v => exact absurd ((pe1_spec_accepts_iff bs).mp ⟨v, hd⟩) h

/-! ### The checker Desc decodes like the hand Desc (accepted inputs and values) -/

theorem e1Checker_wellFormed : e1CheckerDesc.wellFormed = .ok () := by rfl

theorem pe1_serialize_checker (g : PE1) : serialize e1CheckerDesc g.toValue = .ok (pe1Enc g) := by
  rw [← prysmE1Desc_serialize_checker]; exact pe1_serialize g

theorem pe1_toValue_fits_checker (g : PE1) : Value.fits e1CheckerDesc g.toValue = true := by
  have := g.depositCount.toNat_lt
  simp [e1CheckerDesc, PE1.toValue, Value.fits, Value.fieldsFit]; omega

/-- **Codec equality on the accepted inputs**: the checker Desc accepts `bs` with value `v` exactly when
the hand Desc does. -/
theorem prysmE1Desc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize prysmE1Desc bs = .ok v ↔ deserialize e1CheckerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, rfl⟩ := pe1_accepted_is_enc h
    exact deserialize_enc (G := PE1) (toV := PE1.toValue) (enc := pe1Enc) e1Checker_wellFormed
      pe1_serialize_checker pe1_toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, rfl⟩ := accepted_is_enc (G := PE1) (toV := PE1.toValue) (enc := pe1Enc) e1Checker_wellFormed
      pe1_serialize_checker (pe1_toValue_surjective _ (.inr rfl)) h
    exact pe1_roundtrip g

end E2e
