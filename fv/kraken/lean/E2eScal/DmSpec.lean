import E2e.Spec
import E2e.SpecEq
import E2eScal.DmDesc
import E2eScal.DmSpecChecker

/-!
# Spec bridge for the real Prysm `v1alpha1.DepositMessage` (hold-out)

Hand-written (the text of `E1Spec.lean`; `obtain … rfl` on `bs = enc g` is `rw` here:
`subst` of that equation timed out in `whnf` (job 18, minimal reproduction); with the DepositMessage fields).
`prysmDmDesc` (`DmDesc.lean`) is the independent hand `Desc` from consensus-specs phase0; it was committed
before `dmCheckerDesc` was rendered and printed.
`dmCheckerDesc` (generated by `gen/e2e/descterm.py`) is the Desc checker's Desc of `(v1alpha1, DepositMessage)`
(producer output sha256 `e0af8dbf…` = the checker record in `gen/desc/results/main.result.json`).
`PDm` is the SSZ content of a Go `v1alpha1.DepositMessage` whose PublicKey has length 48 and WithdrawalCredentials length 32.
-/

namespace E2e
open EthLib.Serialization.Ssz
open Spec hiding readUint_lt

/-- The checker's Desc has the same kinds in the same order; only the names differ. -/
theorem prysmDmDesc_checker :
    prysmDmDesc = .container ["pubkey", "withdrawal_credentials", "amount"]
      [.byteVector 48, .byteVector 32, .uint 8]
    ∧ dmCheckerDesc = .container ["PublicKey", "WithdrawalCredentials", "Amount"]
      [.byteVector 48, .byteVector 32, .uint 8] :=
  ⟨rfl, rfl⟩

theorem prysmDmDesc_wellFormed : prysmDmDesc.wellFormed = .ok () := by rfl
theorem prysmDmDesc_fixedSize : prysmDmDesc.fixedSize = some 88 := by rfl

/-- EthLib's `serialize` ignores container names. -/
theorem prysmDmDesc_serialize_checker (v : Value) : serialize prysmDmDesc v = serialize dmCheckerDesc v := by
  unfold prysmDmDesc dmCheckerDesc
  cases v <;> (try simp only [serialize, serializeStruct]) <;> rfl

/-- The SSZ content of a Go `v1alpha1.DepositMessage` (PublicKey of length 48, WithdrawalCredentials of length 32). -/
structure PDm where
  pubkey : Vector UInt8 48
  withdrawalCredentials : Vector UInt8 32
  amount : UInt64

def PDm.toValue (g : PDm) : Value :=
  .seq [.bytes g.pubkey.toArray, .bytes g.withdrawalCredentials.toArray, .uint g.amount.toNat]

/-- `pubkey ++ withdrawalCredentials ++ uintBytes 8 amount`. -/
def pdmEnc (g : PDm) : Array UInt8 :=
  g.pubkey.toArray ++ g.withdrawalCredentials.toArray ++ uintBytes 8 g.amount.toNat

theorem pdm_enc_size (g : PDm) : (pdmEnc g).size = 88 := by
  simp [pdmEnc, Spec.uintBytes_size]

theorem pdm_toValue_fits (g : PDm) : Value.fits prysmDmDesc g.toValue = true := by
  have := g.amount.toNat_lt
  simp only [prysmDmDesc, PDm.toValue, Value.fits, Value.fieldsFit] at *
  simp; omega

theorem pdm_toValue_injective (g h : PDm) (e : g.toValue = h.toValue) : g = h := by
  obtain ⟨p, r, a⟩ := g; obtain ⟨p', r', a'⟩ := h
  simp only [PDm.toValue, Value.seq.injEq, List.cons.injEq, Value.uint.injEq, Value.bytes.injEq,
    and_true] at e
  obtain ⟨e0, e1, e2⟩ := e
  rw [Vector.toArray_inj.mp e0, Vector.toArray_inj.mp e1, UInt64.toNat_inj.mp e2]

theorem pdm_toValue_surjective (D : Desc)
    (hD : D = prysmDmDesc ∨ D = dmCheckerDesc) (v : Value) (h : Value.fits D v = true) :
    ∃ g : PDm, g.toValue = v := by
  have h' : Value.fits prysmDmDesc v = true := by
    rcases hD with rfl | rfl
    · exact h
    · cases v <;> simp_all [prysmDmDesc, dmCheckerDesc, Value.fits]
  obtain ⟨vs, rfl, hf⟩ := fits_container h'
  have hl := fieldsFit_length hf
  match vs, hl with
  | [v0, v1, v2], _ =>
    simp only [fieldsFit_cons] at hf
    obtain ⟨h0, h1, h2, -⟩ := hf
    obtain ⟨q, rfl, hq⟩ : ∃ d, v0 = .bytes d ∧ d.size = 48 := by
      cases v0 <;> simp [Value.fits] at h0 ⊢; exact h0
    obtain ⟨d, rfl, hd⟩ : ∃ d, v1 = .bytes d ∧ d.size = 32 := by
      cases v1 <;> simp [Value.fits] at h1 ⊢; exact h1
    obtain ⟨a, rfl, ha⟩ := fits_uint h2
    simp only [Nat.reduceMul, Nat.reducePow] at ha
    exact ⟨⟨⟨q, hq⟩, ⟨d, hd⟩, UInt64.ofNat a⟩, by simp [PDm.toValue, Nat.mod_eq_of_lt ha]⟩

theorem pdm_toValue_surjective' (v : Value) (h : Value.fits prysmDmDesc v = true) : ∃ g : PDm, g.toValue = v :=
  pdm_toValue_surjective _ (.inl rfl) v h

/-- **`serialize g = pubkey ‖ withdrawalCredentials ‖ amount`.** -/
theorem pdm_serialize (g : PDm) : serialize prysmDmDesc g.toValue = .ok (pdmEnc g) := by
  obtain ⟨⟨q, hq⟩, ⟨r, hr⟩, a⟩ := g
  have := a.toNat_lt
  simp only [prysmDmDesc, PDm.toValue, serialize, serializeStruct, serializeFields, Vector.toArray_mk, hq, hr]
  simp (config := {decide := true}) [*, bind, Except.bind, pure, Except.pure, assemble, headWidth, bodyWidth,
    headOf, bodiesOf, Desc.isFixed, Desc.fixedSize, Spec.uintBytes_size, bytesPerOffset, pdmEnc,
    Desc.fieldsFixedSize, Array.append_assoc]

/-- **Spec roundtrip.** -/
theorem pdm_roundtrip (g : PDm) : deserialize prysmDmDesc (pdmEnc g) = .ok g.toValue :=
  deserialize_enc (G := PDm) (toV := PDm.toValue) (enc := pdmEnc) prysmDmDesc_wellFormed pdm_serialize
    pdm_toValue_fits g

theorem pdm_accepted_is_enc {bs : Array UInt8} {v : Value} (h : deserialize prysmDmDesc bs = .ok v) :
    ∃ g : PDm, v = g.toValue ∧ bs = pdmEnc g :=
  accepted_is_enc (G := PDm) (toV := PDm.toValue) (enc := pdmEnc) prysmDmDesc_wellFormed pdm_serialize
    pdm_toValue_surjective' h

/-- **EthLib accepts exactly the 88-byte inputs.** -/
theorem pdm_spec_accepts_iff (bs : Array UInt8) : (∃ v, deserialize prysmDmDesc bs = .ok v) ↔ bs.size = 88 := by
  constructor
  · rintro ⟨v, hd⟩
    obtain ⟨g, rfl, hb⟩ := pdm_accepted_is_enc hd
    rw [hb]; exact pdm_enc_size g
  · intro h
    have r0 := readUint_lt bs 80 8
    simp only [Nat.reducePow, Nat.reduceMul] at r0
    let g : PDm := ⟨⟨bs.extract 0 48, by simp; omega⟩, ⟨bs.extract 48 80, by simp; omega⟩,
      UInt64.ofNat (readUint bs 80 8)⟩
    have e : bs = pdmEnc g := by
      simp only [g, pdmEnc, UInt64.toNat_ofNat_of_lt' r0, uintBytes_readUint_slice bs 80 8 (by omega)]
      simp only [Nat.zero_add, Nat.reduceAdd]
      simp (config := {decide := true}) only [Array.extract_append_extract, Nat.min_def, Nat.max_def, ↓reduceIte]
      rw [← h]; simp
    rw [e]
    exact ⟨_, pdm_roundtrip g⟩

/-- `len(buf) ≠ 88`: EthLib rejects. -/
theorem pdm_spec_rejects (bs : Array UInt8) (h : bs.size ≠ 88) : ∃ e, deserialize prysmDmDesc bs = .error e := by
  cases hd : deserialize prysmDmDesc bs with
  | error e => exact ⟨e, rfl⟩
  | ok v => exact absurd ((pdm_spec_accepts_iff bs).mp ⟨v, hd⟩) h

/-! ### The checker Desc decodes like the hand Desc (accepted inputs and values) -/

theorem dmChecker_wellFormed : dmCheckerDesc.wellFormed = .ok () := by rfl

theorem pdm_serialize_checker (g : PDm) : serialize dmCheckerDesc g.toValue = .ok (pdmEnc g) := by
  rw [← prysmDmDesc_serialize_checker]; exact pdm_serialize g

theorem pdm_toValue_fits_checker (g : PDm) : Value.fits dmCheckerDesc g.toValue = true := by
  have := g.amount.toNat_lt
  simp [dmCheckerDesc, PDm.toValue, Value.fits, Value.fieldsFit]; omega

/-- **Codec equality on the accepted inputs**. -/
theorem prysmDmDesc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize prysmDmDesc bs = .ok v ↔ deserialize dmCheckerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := pdm_accepted_is_enc h
    rw [hb]
    exact deserialize_enc (G := PDm) (toV := PDm.toValue) (enc := pdmEnc) dmChecker_wellFormed
      pdm_serialize_checker pdm_toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := PDm) (toV := PDm.toValue) (enc := pdmEnc) dmChecker_wellFormed
      pdm_serialize_checker (pdm_toValue_surjective _ (.inr rfl)) h
    rw [hb]; exact pdm_roundtrip g

end E2e
