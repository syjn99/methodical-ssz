import E2e.Spec
import E2e.SpecEq
import E2eScal.PcDesc
import E2eScal.PcSpecChecker

/-!
# Spec bridge for the real Prysm `v1alpha1.PendingConsolidation` (hold-out, class D)

Hand-written: the text of `PwSpec.lean` with two uint64 fields.
`prysmPcDesc` (`PcDesc.lean`) is the independent hand `Desc` from consensus-specs electra; it was committed
before `pcCheckerDesc` was rendered and printed.
`pcCheckerDesc` (generated by `gen/e2e/descterm.py`) is the Desc checker's Desc of `(v1alpha1, PendingConsolidation)`
(producer output sha256 `94ebb2dd…` = the checker record in `gen/desc/results/main.result.json`).
`PPc` is the SSZ content of a Go `v1alpha1.PendingConsolidation` (two uint64 values).
-/

namespace E2e
open EthLib.Serialization.Ssz Fv1

/-- The checker's Desc has the same kinds in the same order; only the names differ. -/
theorem prysmPcDesc_checker :
    prysmPcDesc = .container ["source_index", "target_index"]
      [.uint 8, .uint 8]
    ∧ pcCheckerDesc = .container ["SourceIndex", "TargetIndex"]
      [.uint 8, .uint 8] :=
  ⟨rfl, rfl⟩

theorem prysmPcDesc_wellFormed : prysmPcDesc.wellFormed = .ok () := by rfl
theorem prysmPcDesc_fixedSize : prysmPcDesc.fixedSize = some 16 := by rfl

/-- EthLib's `serialize` ignores container names. -/
theorem prysmPcDesc_serialize_checker (v : Value) : serialize prysmPcDesc v = serialize pcCheckerDesc v := by
  unfold prysmPcDesc pcCheckerDesc
  cases v <;> (try simp only [serialize, serializeStruct]) <;> rfl

/-- The SSZ content of a Go `v1alpha1.PendingConsolidation` (two uint64 values). -/
structure PPc where
  sourceIndex : UInt64
  targetIndex : UInt64

def PPc.toValue (g : PPc) : Value :=
  .seq [.uint g.sourceIndex.toNat, .uint g.targetIndex.toNat]

/-- `uintBytes 8 sourceIndex ++ uintBytes 8 targetIndex`. -/
def ppcEnc (g : PPc) : Array UInt8 :=
  uintBytes 8 g.sourceIndex.toNat ++ uintBytes 8 g.targetIndex.toNat

theorem ppc_enc_size (g : PPc) : (ppcEnc g).size = 16 := by
  simp [ppcEnc, Fv.uintBytes_size]

theorem ppc_toValue_fits (g : PPc) : Value.fits prysmPcDesc g.toValue = true := by
  have := g.sourceIndex.toNat_lt; have := g.targetIndex.toNat_lt
  simp only [prysmPcDesc, PPc.toValue, Value.fits, Value.fieldsFit] at *
  simp; omega

theorem ppc_toValue_injective (g h : PPc) (e : g.toValue = h.toValue) : g = h := by
  obtain ⟨p, r⟩ := g; obtain ⟨p', r'⟩ := h
  simp only [PPc.toValue, Value.seq.injEq, List.cons.injEq, Value.uint.injEq, Value.bytes.injEq,
    and_true] at e
  obtain ⟨e0, e1⟩ := e
  rw [UInt64.toNat_inj.mp e0, UInt64.toNat_inj.mp e1]

theorem ppc_toValue_surjective (D : Desc)
    (hD : D = prysmPcDesc ∨ D = pcCheckerDesc) (v : Value) (h : Value.fits D v = true) :
    ∃ g : PPc, g.toValue = v := by
  have h' : Value.fits prysmPcDesc v = true := by
    rcases hD with rfl | rfl
    · exact h
    · cases v <;> simp_all [prysmPcDesc, pcCheckerDesc, Value.fits]
  obtain ⟨vs, rfl, hf⟩ := fits_container h'
  have hl := fieldsFit_length hf
  match vs, hl with
  | [v0, v1], _ =>
    simp only [fieldsFit_cons] at hf
    obtain ⟨h0, h1, -⟩ := hf
    obtain ⟨a0, rfl, ha0⟩ := fits_uint h0
    obtain ⟨a1, rfl, ha1⟩ := fits_uint h1
    simp only [Nat.reduceMul, Nat.reducePow] at ha0 ha1
    exact ⟨⟨UInt64.ofNat a0, UInt64.ofNat a1⟩,
      by simp [PPc.toValue, Nat.mod_eq_of_lt ha0, Nat.mod_eq_of_lt ha1]⟩

theorem ppc_toValue_surjective' (v : Value) (h : Value.fits prysmPcDesc v = true) : ∃ g : PPc, g.toValue = v :=
  ppc_toValue_surjective _ (.inl rfl) v h

/-- **`serialize g = sourceIndex ‖ targetIndex`.** -/
theorem ppc_serialize (g : PPc) : serialize prysmPcDesc g.toValue = .ok (ppcEnc g) := by
  obtain ⟨a0, a1⟩ := g
  have := a0.toNat_lt; have := a1.toNat_lt
  simp only [prysmPcDesc, PPc.toValue, serialize, serializeStruct, serializeFields, Vector.toArray_mk]
  simp (config := {decide := true}) [*, bind, Except.bind, pure, Except.pure, assemble, headWidth, bodyWidth,
    headOf, bodiesOf, Desc.isFixed, Desc.fixedSize, Fv.uintBytes_size, bytesPerOffset, ppcEnc,
    Desc.fieldsFixedSize, Array.append_assoc]

/-- **Spec roundtrip.** -/
theorem ppc_roundtrip (g : PPc) : deserialize prysmPcDesc (ppcEnc g) = .ok g.toValue :=
  deserialize_enc (G := PPc) (toV := PPc.toValue) (enc := ppcEnc) prysmPcDesc_wellFormed ppc_serialize
    ppc_toValue_fits g

theorem ppc_accepted_is_enc {bs : Array UInt8} {v : Value} (h : deserialize prysmPcDesc bs = .ok v) :
    ∃ g : PPc, v = g.toValue ∧ bs = ppcEnc g :=
  accepted_is_enc (G := PPc) (toV := PPc.toValue) (enc := ppcEnc) prysmPcDesc_wellFormed ppc_serialize
    ppc_toValue_surjective' h

/-- **EthLib accepts exactly the 16-byte inputs.** -/
theorem ppc_spec_accepts_iff (bs : Array UInt8) : (∃ v, deserialize prysmPcDesc bs = .ok v) ↔ bs.size = 16 := by
  constructor
  · rintro ⟨v, hd⟩
    obtain ⟨g, rfl, hb⟩ := ppc_accepted_is_enc hd
    rw [hb]; exact ppc_enc_size g
  · intro h
    have r0 := readUint_lt bs 0 8
    have r1 := readUint_lt bs 8 8
    simp only [Nat.reducePow, Nat.reduceMul] at r0 r1
    let g : PPc := ⟨UInt64.ofNat (readUint bs 0 8), UInt64.ofNat (readUint bs 8 8)⟩
    have e : bs = ppcEnc g := by
      simp only [g, ppcEnc, UInt64.toNat_ofNat_of_lt' r0, UInt64.toNat_ofNat_of_lt' r1,
        uintBytes_readUint_slice bs 0 8 (by omega), uintBytes_readUint_slice bs 8 8 (by omega)]
      simp only [Nat.zero_add, Nat.reduceAdd]
      simp (config := {decide := true}) only [Array.extract_append_extract, Nat.min_def, Nat.max_def, ↓reduceIte]
      rw [← h]; simp
    rw [e]
    exact ⟨_, ppc_roundtrip g⟩

/-- `len(buf) ≠ 16`: EthLib rejects. -/
theorem ppc_spec_rejects (bs : Array UInt8) (h : bs.size ≠ 16) : ∃ e, deserialize prysmPcDesc bs = .error e := by
  cases hd : deserialize prysmPcDesc bs with
  | error e => exact ⟨e, rfl⟩
  | ok v => exact absurd ((ppc_spec_accepts_iff bs).mp ⟨v, hd⟩) h

/-! ### The checker Desc decodes like the hand Desc (accepted inputs and values) -/

theorem pcChecker_wellFormed : pcCheckerDesc.wellFormed = .ok () := by rfl

theorem ppc_serialize_checker (g : PPc) : serialize pcCheckerDesc g.toValue = .ok (ppcEnc g) := by
  rw [← prysmPcDesc_serialize_checker]; exact ppc_serialize g

theorem ppc_toValue_fits_checker (g : PPc) : Value.fits pcCheckerDesc g.toValue = true := by
  have := g.sourceIndex.toNat_lt; have := g.targetIndex.toNat_lt
  simp [pcCheckerDesc, PPc.toValue, Value.fits, Value.fieldsFit]; omega

/-- **Codec equality on the accepted inputs**. -/
theorem prysmPcDesc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize prysmPcDesc bs = .ok v ↔ deserialize pcCheckerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := ppc_accepted_is_enc h
    rw [hb]
    exact deserialize_enc (G := PPc) (toV := PPc.toValue) (enc := ppcEnc) pcChecker_wellFormed
      ppc_serialize_checker ppc_toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := PPc) (toV := PPc.toValue) (enc := ppcEnc) pcChecker_wellFormed
      ppc_serialize_checker (ppc_toValue_surjective _ (.inr rfl)) h
    rw [hb]; exact ppc_roundtrip g

end E2e
