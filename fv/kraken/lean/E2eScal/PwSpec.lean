import E2e.Spec
import E2e.SpecEq
import E2eScal.PwDesc
import E2eScal.PwSpecChecker

/-!
# Spec bridge for the real Prysm `v1alpha1.PendingPartialWithdrawal` (hold-out, type B)

Hand-written: the text of `DmSpec.lean` with three uint64 fields.
`prysmPwDesc` (`PwDesc.lean`) is the independent hand `Desc` from consensus-specs electra; it was committed
before `pwCheckerDesc` was rendered and printed.
`pwCheckerDesc` (generated by `gen/e2e/descterm.py`) is the Desc checker's Desc of `(v1alpha1, PendingPartialWithdrawal)`
(producer output sha256 `608e906f…` = the checker record in `gen/desc/results/main.result.json`).
`PPw` is the SSZ content of a Go `v1alpha1.PendingPartialWithdrawal` (three uint64 values).
-/

namespace E2e
open EthLib.Serialization.Ssz
open Spec hiding readUint_lt

/-- The checker's Desc has the same kinds in the same order; only the names differ. -/
theorem prysmPwDesc_checker :
    prysmPwDesc = .container ["validator_index", "amount", "withdrawable_epoch"]
      [.uint 8, .uint 8, .uint 8]
    ∧ pwCheckerDesc = .container ["Index", "Amount", "WithdrawableEpoch"]
      [.uint 8, .uint 8, .uint 8] :=
  ⟨rfl, rfl⟩

theorem prysmPwDesc_wellFormed : prysmPwDesc.wellFormed = .ok () := by rfl
theorem prysmPwDesc_fixedSize : prysmPwDesc.fixedSize = some 24 := by rfl

/-- EthLib's `serialize` ignores container names. -/
theorem prysmPwDesc_serialize_checker (v : Value) : serialize prysmPwDesc v = serialize pwCheckerDesc v := by
  unfold prysmPwDesc pwCheckerDesc
  cases v <;> (try simp only [serialize, serializeStruct]) <;> rfl

/-- The SSZ content of a Go `v1alpha1.PendingPartialWithdrawal` (three uint64 values). -/
structure PPw where
  index : UInt64
  amount : UInt64
  withdrawableEpoch : UInt64

def PPw.toValue (g : PPw) : Value :=
  .seq [.uint g.index.toNat, .uint g.amount.toNat, .uint g.withdrawableEpoch.toNat]

/-- `uintBytes 8 index ++ uintBytes 8 amount ++ uintBytes 8 withdrawableEpoch`. -/
def ppwEnc (g : PPw) : Array UInt8 :=
  uintBytes 8 g.index.toNat ++ uintBytes 8 g.amount.toNat ++ uintBytes 8 g.withdrawableEpoch.toNat

theorem ppw_enc_size (g : PPw) : (ppwEnc g).size = 24 := by
  simp [ppwEnc, Spec.uintBytes_size]

theorem ppw_toValue_fits (g : PPw) : Value.fits prysmPwDesc g.toValue = true := by
  have := g.index.toNat_lt; have := g.amount.toNat_lt; have := g.withdrawableEpoch.toNat_lt
  simp only [prysmPwDesc, PPw.toValue, Value.fits, Value.fieldsFit] at *
  simp; omega

theorem ppw_toValue_injective (g h : PPw) (e : g.toValue = h.toValue) : g = h := by
  obtain ⟨p, r, a⟩ := g; obtain ⟨p', r', a'⟩ := h
  simp only [PPw.toValue, Value.seq.injEq, List.cons.injEq, Value.uint.injEq, Value.bytes.injEq,
    and_true] at e
  obtain ⟨e0, e1, e2⟩ := e
  rw [UInt64.toNat_inj.mp e0, UInt64.toNat_inj.mp e1, UInt64.toNat_inj.mp e2]

theorem ppw_toValue_surjective (D : Desc)
    (hD : D = prysmPwDesc ∨ D = pwCheckerDesc) (v : Value) (h : Value.fits D v = true) :
    ∃ g : PPw, g.toValue = v := by
  have h' : Value.fits prysmPwDesc v = true := by
    rcases hD with rfl | rfl
    · exact h
    · cases v <;> simp_all [prysmPwDesc, pwCheckerDesc, Value.fits]
  obtain ⟨vs, rfl, hf⟩ := fits_container h'
  have hl := fieldsFit_length hf
  match vs, hl with
  | [v0, v1, v2], _ =>
    simp only [fieldsFit_cons] at hf
    obtain ⟨h0, h1, h2, -⟩ := hf
    obtain ⟨a0, rfl, ha0⟩ := fits_uint h0
    obtain ⟨a1, rfl, ha1⟩ := fits_uint h1
    obtain ⟨a2, rfl, ha2⟩ := fits_uint h2
    simp only [Nat.reduceMul, Nat.reducePow] at ha0 ha1 ha2
    exact ⟨⟨UInt64.ofNat a0, UInt64.ofNat a1, UInt64.ofNat a2⟩,
      by simp [PPw.toValue, Nat.mod_eq_of_lt ha0, Nat.mod_eq_of_lt ha1, Nat.mod_eq_of_lt ha2]⟩

theorem ppw_toValue_surjective' (v : Value) (h : Value.fits prysmPwDesc v = true) : ∃ g : PPw, g.toValue = v :=
  ppw_toValue_surjective _ (.inl rfl) v h

/-- **`serialize g = index ‖ amount ‖ withdrawableEpoch`.** -/
theorem ppw_serialize (g : PPw) : serialize prysmPwDesc g.toValue = .ok (ppwEnc g) := by
  obtain ⟨a0, a1, a2⟩ := g
  have := a0.toNat_lt; have := a1.toNat_lt; have := a2.toNat_lt
  simp only [prysmPwDesc, PPw.toValue, serialize, serializeStruct, serializeFields, Vector.toArray_mk]
  simp (config := {decide := true}) [*, bind, Except.bind, pure, Except.pure, assemble, headWidth, bodyWidth,
    headOf, bodiesOf, Desc.isFixed, Desc.fixedSize, Spec.uintBytes_size, bytesPerOffset, ppwEnc,
    Desc.fieldsFixedSize, Array.append_assoc]

/-- **Spec roundtrip.** -/
theorem ppw_roundtrip (g : PPw) : deserialize prysmPwDesc (ppwEnc g) = .ok g.toValue :=
  deserialize_enc (G := PPw) (toV := PPw.toValue) (enc := ppwEnc) prysmPwDesc_wellFormed ppw_serialize
    ppw_toValue_fits g

theorem ppw_accepted_is_enc {bs : Array UInt8} {v : Value} (h : deserialize prysmPwDesc bs = .ok v) :
    ∃ g : PPw, v = g.toValue ∧ bs = ppwEnc g :=
  accepted_is_enc (G := PPw) (toV := PPw.toValue) (enc := ppwEnc) prysmPwDesc_wellFormed ppw_serialize
    ppw_toValue_surjective' h

/-- **EthLib accepts exactly the 24-byte inputs.** -/
theorem ppw_spec_accepts_iff (bs : Array UInt8) : (∃ v, deserialize prysmPwDesc bs = .ok v) ↔ bs.size = 24 := by
  constructor
  · rintro ⟨v, hd⟩
    obtain ⟨g, rfl, hb⟩ := ppw_accepted_is_enc hd
    rw [hb]; exact ppw_enc_size g
  · intro h
    have r0 := readUint_lt bs 0 8
    have r1 := readUint_lt bs 8 8
    have r2 := readUint_lt bs 16 8
    simp only [Nat.reducePow, Nat.reduceMul] at r0 r1 r2
    let g : PPw := ⟨UInt64.ofNat (readUint bs 0 8), UInt64.ofNat (readUint bs 8 8), UInt64.ofNat (readUint bs 16 8)⟩
    have e : bs = ppwEnc g := by
      simp only [g, ppwEnc, UInt64.toNat_ofNat_of_lt' r0, UInt64.toNat_ofNat_of_lt' r1, UInt64.toNat_ofNat_of_lt' r2,
        uintBytes_readUint_slice bs 0 8 (by omega), uintBytes_readUint_slice bs 8 8 (by omega),
        uintBytes_readUint_slice bs 16 8 (by omega)]
      simp only [Nat.zero_add, Nat.reduceAdd]
      simp (config := {decide := true}) only [Array.extract_append_extract, Nat.min_def, Nat.max_def, ↓reduceIte]
      rw [← h]; simp
    rw [e]
    exact ⟨_, ppw_roundtrip g⟩

/-- `len(buf) ≠ 24`: EthLib rejects. -/
theorem ppw_spec_rejects (bs : Array UInt8) (h : bs.size ≠ 24) : ∃ e, deserialize prysmPwDesc bs = .error e := by
  cases hd : deserialize prysmPwDesc bs with
  | error e => exact ⟨e, rfl⟩
  | ok v => exact absurd ((ppw_spec_accepts_iff bs).mp ⟨v, hd⟩) h

/-! ### The checker Desc decodes like the hand Desc (accepted inputs and values) -/

theorem pwChecker_wellFormed : pwCheckerDesc.wellFormed = .ok () := by rfl

theorem ppw_serialize_checker (g : PPw) : serialize pwCheckerDesc g.toValue = .ok (ppwEnc g) := by
  rw [← prysmPwDesc_serialize_checker]; exact ppw_serialize g

theorem ppw_toValue_fits_checker (g : PPw) : Value.fits pwCheckerDesc g.toValue = true := by
  have := g.index.toNat_lt; have := g.amount.toNat_lt; have := g.withdrawableEpoch.toNat_lt
  simp [pwCheckerDesc, PPw.toValue, Value.fits, Value.fieldsFit]; omega

/-- **Codec equality on the accepted inputs**. -/
theorem prysmPwDesc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize prysmPwDesc bs = .ok v ↔ deserialize pwCheckerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := ppw_accepted_is_enc h
    rw [hb]
    exact deserialize_enc (G := PPw) (toV := PPw.toValue) (enc := ppwEnc) pwChecker_wellFormed
      ppw_serialize_checker ppw_toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := PPw) (toV := PPw.toValue) (enc := ppwEnc) pwChecker_wellFormed
      ppw_serialize_checker (ppw_toValue_surjective _ (.inr rfl)) h
    rw [hb]; exact ppw_roundtrip g

end E2e
