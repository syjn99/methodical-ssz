import E2e.Spec
import E2e.SpecEq
import E2eScal.DdDesc
import E2eScal.DdSpecChecker

/-!
# Spec bridge for the real Prysm `v1alpha1.Deposit_Data` (H4 hold-out, type A)

Hand-written by the H4 evaluation session: the text of `DmSpec.lean` with the fourth field `signature` (Bytes96).
`prysmDdDesc` (`DdDesc.lean`) is the independent hand `Desc` from consensus-specs phase0; it was committed
before `ddCheckerDesc` was rendered and printed.
`ddCheckerDesc` (generated by `gen/e2e/descterm.py`) is the Desc checker's Desc of `(v1alpha1, Deposit_Data)`
(producer output sha256 `93bfd30f…` = the checker record in `gen/desc/results/main.result.json`).
`PDd` is the SSZ content of a Go `v1alpha1.Deposit_Data` whose PublicKey, WithdrawalCredentials and Signature have
lengths 48, 32 and 96.
-/

namespace E2e
open EthLib.Serialization.Ssz Fv1

/-- The checker's Desc has the same kinds in the same order; only the names differ. -/
theorem prysmDdDesc_checker :
    prysmDdDesc = .container ["pubkey", "withdrawal_credentials", "amount", "signature"]
      [.byteVector 48, .byteVector 32, .uint 8, .byteVector 96]
    ∧ ddCheckerDesc = .container ["PublicKey", "WithdrawalCredentials", "Amount", "Signature"]
      [.byteVector 48, .byteVector 32, .uint 8, .byteVector 96] :=
  ⟨rfl, rfl⟩

theorem prysmDdDesc_wellFormed : prysmDdDesc.wellFormed = .ok () := by rfl
theorem prysmDdDesc_fixedSize : prysmDdDesc.fixedSize = some 184 := by rfl

/-- EthLib's `serialize` ignores container names. -/
theorem prysmDdDesc_serialize_checker (v : Value) : serialize prysmDdDesc v = serialize ddCheckerDesc v := by
  unfold prysmDdDesc ddCheckerDesc
  cases v <;> (try simp only [serialize, serializeStruct]) <;> rfl

/-- The SSZ content of a Go `v1alpha1.Deposit_Data` (PublicKey 48, WithdrawalCredentials 32, Signature 96 bytes). -/
structure PDd where
  pubkey : Vector UInt8 48
  withdrawalCredentials : Vector UInt8 32
  amount : UInt64
  signature : Vector UInt8 96

def PDd.toValue (g : PDd) : Value :=
  .seq [.bytes g.pubkey.toArray, .bytes g.withdrawalCredentials.toArray, .uint g.amount.toNat, .bytes g.signature.toArray]

/-- `pubkey ++ withdrawalCredentials ++ uintBytes 8 amount ++ signature`. -/
def pddEnc (g : PDd) : Array UInt8 :=
  g.pubkey.toArray ++ g.withdrawalCredentials.toArray ++ uintBytes 8 g.amount.toNat ++ g.signature.toArray

theorem pdd_enc_size (g : PDd) : (pddEnc g).size = 184 := by
  simp [pddEnc, Fv.uintBytes_size]

theorem pdd_toValue_fits (g : PDd) : Value.fits prysmDdDesc g.toValue = true := by
  have := g.amount.toNat_lt
  simp only [prysmDdDesc, PDd.toValue, Value.fits, Value.fieldsFit] at *
  simp; omega

theorem pdd_toValue_injective (g h : PDd) (e : g.toValue = h.toValue) : g = h := by
  obtain ⟨p, r, a, q⟩ := g; obtain ⟨p', r', a', q'⟩ := h
  simp only [PDd.toValue, Value.seq.injEq, List.cons.injEq, Value.uint.injEq, Value.bytes.injEq,
    and_true] at e
  obtain ⟨e0, e1, e2, e3⟩ := e
  rw [Vector.toArray_inj.mp e0, Vector.toArray_inj.mp e1, UInt64.toNat_inj.mp e2, Vector.toArray_inj.mp e3]

theorem pdd_toValue_surjective (D : Desc)
    (hD : D = prysmDdDesc ∨ D = ddCheckerDesc) (v : Value) (h : Value.fits D v = true) :
    ∃ g : PDd, g.toValue = v := by
  have h' : Value.fits prysmDdDesc v = true := by
    rcases hD with rfl | rfl
    · exact h
    · cases v <;> simp_all [prysmDdDesc, ddCheckerDesc, Value.fits]
  obtain ⟨vs, rfl, hf⟩ := fits_container h'
  have hl := fieldsFit_length hf
  match vs, hl with
  | [v0, v1, v2, v3], _ =>
    simp only [fieldsFit_cons] at hf
    obtain ⟨h0, h1, h2, h3, -⟩ := hf
    obtain ⟨q, rfl, hq⟩ : ∃ d, v0 = .bytes d ∧ d.size = 48 := by
      cases v0 <;> simp [Value.fits] at h0 ⊢; exact h0
    obtain ⟨d, rfl, hd⟩ : ∃ d, v1 = .bytes d ∧ d.size = 32 := by
      cases v1 <;> simp [Value.fits] at h1 ⊢; exact h1
    obtain ⟨a, rfl, ha⟩ := fits_uint h2
    obtain ⟨z, rfl, hz⟩ : ∃ d, v3 = .bytes d ∧ d.size = 96 := by
      cases v3 <;> simp [Value.fits] at h3 ⊢; exact h3
    simp only [Nat.reduceMul, Nat.reducePow] at ha
    exact ⟨⟨⟨q, hq⟩, ⟨d, hd⟩, UInt64.ofNat a, ⟨z, hz⟩⟩, by simp [PDd.toValue, Nat.mod_eq_of_lt ha]⟩

theorem pdd_toValue_surjective' (v : Value) (h : Value.fits prysmDdDesc v = true) : ∃ g : PDd, g.toValue = v :=
  pdd_toValue_surjective _ (.inl rfl) v h

/-- **`serialize g = pubkey ‖ withdrawalCredentials ‖ amount ‖ signature`.** -/
theorem pdd_serialize (g : PDd) : serialize prysmDdDesc g.toValue = .ok (pddEnc g) := by
  obtain ⟨⟨q, hq⟩, ⟨r, hr⟩, a, ⟨z, hz⟩⟩ := g
  have := a.toNat_lt
  simp only [prysmDdDesc, PDd.toValue, serialize, serializeStruct, serializeFields, Vector.toArray_mk, hq, hr, hz]
  simp (config := {decide := true}) [*, bind, Except.bind, pure, Except.pure, assemble, headWidth, bodyWidth,
    headOf, bodiesOf, Desc.isFixed, Desc.fixedSize, Fv.uintBytes_size, bytesPerOffset, pddEnc,
    Desc.fieldsFixedSize, Array.append_assoc]

/-- **Spec roundtrip.** -/
theorem pdd_roundtrip (g : PDd) : deserialize prysmDdDesc (pddEnc g) = .ok g.toValue :=
  deserialize_enc (G := PDd) (toV := PDd.toValue) (enc := pddEnc) prysmDdDesc_wellFormed pdd_serialize
    pdd_toValue_fits g

theorem pdd_accepted_is_enc {bs : Array UInt8} {v : Value} (h : deserialize prysmDdDesc bs = .ok v) :
    ∃ g : PDd, v = g.toValue ∧ bs = pddEnc g :=
  accepted_is_enc (G := PDd) (toV := PDd.toValue) (enc := pddEnc) prysmDdDesc_wellFormed pdd_serialize
    pdd_toValue_surjective' h

/-- **EthLib accepts exactly the 184-byte inputs.** -/
theorem pdd_spec_accepts_iff (bs : Array UInt8) : (∃ v, deserialize prysmDdDesc bs = .ok v) ↔ bs.size = 184 := by
  constructor
  · rintro ⟨v, hd⟩
    obtain ⟨g, rfl, hb⟩ := pdd_accepted_is_enc hd
    rw [hb]; exact pdd_enc_size g
  · intro h
    have r0 := readUint_lt bs 80 8
    simp only [Nat.reducePow, Nat.reduceMul] at r0
    let g : PDd := ⟨⟨bs.extract 0 48, by simp; omega⟩, ⟨bs.extract 48 80, by simp; omega⟩,
      UInt64.ofNat (readUint bs 80 8), ⟨bs.extract 88 184, by simp; omega⟩⟩
    have e : bs = pddEnc g := by
      simp only [g, pddEnc, UInt64.toNat_ofNat_of_lt' r0, uintBytes_readUint_slice bs 80 8 (by omega)]
      simp only [Nat.zero_add, Nat.reduceAdd]
      simp (config := {decide := true}) only [Array.extract_append_extract, Nat.min_def, Nat.max_def, ↓reduceIte]
      rw [← h]; simp
    rw [e]
    exact ⟨_, pdd_roundtrip g⟩

/-- `len(buf) ≠ 184`: EthLib rejects. -/
theorem pdd_spec_rejects (bs : Array UInt8) (h : bs.size ≠ 184) : ∃ e, deserialize prysmDdDesc bs = .error e := by
  cases hd : deserialize prysmDdDesc bs with
  | error e => exact ⟨e, rfl⟩
  | ok v => exact absurd ((pdd_spec_accepts_iff bs).mp ⟨v, hd⟩) h

/-! ### The checker Desc decodes like the hand Desc (accepted inputs and values) -/

theorem ddChecker_wellFormed : ddCheckerDesc.wellFormed = .ok () := by rfl

theorem pdd_serialize_checker (g : PDd) : serialize ddCheckerDesc g.toValue = .ok (pddEnc g) := by
  rw [← prysmDdDesc_serialize_checker]; exact pdd_serialize g

theorem pdd_toValue_fits_checker (g : PDd) : Value.fits ddCheckerDesc g.toValue = true := by
  have := g.amount.toNat_lt
  simp [ddCheckerDesc, PDd.toValue, Value.fits, Value.fieldsFit]; omega

/-- **Codec equality on the accepted inputs**. -/
theorem prysmDdDesc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize prysmDdDesc bs = .ok v ↔ deserialize ddCheckerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := pdd_accepted_is_enc h
    rw [hb]
    exact deserialize_enc (G := PDd) (toV := PDd.toValue) (enc := pddEnc) ddChecker_wellFormed
      pdd_serialize_checker pdd_toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := PDd) (toV := PDd.toValue) (enc := pddEnc) ddChecker_wellFormed
      pdd_serialize_checker (pdd_toValue_surjective _ (.inr rfl)) h
    rw [hb]; exact pdd_roundtrip g

end E2e
