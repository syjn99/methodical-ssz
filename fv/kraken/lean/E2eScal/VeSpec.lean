import E2e.Spec
import E2e.SpecEq
import E2eScal.VeDesc
import E2eScal.VeSpecChecker

/-!
# Spec bridge for the real Prysm `v1alpha1.VoluntaryExit`

The text of `PcSpec.lean` with names changed (two uint64 fields).
`prysmVeDesc` (`VeDesc.lean`) is the independent hand `Desc` (consensus-specs); it was committed before
`veCheckerDesc` was rendered and printed. `veCheckerDesc` (generated by `gen/e2e/descterm.py`) is the Desc checker's
Desc of `(v1alpha1, VoluntaryExit)` (producer output = the checker record in `gen/desc/results/main.result.json`, same
sha256; copy in `prysm/go1.26.10/e2e/g5c/`).
`PVe` is the SSZ content of a Go `v1alpha1.VoluntaryExit` (two uint64 values).
-/

namespace E2e
open EthLib.Serialization.Ssz
open Spec hiding readUint_lt

/-- The checker's Desc has the same kinds in the same order; only the names differ. -/
theorem prysmVeDesc_checker :
    prysmVeDesc = .container ["epoch", "validator_index"]
      [.uint 8, .uint 8]
    ∧ veCheckerDesc = .container ["Epoch", "ValidatorIndex"]
      [.uint 8, .uint 8] :=
  ⟨rfl, rfl⟩

theorem prysmVeDesc_wellFormed : prysmVeDesc.wellFormed = .ok () := by rfl
theorem prysmVeDesc_fixedSize : prysmVeDesc.fixedSize = some 16 := by rfl

/-- EthLib's `serialize` ignores container names. -/
theorem prysmVeDesc_serialize_checker (v : Value) : serialize prysmVeDesc v = serialize veCheckerDesc v := by
  unfold prysmVeDesc veCheckerDesc
  cases v <;> (try simp only [serialize, serializeStruct]) <;> rfl

/-- The SSZ content of a Go `v1alpha1.VoluntaryExit` (two uint64 values). -/
structure PVe where
  epoch : UInt64
  validatorIndex : UInt64

def PVe.toValue (g : PVe) : Value :=
  .seq [.uint g.epoch.toNat, .uint g.validatorIndex.toNat]

/-- `uintBytes 8 epoch ++ uintBytes 8 validatorIndex`. -/
def pveEnc (g : PVe) : Array UInt8 :=
  uintBytes 8 g.epoch.toNat ++ uintBytes 8 g.validatorIndex.toNat

theorem pve_enc_size (g : PVe) : (pveEnc g).size = 16 := by
  simp [pveEnc, Spec.uintBytes_size]

theorem pve_toValue_fits (g : PVe) : Value.fits prysmVeDesc g.toValue = true := by
  have := g.epoch.toNat_lt; have := g.validatorIndex.toNat_lt
  simp only [prysmVeDesc, PVe.toValue, Value.fits, Value.fieldsFit] at *
  simp; omega

theorem pve_toValue_injective (g h : PVe) (e : g.toValue = h.toValue) : g = h := by
  obtain ⟨p, r⟩ := g; obtain ⟨p', r'⟩ := h
  simp only [PVe.toValue, Value.seq.injEq, List.cons.injEq, Value.uint.injEq, Value.bytes.injEq,
    and_true] at e
  obtain ⟨e0, e1⟩ := e
  rw [UInt64.toNat_inj.mp e0, UInt64.toNat_inj.mp e1]

theorem pve_toValue_surjective (D : Desc)
    (hD : D = prysmVeDesc ∨ D = veCheckerDesc) (v : Value) (h : Value.fits D v = true) :
    ∃ g : PVe, g.toValue = v := by
  have h' : Value.fits prysmVeDesc v = true := by
    rcases hD with rfl | rfl
    · exact h
    · cases v <;> simp_all [prysmVeDesc, veCheckerDesc, Value.fits]
  obtain ⟨vs, rfl, hf⟩ := fits_container h'
  have hl := fieldsFit_length hf
  match vs, hl with
  | [v0, v1], _ =>
    simp only [fieldsFit_cons] at hf
    obtain ⟨h0, h1, -⟩ := hf
    obtain ⟨a0, rfl, ha0⟩ := fits_uint h0
    obtain ⟨a1, rfl, ha1⟩ := fits_uint h1
    simp only [Nat.reduceMul, Nat.reducePow] at ha0 ha1
    exact ⟨⟨UInt64.ofNat a0, UInt64.ofNat a1⟩,
      by simp [PVe.toValue, Nat.mod_eq_of_lt ha0, Nat.mod_eq_of_lt ha1]⟩

theorem pve_toValue_surjective' (v : Value) (h : Value.fits prysmVeDesc v = true) : ∃ g : PVe, g.toValue = v :=
  pve_toValue_surjective _ (.inl rfl) v h

/-- **`serialize g = epoch ‖ validatorIndex`.** -/
theorem pve_serialize (g : PVe) : serialize prysmVeDesc g.toValue = .ok (pveEnc g) := by
  obtain ⟨a0, a1⟩ := g
  have := a0.toNat_lt; have := a1.toNat_lt
  simp only [prysmVeDesc, PVe.toValue, serialize, serializeStruct, serializeFields, Vector.toArray_mk]
  simp (config := {decide := true}) [*, bind, Except.bind, pure, Except.pure, assemble, headWidth, bodyWidth,
    headOf, bodiesOf, Desc.isFixed, Desc.fixedSize, Spec.uintBytes_size, bytesPerOffset, pveEnc,
    Desc.fieldsFixedSize, Array.append_assoc]

/-- **Spec roundtrip.** -/
theorem pve_roundtrip (g : PVe) : deserialize prysmVeDesc (pveEnc g) = .ok g.toValue :=
  deserialize_enc (G := PVe) (toV := PVe.toValue) (enc := pveEnc) prysmVeDesc_wellFormed pve_serialize
    pve_toValue_fits g

theorem pve_accepted_is_enc {bs : Array UInt8} {v : Value} (h : deserialize prysmVeDesc bs = .ok v) :
    ∃ g : PVe, v = g.toValue ∧ bs = pveEnc g :=
  accepted_is_enc (G := PVe) (toV := PVe.toValue) (enc := pveEnc) prysmVeDesc_wellFormed pve_serialize
    pve_toValue_surjective' h

/-- **EthLib accepts exactly the 16-byte inputs.** -/
theorem pve_spec_accepts_iff (bs : Array UInt8) : (∃ v, deserialize prysmVeDesc bs = .ok v) ↔ bs.size = 16 := by
  constructor
  · rintro ⟨v, hd⟩
    obtain ⟨g, rfl, hb⟩ := pve_accepted_is_enc hd
    rw [hb]; exact pve_enc_size g
  · intro h
    have r0 := readUint_lt bs 0 8
    have r1 := readUint_lt bs 8 8
    simp only [Nat.reducePow, Nat.reduceMul] at r0 r1
    let g : PVe := ⟨UInt64.ofNat (readUint bs 0 8), UInt64.ofNat (readUint bs 8 8)⟩
    have e : bs = pveEnc g := by
      simp only [g, pveEnc, UInt64.toNat_ofNat_of_lt' r0, UInt64.toNat_ofNat_of_lt' r1,
        uintBytes_readUint_slice bs 0 8 (by omega), uintBytes_readUint_slice bs 8 8 (by omega)]
      simp only [Nat.zero_add, Nat.reduceAdd]
      simp (config := {decide := true}) only [Array.extract_append_extract, Nat.min_def, Nat.max_def, ↓reduceIte]
      rw [← h]; simp
    rw [e]
    exact ⟨_, pve_roundtrip g⟩

/-- `len(buf) ≠ 16`: EthLib rejects. -/
theorem pve_spec_rejects (bs : Array UInt8) (h : bs.size ≠ 16) : ∃ e, deserialize prysmVeDesc bs = .error e := by
  cases hd : deserialize prysmVeDesc bs with
  | error e => exact ⟨e, rfl⟩
  | ok v => exact absurd ((pve_spec_accepts_iff bs).mp ⟨v, hd⟩) h

/-! ### The checker Desc decodes like the hand Desc (accepted inputs and values) -/

theorem veChecker_wellFormed : veCheckerDesc.wellFormed = .ok () := by rfl

theorem pve_serialize_checker (g : PVe) : serialize veCheckerDesc g.toValue = .ok (pveEnc g) := by
  rw [← prysmVeDesc_serialize_checker]; exact pve_serialize g

theorem pve_toValue_fits_checker (g : PVe) : Value.fits veCheckerDesc g.toValue = true := by
  have := g.epoch.toNat_lt; have := g.validatorIndex.toNat_lt
  simp [veCheckerDesc, PVe.toValue, Value.fits, Value.fieldsFit]; omega

/-- **Codec equality on the accepted inputs**. -/
theorem prysmVeDesc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize prysmVeDesc bs = .ok v ↔ deserialize veCheckerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := pve_accepted_is_enc h
    rw [hb]
    exact deserialize_enc (G := PVe) (toV := PVe.toValue) (enc := pveEnc) veChecker_wellFormed
      pve_serialize_checker pve_toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := PVe) (toV := PVe.toValue) (enc := pveEnc) veChecker_wellFormed
      pve_serialize_checker (pve_toValue_surjective _ (.inr rfl)) h
    rw [hb]; exact pve_roundtrip g

end E2e
