import E2e.Spec
import E2e.SpecEq
import E2eScal.SmDesc
import E2eScal.SmSpecChecker

/-!
# Spec bridge for the real Prysm `v1alpha1.SyncCommitteeMessage` (hold-out, class C)

Hand-written: the text of `DdSpec.lean` with the fields
`[uint64, Bytes32, uint64, Bytes96]`.
`prysmSmDesc` (`SmDesc.lean`) is the independent hand `Desc` from consensus-specs altair; it was committed
before `smCheckerDesc` was rendered and printed.
`smCheckerDesc` (generated by `gen/e2e/descterm.py`) is the Desc checker's Desc of `(v1alpha1, SyncCommitteeMessage)`
(producer output sha256 `2c7b1f7f…` = the checker record in `gen/desc/results/main.result.json`).
`PSm` is the SSZ content of a Go `v1alpha1.SyncCommitteeMessage` (Slot, BlockRoot 32, ValidatorIndex, Signature 96).
-/

namespace E2e
open EthLib.Serialization.Ssz
open Spec hiding readUint_lt

/-- The checker's Desc has the same kinds in the same order; only the names differ. -/
theorem prysmSmDesc_checker :
    prysmSmDesc = .container ["slot", "beacon_block_root", "validator_index", "signature"]
      [.uint 8, .byteVector 32, .uint 8, .byteVector 96]
    ∧ smCheckerDesc = .container ["Slot", "BlockRoot", "ValidatorIndex", "Signature"]
      [.uint 8, .byteVector 32, .uint 8, .byteVector 96] :=
  ⟨rfl, rfl⟩

theorem prysmSmDesc_wellFormed : prysmSmDesc.wellFormed = .ok () := by rfl
theorem prysmSmDesc_fixedSize : prysmSmDesc.fixedSize = some 144 := by rfl

/-- EthLib's `serialize` ignores container names. -/
theorem prysmSmDesc_serialize_checker (v : Value) : serialize prysmSmDesc v = serialize smCheckerDesc v := by
  unfold prysmSmDesc smCheckerDesc
  cases v <;> (try simp only [serialize, serializeStruct]) <;> rfl

/-- The SSZ content of a Go `v1alpha1.SyncCommitteeMessage` (Slot, BlockRoot 32 bytes, ValidatorIndex, Signature 96 bytes). -/
structure PSm where
  slot : UInt64
  blockRoot : Vector UInt8 32
  validatorIndex : UInt64
  signature : Vector UInt8 96

def PSm.toValue (g : PSm) : Value :=
  .seq [.uint g.slot.toNat, .bytes g.blockRoot.toArray, .uint g.validatorIndex.toNat, .bytes g.signature.toArray]

/-- `uintBytes 8 slot ++ blockRoot ++ uintBytes 8 validatorIndex ++ signature`. -/
def psmEnc (g : PSm) : Array UInt8 :=
  uintBytes 8 g.slot.toNat ++ g.blockRoot.toArray ++ uintBytes 8 g.validatorIndex.toNat ++ g.signature.toArray

theorem psm_enc_size (g : PSm) : (psmEnc g).size = 144 := by
  simp [psmEnc, Spec.uintBytes_size]

theorem psm_toValue_fits (g : PSm) : Value.fits prysmSmDesc g.toValue = true := by
  have := g.slot.toNat_lt; have := g.validatorIndex.toNat_lt
  simp only [prysmSmDesc, PSm.toValue, Value.fits, Value.fieldsFit] at *
  simp; omega

theorem psm_toValue_injective (g h : PSm) (e : g.toValue = h.toValue) : g = h := by
  obtain ⟨p, r, a, q⟩ := g; obtain ⟨p', r', a', q'⟩ := h
  simp only [PSm.toValue, Value.seq.injEq, List.cons.injEq, Value.uint.injEq, Value.bytes.injEq,
    and_true] at e
  obtain ⟨e0, e1, e2, e3⟩ := e
  rw [UInt64.toNat_inj.mp e0, Vector.toArray_inj.mp e1, UInt64.toNat_inj.mp e2, Vector.toArray_inj.mp e3]

theorem psm_toValue_surjective (D : Desc)
    (hD : D = prysmSmDesc ∨ D = smCheckerDesc) (v : Value) (h : Value.fits D v = true) :
    ∃ g : PSm, g.toValue = v := by
  have h' : Value.fits prysmSmDesc v = true := by
    rcases hD with rfl | rfl
    · exact h
    · cases v <;> simp_all [prysmSmDesc, smCheckerDesc, Value.fits]
  obtain ⟨vs, rfl, hf⟩ := fits_container h'
  have hl := fieldsFit_length hf
  match vs, hl with
  | [v0, v1, v2, v3], _ =>
    simp only [fieldsFit_cons] at hf
    obtain ⟨h0, h1, h2, h3, -⟩ := hf
    obtain ⟨a0, rfl, ha0⟩ := fits_uint h0
    obtain ⟨d, rfl, hd⟩ : ∃ d, v1 = .bytes d ∧ d.size = 32 := by
      cases v1 <;> simp [Value.fits] at h1 ⊢; exact h1
    obtain ⟨a, rfl, ha⟩ := fits_uint h2
    obtain ⟨z, rfl, hz⟩ : ∃ d, v3 = .bytes d ∧ d.size = 96 := by
      cases v3 <;> simp [Value.fits] at h3 ⊢; exact h3
    simp only [Nat.reduceMul, Nat.reducePow] at ha0 ha
    exact ⟨⟨UInt64.ofNat a0, ⟨d, hd⟩, UInt64.ofNat a, ⟨z, hz⟩⟩,
      by simp [PSm.toValue, Nat.mod_eq_of_lt ha0, Nat.mod_eq_of_lt ha]⟩

theorem psm_toValue_surjective' (v : Value) (h : Value.fits prysmSmDesc v = true) : ∃ g : PSm, g.toValue = v :=
  psm_toValue_surjective _ (.inl rfl) v h

/-- **`serialize g = slot ‖ blockRoot ‖ validatorIndex ‖ signature`.** -/
theorem psm_serialize (g : PSm) : serialize prysmSmDesc g.toValue = .ok (psmEnc g) := by
  obtain ⟨a0, ⟨r, hr⟩, a, ⟨z, hz⟩⟩ := g
  have := a0.toNat_lt; have := a.toNat_lt
  simp only [prysmSmDesc, PSm.toValue, serialize, serializeStruct, serializeFields, Vector.toArray_mk, hr, hz]
  simp (config := {decide := true}) [*, bind, Except.bind, pure, Except.pure, assemble, headWidth, bodyWidth,
    headOf, bodiesOf, Desc.isFixed, Desc.fixedSize, Spec.uintBytes_size, bytesPerOffset, psmEnc,
    Desc.fieldsFixedSize, Array.append_assoc]

/-- **Spec roundtrip.** -/
theorem psm_roundtrip (g : PSm) : deserialize prysmSmDesc (psmEnc g) = .ok g.toValue :=
  deserialize_enc (G := PSm) (toV := PSm.toValue) (enc := psmEnc) prysmSmDesc_wellFormed psm_serialize
    psm_toValue_fits g

theorem psm_accepted_is_enc {bs : Array UInt8} {v : Value} (h : deserialize prysmSmDesc bs = .ok v) :
    ∃ g : PSm, v = g.toValue ∧ bs = psmEnc g :=
  accepted_is_enc (G := PSm) (toV := PSm.toValue) (enc := psmEnc) prysmSmDesc_wellFormed psm_serialize
    psm_toValue_surjective' h

/-- **EthLib accepts exactly the 144-byte inputs.** -/
theorem psm_spec_accepts_iff (bs : Array UInt8) : (∃ v, deserialize prysmSmDesc bs = .ok v) ↔ bs.size = 144 := by
  constructor
  · rintro ⟨v, hd⟩
    obtain ⟨g, rfl, hb⟩ := psm_accepted_is_enc hd
    rw [hb]; exact psm_enc_size g
  · intro h
    have r0 := readUint_lt bs 0 8
    have r1 := readUint_lt bs 40 8
    simp only [Nat.reducePow, Nat.reduceMul] at r0 r1
    let g : PSm := ⟨UInt64.ofNat (readUint bs 0 8), ⟨bs.extract 8 40, by simp; omega⟩,
      UInt64.ofNat (readUint bs 40 8), ⟨bs.extract 48 144, by simp; omega⟩⟩
    have e : bs = psmEnc g := by
      simp only [g, psmEnc, UInt64.toNat_ofNat_of_lt' r0, UInt64.toNat_ofNat_of_lt' r1,
        uintBytes_readUint_slice bs 0 8 (by omega), uintBytes_readUint_slice bs 40 8 (by omega)]
      simp only [Nat.zero_add, Nat.reduceAdd]
      simp (config := {decide := true}) only [Array.extract_append_extract, Nat.min_def, Nat.max_def, ↓reduceIte]
      rw [← h]; simp
    rw [e]
    exact ⟨_, psm_roundtrip g⟩

/-- `len(buf) ≠ 144`: EthLib rejects. -/
theorem psm_spec_rejects (bs : Array UInt8) (h : bs.size ≠ 144) : ∃ e, deserialize prysmSmDesc bs = .error e := by
  cases hd : deserialize prysmSmDesc bs with
  | error e => exact ⟨e, rfl⟩
  | ok v => exact absurd ((psm_spec_accepts_iff bs).mp ⟨v, hd⟩) h

/-! ### The checker Desc decodes like the hand Desc (accepted inputs and values) -/

theorem smChecker_wellFormed : smCheckerDesc.wellFormed = .ok () := by rfl

theorem psm_serialize_checker (g : PSm) : serialize smCheckerDesc g.toValue = .ok (psmEnc g) := by
  rw [← prysmSmDesc_serialize_checker]; exact psm_serialize g

theorem psm_toValue_fits_checker (g : PSm) : Value.fits smCheckerDesc g.toValue = true := by
  have := g.slot.toNat_lt; have := g.validatorIndex.toNat_lt
  simp [smCheckerDesc, PSm.toValue, Value.fits, Value.fieldsFit]; omega

/-- **Codec equality on the accepted inputs**. -/
theorem prysmSmDesc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize prysmSmDesc bs = .ok v ↔ deserialize smCheckerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := psm_accepted_is_enc h
    rw [hb]
    exact deserialize_enc (G := PSm) (toV := PSm.toValue) (enc := psmEnc) smChecker_wellFormed
      psm_serialize_checker psm_toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := PSm) (toV := PSm.toValue) (enc := psmEnc) smChecker_wellFormed
      psm_serialize_checker (psm_toValue_surjective _ (.inr rfl)) h
    rw [hb]; exact psm_roundtrip g

end E2e
