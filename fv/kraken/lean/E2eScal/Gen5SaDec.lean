    (kS : Nat) (hkS : E2eAd.Code.SlUnmarshal.IsInfixAt Host.prog kS) (hfS : LabelsFresh E2eAd.Code.SlUnmarshal kS)
    (fv0 fv1 : List UInt8) (hfv0 : fv0.length = 8) (hfv1 : fv1.length = 8)
    (s : MachineData) (ra guard : UInt64)
    (fp s1 s2 sp1 rslot lo ast aN0 aN1 : List UInt8)
    (hfp : fp.length = 8) (hs1 : s1.length = 8) (hs2 : s2.length = 8) (hsp1 : sp1.length = 8) (hrslot : rslot.length = 8) (hlo : lo.length = 8) (hast : ast.length = 8) (haN0 : aN0.length = 8) (haN1 : aN1.length = 8)
    (R : DataMem → Prop)
    (hguard : guard.toNat + 72 < s.regs.rsp.toNat) (st0 : MachineState),
    (st0.pc = Host.addrOf (k + 14)
        ∧ st0.data.regs.rsp = { toBitVec := s.regs.rsp.toBitVec - 64 }
        ∧ st0.data.regs.rbp = { toBitVec := s.regs.rsp.toBitVec - 8 }
        ∧ st0.data.regs.r14 = s.regs.r14
        ∧ st0.data.regs.get64 Reg64.rax = s.regs.rax.toBitVec
        ∧ st0.data.regs.get64 Reg64.rbx = s.regs.rbx.toBitVec ∧
        
        (Eq ((Int.toBytes 8 ra.toBitVec.toInt).At s.regs.rsp.toBitVec)
          ⋆ Eq ((Int.toBytes 8 s.regs.rbp.toBitVec.toInt).At (s.regs.rsp.toBitVec - 8))
          ⋆ Eq ((Int.toBytes 8 s.regs.rax.toBitVec.toInt).At (s.regs.rsp.toBitVec + 8))
          ⋆ Eq ((Int.toBytes 8 s.regs.rbx.toBitVec.toInt).At (s.regs.rsp.toBitVec + 16))
          ⋆ Eq (sp1.At (s.regs.rsp.toBitVec - 56))
          ⋆ Eq (rslot.At (s.regs.rsp.toBitVec - 72))
          ⋆ Eq (lo.At (s.regs.rsp.toBitVec - 80))
          ⋆ Eq ((Int.toBytes 8 guard.toBitVec.toInt).At (s.regs.r14.toBitVec + 16))
          ⋆ Eq (fv0.At s.regs.rbx.toBitVec)
          ⋆ Eq (fv1.At (s.regs.rbx.toBitVec + 8))
          ⋆ Eq (ast.At s.regs.rax.toBitVec)
          ⋆ Eq (aN0.At (s.regs.rax.toBitVec + 8))
          ⋆ Eq (aN1.At (s.regs.rax.toBitVec + 16))
          ⋆ R) st0.data.dmem) →
    Eventually (step1 Host.exe)
      (fun st => st.pc = Host.addrOf (k + 48)
        ∧ st.data.regs.rsp = { toBitVec := s.regs.rsp.toBitVec - 64 }
        ∧ st.data.regs.rbp = { toBitVec := s.regs.rsp.toBitVec - 8 }
        ∧ st.data.regs.r14 = s.regs.r14
        ∧ st.data.regs.get64 Reg64.rax = 0
        ∧ st.data.regs.get64 Reg64.rbx = 0 ∧
        ∃ (x0 x1 : List UInt8), x0.length = 8 ∧ x1.length = 8 ∧ 
        (Eq ((Int.toBytes 8 ra.toBitVec.toInt).At s.regs.rsp.toBitVec)
          ⋆ Eq ((Int.toBytes 8 s.regs.rbp.toBitVec.toInt).At (s.regs.rsp.toBitVec - 8))
          ⋆ Eq ((Int.toBytes 8 s.regs.rax.toBitVec.toInt).At (s.regs.rsp.toBitVec + 8))
          ⋆ Eq ((Int.toBytes 8 s.regs.rbx.toBitVec.toInt).At (s.regs.rsp.toBitVec + 16))
          ⋆ Eq (x0.At (s.regs.rsp.toBitVec - 56))
          ⋆ Eq ((Int.toBytes 8 (Host.addrOf (k + 18)).toBitVec.toInt).At (s.regs.rsp.toBitVec - 72))
          ⋆ Eq (x1.At (s.regs.rsp.toBitVec - 80))
          ⋆ Eq ((Int.toBytes 8 guard.toBitVec.toInt).At (s.regs.r14.toBitVec + 16))
          ⋆ Eq (fv0.At s.regs.rbx.toBitVec)
          ⋆ Eq (fv1.At (s.regs.rbx.toBitVec + 8))
          ⋆ Eq (ast.At s.regs.rax.toBitVec)
          ⋆ Eq (fv0.At (s.regs.rax.toBitVec + 8))
          ⋆ Eq (aN1.At (s.regs.rax.toBitVec + 16))
          ⋆ R) st.data.dmem)
      st0 := by
  intro k hk hf kS hkS hfS fv0 fv1 hfv0 hfv1 s ra guard fp s1 s2 sp1 rslot lo ast aN0 aN1 hfp hs1 hs2 hsp1 hrslot hlo hast haN0 haN1 R hguard
  obtain ⟨⟨rax, rbx, rcx, rdx, rsi, rdi, rsp, rbp, r8, r9, r10, r11, r12, r13, r14, r15⟩, zmms, flags, mem⟩ := s
  simp only at hguard ⊢
  rintro ⟨d, pc⟩ ⟨hpc, hrsp, hrbp, hr14, hrrax, hrrbx, Hm⟩
  dsimp only at hpc hrsp hrbp hr14 hrrax hrrbx Hm
  subst hpc
  obtain ⟨⟨rax1, rbx1, rcx1, rdx1, rsi1, rdi1, rsp1, rbp1, r81, r91, r101, r111, r121, r131, r141, r151⟩, zmms1, flags1, mem1⟩ := d
  simp only [Reg64s.get64] at hrsp hrbp hr14 hrrax hrrbx Hm
  subst rsp1 rbp1 r141
  obtain rfl : rax = rax1 := (UInt64.toBitVec_inj.mp hrrax).symm
  obtain rfl : rbx = rbx1 := (UInt64.toBitVec_inj.mp hrrbx).symm
  have hC := sl_uacc_holds kS hkS hfS
  have hg : guard.toNat < (rsp.toBitVec - 72).toNat := by
    have hgd : guard.toNat + 72 < rsp.toBitVec.toNat := hguard
    bv_omega
  apply Gen.sa_g5dec_s14 k hk hf
  intro fl14; kn
  apply Gen.sa_g5dec_s15 k hk hf
  kn
  refine eventually_trans _ _ _ _ (Gen.sa_g5dec_Slot_call k hk hf hC (rsp.toBitVec - 64) (rax.toBitVec + 8) rbx.toBitVec
    (rsp.toBitVec - 72) (rsp.toBitVec - 80) (rsp.toBitVec - 56) (by bv_omega) (by bv_omega) (by bv_omega)
    { toBitVec := rsp.toBitVec - 8#64 } r14 guard fv0 rslot lo sp1 aN0
    hfv0 hrslot hlo hsp1 haN0 hg _ _
    (by rfl) (by rfl) (by rfl) (by rfl) (by rfl) (by first | rfl | decide) (by ecancel)) ?_
  rintro ⟨d', pc'⟩ ⟨hpc', hrax', hrbx', hrsp', hrbp', hr14', Hm'⟩
  dsimp only at hpc' hrax' hrbx' hrsp' hrbp' hr14' Hm'
  apply Eventually.done
  refine ⟨hpc', hrsp', hrbp', hr14', (congrArg UInt64.toBitVec hrax'), (congrArg UInt64.toBitVec hrbx'), (Int.toBytes 8 rbx.toBitVec.toInt), (Int.toBytes 8 (rsp.toBitVec - 8#64).toInt),
    (Int.toBytes_length 8 _), (Int.toBytes_length 8 _), ?_⟩
  dsimp only
  rw [show k + 17 + 1 = k + 18 from rfl] at Hm'
  ecancel
theorem sa_g5dec_f1_kind : ∀ (h : Host), type_of% (@sa_g5dec_f1 h)
    = @E2eScal.decFieldKindN h SaUnmarshal (E2eScal.DecLayout.mk [E2eAd.Code.SlUnmarshal] 6
      [(0, 8), (1, 8), (2, 8), (3, 8), (4, 8), (5, 8)]
      [.at (.dn 8) (.orig 0), .at (.up 8) (.orig 1), .at (.up 16) (.orig 2), .at (.dn 56) (.orig 3), .at (.dn 72) (.orig 4), .at (.dn 80) (.orig 5)]
      (none) 72 true [.n 8, .n 8]
      [.at (.dn 8) (.reg .rbp), .at (.up 8) (.reg .rax), .at (.up 16) (.reg .rbx), .at (.dn 56) (.ex 0), .at (.dn 72) (.ret 18), .at (.dn 80) (.ex 1)]
      64) [.u64, .u64]
    ⟨14, 0, [(.rax, .rcv), (.rbx, .bf)],
      [.at (.dn 8) (.reg .rbp), .at (.up 8) (.reg .rax), .at (.up 16) (.reg .rbx), .at (.dn 56) (.orig 3), .at (.dn 72) (.orig 4), .at (.dn 80) (.orig 5)],
      []⟩
    ⟨48, 1, [(.rax, .zero), (.rbx, .zero)],
      [.at (.dn 8) (.reg .rbp), .at (.up 8) (.reg .rax), .at (.up 16) (.reg .rbx), .at (.dn 56) (.ex 0), .at (.dn 72) (.ret 18), .at (.dn 80) (.ex 1)],
      [.n 8, .n 8]⟩ := by
  intro h; rfl

