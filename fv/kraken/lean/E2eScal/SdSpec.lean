import Prysm.Checkpoint.Spec
import Prysm.Checkpoint.SpecEquivalence
import E2eScal.SdDesc
import E2eScal.SdSpecChecker

/-!
# Spec bridge for the real Prysm `v1alpha1.SigningData`

Hand-written (the shape of `PbSpec.lean` without its uint256 field, and the codec equality of
`PcSpec.lean`). `prysmSdDesc` (`SdDesc.lean`) is the independent hand `Desc` from consensus-specs; it was
committed before `sdCheckerDesc` was rendered and printed. `sdCheckerDesc` (generated by `gen/e2e/descterm.py`) is
the Desc checker's Desc of `(v1alpha1, SigningData)` (producer output = the checker record in
`gen/desc/results/main.result.json`, same sha256; copy in `prysm/go1.26.10/e2e/g5c/`).
`PSd` is the SSZ content of a Go `v1alpha1.SigningData`: two 32-byte roots.
-/

namespace E2e
open EthLib.Serialization.Ssz Spec

/-- The checker's Desc has the same kinds in the same order; only the names differ. -/
theorem prysmSdDesc_checker :
    prysmSdDesc = .container ["object_root", "domain"] [.byteVector 32, .byteVector 32]
    ∧ sdCheckerDesc = .container ["ObjectRoot", "Domain"] [.byteVector 32, .byteVector 32] :=
  ⟨rfl, rfl⟩

theorem prysmSdDesc_wellFormed : prysmSdDesc.wellFormed = .ok () := by rfl
theorem prysmSdDesc_fixedSize : prysmSdDesc.fixedSize = some 64 := by rfl
theorem sdChecker_wellFormed : sdCheckerDesc.wellFormed = .ok () := by rfl

/-- EthLib's `serialize` ignores container names. -/
theorem prysmSdDesc_serialize_checker (v : Value) : serialize prysmSdDesc v = serialize sdCheckerDesc v := by
  unfold prysmSdDesc sdCheckerDesc
  cases v <;> (try simp only [serialize, serializeStruct]) <;> rfl

/-- The SSZ content of a Go `v1alpha1.SigningData` (two 32-byte roots). -/
structure PSd where
  objectRoot : Vector UInt8 32
  domain : Vector UInt8 32

def PSd.toValue (g : PSd) : Value :=
  .seq [.bytes g.objectRoot.toArray, .bytes g.domain.toArray]

/-- `objectRoot ++ domain`. -/
def psdEnc (g : PSd) : Array UInt8 :=
  g.objectRoot.toArray ++ g.domain.toArray

theorem psd_enc_size (g : PSd) : (psdEnc g).size = 64 := by
  simp [psdEnc]

theorem psd_toValue_fits (g : PSd) : Value.fits prysmSdDesc g.toValue = true := by
  simp [prysmSdDesc, PSd.toValue, Value.fits, Value.fieldsFit]

theorem psd_toValue_fits_checker (g : PSd) : Value.fits sdCheckerDesc g.toValue = true := by
  simp [sdCheckerDesc, PSd.toValue, Value.fits, Value.fieldsFit]

theorem psd_toValue_injective (g h : PSd) (e : g.toValue = h.toValue) : g = h := by
  obtain ⟨p, r⟩ := g; obtain ⟨p', r'⟩ := h
  simp only [PSd.toValue, Value.seq.injEq, List.cons.injEq, Value.bytes.injEq, and_true] at e
  obtain ⟨e0, e1⟩ := e
  rw [Vector.toArray_inj.mp e0, Vector.toArray_inj.mp e1]

theorem psd_toValue_surjective (D : Desc)
    (hD : D = prysmSdDesc ∨ D = sdCheckerDesc) (v : Value) (h : Value.fits D v = true) :
    ∃ g : PSd, g.toValue = v := by
  have h' : Value.fits prysmSdDesc v = true := by
    rcases hD with rfl | rfl
    · exact h
    · cases v <;> simp_all [prysmSdDesc, sdCheckerDesc, Value.fits]
  obtain ⟨vs, rfl, hf⟩ := fits_container h'
  have hl := fieldsFit_length hf
  match vs, hl with
  | [v0, v1], _ =>
    simp only [fieldsFit_cons] at hf
    obtain ⟨h0, h1, -⟩ := hf
    obtain ⟨q, rfl, hq⟩ : ∃ d, v0 = .bytes d ∧ d.size = 32 := by
      cases v0 <;> simp [Value.fits] at h0 ⊢; exact h0
    obtain ⟨d, rfl, hd⟩ : ∃ d, v1 = .bytes d ∧ d.size = 32 := by
      cases v1 <;> simp [Value.fits] at h1 ⊢; exact h1
    exact ⟨⟨⟨q, hq⟩, ⟨d, hd⟩⟩, by simp [PSd.toValue]⟩

theorem psd_toValue_surjective' (v : Value) (h : Value.fits prysmSdDesc v = true) : ∃ g : PSd, g.toValue = v :=
  psd_toValue_surjective _ (.inl rfl) v h

/-- **`serialize g = objectRoot ‖ domain`.** -/
theorem psd_serialize (g : PSd) : serialize prysmSdDesc g.toValue = .ok (psdEnc g) := by
  obtain ⟨⟨q, hq⟩, ⟨r, hr⟩⟩ := g
  simp only [prysmSdDesc, PSd.toValue, serialize, serializeStruct, serializeFields, Vector.toArray_mk, hq, hr]
  simp (config := {decide := true}) [*, bind, Except.bind, pure, Except.pure, assemble, headWidth, bodyWidth,
    headOf, bodiesOf, Desc.isFixed, Desc.fixedSize, bytesPerOffset, psdEnc,
    Desc.fieldsFixedSize, Array.append_assoc]

/-- **Spec roundtrip.** -/
theorem psd_roundtrip (g : PSd) : deserialize prysmSdDesc (psdEnc g) = .ok g.toValue :=
  deserialize_enc (G := PSd) (toV := PSd.toValue) (enc := psdEnc) prysmSdDesc_wellFormed psd_serialize
    psd_toValue_fits g

theorem psd_accepted_is_enc {bs : Array UInt8} {v : Value} (h : deserialize prysmSdDesc bs = .ok v) :
    ∃ g : PSd, v = g.toValue ∧ bs = psdEnc g :=
  accepted_is_enc (G := PSd) (toV := PSd.toValue) (enc := psdEnc) prysmSdDesc_wellFormed psd_serialize
    psd_toValue_surjective' h

/-- **EthLib accepts exactly the 64-byte inputs.** -/
theorem psd_spec_accepts_iff (bs : Array UInt8) : (∃ v, deserialize prysmSdDesc bs = .ok v) ↔ bs.size = 64 := by
  constructor
  · rintro ⟨v, hd⟩
    obtain ⟨g, rfl, hb⟩ := psd_accepted_is_enc hd
    rw [hb]; exact psd_enc_size g
  · intro h
    let g : PSd := ⟨⟨bs.extract 0 32, by simp; omega⟩, ⟨bs.extract 32 64, by simp; omega⟩⟩
    have e : bs = psdEnc g := by
      simp only [g, psdEnc]
      simp (config := {decide := true}) only [Array.extract_append_extract, Nat.min_def, Nat.max_def, ↓reduceIte]
      rw [← h]; simp
    rw [e]
    exact ⟨_, psd_roundtrip g⟩

/-- `len(buf) ≠ 64`: EthLib rejects. -/
theorem psd_spec_rejects (bs : Array UInt8) (h : bs.size ≠ 64) : ∃ e, deserialize prysmSdDesc bs = .error e := by
  cases hd : deserialize prysmSdDesc bs with
  | error e => exact ⟨e, rfl⟩
  | ok v => exact absurd ((psd_spec_accepts_iff bs).mp ⟨v, hd⟩) h

/-! ### The checker Desc decodes like the hand Desc (accepted inputs and values) -/

theorem psd_serialize_checker (g : PSd) : serialize sdCheckerDesc g.toValue = .ok (psdEnc g) := by
  rw [← prysmSdDesc_serialize_checker]; exact psd_serialize g

/-- **Codec equality on the accepted inputs**. -/
theorem prysmSdDesc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize prysmSdDesc bs = .ok v ↔ deserialize sdCheckerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := psd_accepted_is_enc h
    rw [hb]
    exact deserialize_enc (G := PSd) (toV := PSd.toValue) (enc := psdEnc) sdChecker_wellFormed
      psd_serialize_checker psd_toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := PSd) (toV := PSd.toValue) (enc := psdEnc) sdChecker_wellFormed
      psd_serialize_checker (psd_toValue_surjective _ (.inr rfl)) h
    rw [hb]; exact psd_roundtrip g

end E2e
