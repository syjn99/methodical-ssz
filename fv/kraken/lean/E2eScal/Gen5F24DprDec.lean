    _ (k + 129) (k + 132) (win hk 129 3) (by rfl) (by rfl) hl
    _ (k + 133) (win hk 132 1) (by rfl) (by rfl) _ (win hk 133 2) (by rfl)
    s ra guard e0 e1 fp s2 hfp h2 R h_mem hguard (fun h => hlen (h.trans (by rfl)))
