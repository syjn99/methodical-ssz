import E2e.Spec
import E2e.SpecEq
import E2eScal.VbDesc
import E2eScal.VbSpecChecker

/-!
# Spec bridge for the real Prysm `v1alpha1.ValidatorBalance` (unit G5-C)

Written by the G5-C session: the text of `PcSpec.lean` (H5) with names changed (two uint64 fields).
`prysmVbDesc` (`VbDesc.lean`) is the independent hand `Desc` (Prysm proto); it was committed before
`vbCheckerDesc` was rendered and printed. `vbCheckerDesc` (generated by `gen/e2e/descterm.py`) is the Desc checker's
Desc of `(v1alpha1, ValidatorBalance)` (producer output = the checker record in `gen/desc/results/main.result.json`, same
sha256; copy in `prysm/go1.26.10/e2e/g5c/`).
`PVb` is the SSZ content of a Go `v1alpha1.ValidatorBalance` (two uint64 values).
-/

namespace E2e
open EthLib.Serialization.Ssz Fv1

/-- The checker's Desc has the same kinds in the same order; only the names differ. -/
theorem prysmVbDesc_checker :
    prysmVbDesc = .container ["index", "balance"]
      [.uint 8, .uint 8]
    ∧ vbCheckerDesc = .container ["Index", "Balance"]
      [.uint 8, .uint 8] :=
  ⟨rfl, rfl⟩

theorem prysmVbDesc_wellFormed : prysmVbDesc.wellFormed = .ok () := by rfl
theorem prysmVbDesc_fixedSize : prysmVbDesc.fixedSize = some 16 := by rfl

/-- EthLib's `serialize` ignores container names. -/
theorem prysmVbDesc_serialize_checker (v : Value) : serialize prysmVbDesc v = serialize vbCheckerDesc v := by
  unfold prysmVbDesc vbCheckerDesc
  cases v <;> (try simp only [serialize, serializeStruct]) <;> rfl

/-- The SSZ content of a Go `v1alpha1.ValidatorBalance` (two uint64 values). -/
structure PVb where
  index : UInt64
  balance : UInt64

def PVb.toValue (g : PVb) : Value :=
  .seq [.uint g.index.toNat, .uint g.balance.toNat]

/-- `uintBytes 8 index ++ uintBytes 8 balance`. -/
def pvbEnc (g : PVb) : Array UInt8 :=
  uintBytes 8 g.index.toNat ++ uintBytes 8 g.balance.toNat

theorem pvb_enc_size (g : PVb) : (pvbEnc g).size = 16 := by
  simp [pvbEnc, Fv.uintBytes_size]

theorem pvb_toValue_fits (g : PVb) : Value.fits prysmVbDesc g.toValue = true := by
  have := g.index.toNat_lt; have := g.balance.toNat_lt
  simp only [prysmVbDesc, PVb.toValue, Value.fits, Value.fieldsFit] at *
  simp; omega

theorem pvb_toValue_injective (g h : PVb) (e : g.toValue = h.toValue) : g = h := by
  obtain ⟨p, r⟩ := g; obtain ⟨p', r'⟩ := h
  simp only [PVb.toValue, Value.seq.injEq, List.cons.injEq, Value.uint.injEq, Value.bytes.injEq,
    and_true] at e
  obtain ⟨e0, e1⟩ := e
  rw [UInt64.toNat_inj.mp e0, UInt64.toNat_inj.mp e1]

theorem pvb_toValue_surjective (D : Desc)
    (hD : D = prysmVbDesc ∨ D = vbCheckerDesc) (v : Value) (h : Value.fits D v = true) :
    ∃ g : PVb, g.toValue = v := by
  have h' : Value.fits prysmVbDesc v = true := by
    rcases hD with rfl | rfl
    · exact h
    · cases v <;> simp_all [prysmVbDesc, vbCheckerDesc, Value.fits]
  obtain ⟨vs, rfl, hf⟩ := fits_container h'
  have hl := fieldsFit_length hf
  match vs, hl with
  | [v0, v1], _ =>
    simp only [fieldsFit_cons] at hf
    obtain ⟨h0, h1, -⟩ := hf
    obtain ⟨a0, rfl, ha0⟩ := fits_uint h0
    obtain ⟨a1, rfl, ha1⟩ := fits_uint h1
    simp only [Nat.reduceMul, Nat.reducePow] at ha0 ha1
    exact ⟨⟨UInt64.ofNat a0, UInt64.ofNat a1⟩,
      by simp [PVb.toValue, Nat.mod_eq_of_lt ha0, Nat.mod_eq_of_lt ha1]⟩

theorem pvb_toValue_surjective' (v : Value) (h : Value.fits prysmVbDesc v = true) : ∃ g : PVb, g.toValue = v :=
  pvb_toValue_surjective _ (.inl rfl) v h

/-- **`serialize g = index ‖ balance`.** -/
theorem pvb_serialize (g : PVb) : serialize prysmVbDesc g.toValue = .ok (pvbEnc g) := by
  obtain ⟨a0, a1⟩ := g
  have := a0.toNat_lt; have := a1.toNat_lt
  simp only [prysmVbDesc, PVb.toValue, serialize, serializeStruct, serializeFields, Vector.toArray_mk]
  simp (config := {decide := true}) [*, bind, Except.bind, pure, Except.pure, assemble, headWidth, bodyWidth,
    headOf, bodiesOf, Desc.isFixed, Desc.fixedSize, Fv.uintBytes_size, bytesPerOffset, pvbEnc,
    Desc.fieldsFixedSize, Array.append_assoc]

/-- **Spec roundtrip.** -/
theorem pvb_roundtrip (g : PVb) : deserialize prysmVbDesc (pvbEnc g) = .ok g.toValue :=
  deserialize_enc (G := PVb) (toV := PVb.toValue) (enc := pvbEnc) prysmVbDesc_wellFormed pvb_serialize
    pvb_toValue_fits g

theorem pvb_accepted_is_enc {bs : Array UInt8} {v : Value} (h : deserialize prysmVbDesc bs = .ok v) :
    ∃ g : PVb, v = g.toValue ∧ bs = pvbEnc g :=
  accepted_is_enc (G := PVb) (toV := PVb.toValue) (enc := pvbEnc) prysmVbDesc_wellFormed pvb_serialize
    pvb_toValue_surjective' h

/-- **EthLib accepts exactly the 16-byte inputs.** -/
theorem pvb_spec_accepts_iff (bs : Array UInt8) : (∃ v, deserialize prysmVbDesc bs = .ok v) ↔ bs.size = 16 := by
  constructor
  · rintro ⟨v, hd⟩
    obtain ⟨g, rfl, hb⟩ := pvb_accepted_is_enc hd
    rw [hb]; exact pvb_enc_size g
  · intro h
    have r0 := readUint_lt bs 0 8
    have r1 := readUint_lt bs 8 8
    simp only [Nat.reducePow, Nat.reduceMul] at r0 r1
    let g : PVb := ⟨UInt64.ofNat (readUint bs 0 8), UInt64.ofNat (readUint bs 8 8)⟩
    have e : bs = pvbEnc g := by
      simp only [g, pvbEnc, UInt64.toNat_ofNat_of_lt' r0, UInt64.toNat_ofNat_of_lt' r1,
        uintBytes_readUint_slice bs 0 8 (by omega), uintBytes_readUint_slice bs 8 8 (by omega)]
      simp only [Nat.zero_add, Nat.reduceAdd]
      simp (config := {decide := true}) only [Array.extract_append_extract, Nat.min_def, Nat.max_def, ↓reduceIte]
      rw [← h]; simp
    rw [e]
    exact ⟨_, pvb_roundtrip g⟩

/-- `len(buf) ≠ 16`: EthLib rejects. -/
theorem pvb_spec_rejects (bs : Array UInt8) (h : bs.size ≠ 16) : ∃ e, deserialize prysmVbDesc bs = .error e := by
  cases hd : deserialize prysmVbDesc bs with
  | error e => exact ⟨e, rfl⟩
  | ok v => exact absurd ((pvb_spec_accepts_iff bs).mp ⟨v, hd⟩) h

/-! ### The checker Desc decodes like the hand Desc (accepted inputs and values) -/

theorem vbChecker_wellFormed : vbCheckerDesc.wellFormed = .ok () := by rfl

theorem pvb_serialize_checker (g : PVb) : serialize vbCheckerDesc g.toValue = .ok (pvbEnc g) := by
  rw [← prysmVbDesc_serialize_checker]; exact pvb_serialize g

theorem pvb_toValue_fits_checker (g : PVb) : Value.fits vbCheckerDesc g.toValue = true := by
  have := g.index.toNat_lt; have := g.balance.toNat_lt
  simp [vbCheckerDesc, PVb.toValue, Value.fits, Value.fieldsFit]; omega

/-- **Codec equality on the accepted inputs**. -/
theorem prysmVbDesc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize prysmVbDesc bs = .ok v ↔ deserialize vbCheckerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := pvb_accepted_is_enc h
    rw [hb]
    exact deserialize_enc (G := PVb) (toV := PVb.toValue) (enc := pvbEnc) vbChecker_wellFormed
      pvb_serialize_checker pvb_toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := PVb) (toV := PVb.toValue) (enc := pvbEnc) vbChecker_wellFormed
      pvb_serialize_checker (pvb_toValue_surjective _ (.inr rfl)) h
    rw [hb]; exact pvb_roundtrip g

end E2e
