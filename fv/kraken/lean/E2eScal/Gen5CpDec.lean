          ⋆ Eq ((Int.toBytes 8 s.regs.rbp.toBitVec.toInt).At (s.regs.rsp.toBitVec - 8))
          ⋆ Eq ((Int.toBytes 8 s.regs.rax.toBitVec.toInt).At (s.regs.rsp.toBitVec + 8))
          ⋆ Eq ((Int.toBytes 8 s.regs.rbx.toBitVec.toInt).At (s.regs.rsp.toBitVec + 16))
          ⋆ Eq (x0.At (s.regs.rsp.toBitVec - 88))
          ⋆ Eq ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt).At (s.regs.rsp.toBitVec - 48))
          ⋆ Eq ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt).At (s.regs.rsp.toBitVec - 40))
          ⋆ Eq ((Int.toBytes 8 p1.toInt).At (s.regs.rsp.toBitVec - 32))
          ⋆ Eq ((Int.toBytes 8 (Host.addrOf (k + 70)).toBitVec.toInt).At (s.regs.rsp.toBitVec - 96))
          ⋆ Eq (x1.At (s.regs.rsp.toBitVec - 104 - BitVec.ofNat 64 S))
          ⋆ Eq ((Int.toBytes 8 guard.toBitVec.toInt).At (s.regs.r14.toBitVec + 16))
          ⋆ Heap (avail - 32)
          ⋆ Eq (fv0.At s.regs.rbx.toBitVec)
          ⋆ Eq (fv1.At (s.regs.rbx.toBitVec + 8))
          ⋆ Eq (ast.At s.regs.rax.toBitVec)
          ⋆ Eq (fv0.At (s.regs.rax.toBitVec + 8))
          ⋆ Eq ((Int.toBytes 8 p1.toInt).At (s.regs.rax.toBitVec + 16))
          ⋆ Eq ((Int.toBytes 8 32).At (s.regs.rax.toBitVec + 24))
          ⋆ Eq ((Int.toBytes 8 32).At (s.regs.rax.toBitVec + 32))
          ⋆ Eq (fv1.At p1)
          ⋆ Eq ([0, 0, 0, 0].At (label "runtime.writeBarrier").toBitVec)
          ⋆ R) st.data.dmem)
      ⟨s, Host.addrOf k⟩ := by
  intro k hk hf kE hkE hfE fv0 fv1 hfv0 hfv1 s ra guard fp s1 s2 sp0 sp1 sp2 l28 l30 l38 rslot lo ast aN0 aP1 aL1 aC1 hfp hs1 hs2 hsp0 hsp1 hsp2 hl28 hl30 hl38 hrslot hast haN0 haP1 haL1 haC1 R S hS hlo Heap avail h_mem hguard hlen hav hms hmm
  refine eventually_trans _ _ _ _ (cp_g5dec_head k hk hf kE hkE hfE fv0 fv1 hfv0 hfv1 s ra guard fp s1 s2 sp0 sp1 sp2 l28 l30 l38 rslot lo ast aN0 aP1 aL1 aC1 hfp hs1 hs2 hsp0 hsp1 hsp2 hl28 hl30 hl38 hrslot hast haN0 haP1 haL1 haC1 R S hS hlo Heap avail h_mem hguard hlen hav hms hmm) ?_
  intro st0 h0
  refine eventually_trans _ _ _ _ (cp_g5dec_f1 k hk hf kE hkE hfE fv0 fv1 hfv0 hfv1 s ra guard fp s1 s2 sp0 sp1 sp2 l28 l30 l38 rslot lo ast aN0 aP1 aL1 aC1 hfp hs1 hs2 hsp0 hsp1 hsp2 hl28 hl30 hl38 hrslot hast haN0 haP1 haL1 haC1 R S hS hlo Heap avail hguard hav hms hmm st0 h0) ?_
  intro st1 h1
  refine eventually_trans _ _ _ _ (cp_g5dec_f2 k hk hf kE hkE hfE fv0 fv1 hfv0 hfv1 s ra guard fp s1 s2 sp0 sp1 sp2 l28 l30 l38 rslot lo ast aN0 aP1 aL1 aC1 hfp hs1 hs2 hsp0 hsp1 hsp2 hl28 hl30 hl38 hrslot hast haN0 haP1 haL1 haC1 R S hS hlo Heap avail hguard hav hms hmm st1 h1) ?_
  intro st2 h2
  exact cp_g5dec_epi k hk hf kE hkE hfE fv0 fv1 hfv0 hfv1 s ra guard fp s1 s2 sp0 sp1 sp2 l28 l30 l38 rslot lo ast aN0 aP1 aL1 aC1 hfp hs1 hs2 hsp0 hsp1 hsp2 hl28 hl30 hl38 hrslot hast haN0 haP1 haL1 haC1 R S hS hlo Heap avail st2 h2
