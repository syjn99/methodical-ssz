import E2eList.ScSpec
import E2eList.ScSpecChecker

/-!
# The hand `Desc` of SyncCommittee and the Desc checker's `Desc`

The text of the checker section of `E2eScal`'s `DdSpec.lean`. `scCheckerDesc` (`ScSpecChecker.lean`, generated by
`gen/e2e/lvdescterm.py` from the producer file whose sha256 is the checker record) has the same kinds in the same
order as `prysmScDesc`; only the field names differ. EthLib's codec ignores the names, so the two `Desc`s accept the
same inputs with the same values.
-/

namespace E2eList
open EthLib.Serialization.Ssz Spec TestTarget

theorem prysmScDesc_checker :
    prysmScDesc = .container ["pubkeys", "aggregate_pubkey"] [.vector (.byteVector 48) 512, .byteVector 48]
    ∧ scCheckerDesc = .container ["Pubkeys", "AggregatePubkey"] [.vector (.byteVector 48) 512, .byteVector 48] :=
  ⟨rfl, rfl⟩

theorem scChecker_wellFormed : scCheckerDesc.wellFormed = .ok () := by rfl

/-- EthLib's `serialize` ignores container names. -/
theorem prysmScDesc_serialize_checker (v : Value) : serialize prysmScDesc v = serialize scCheckerDesc v := by
  unfold prysmScDesc scCheckerDesc
  cases v <;> (try simp only [serialize, serializeStruct]) <;> rfl

theorem psc_serialize_checker (g : PSc) : serialize scCheckerDesc g.toValue = .ok (pscEnc g) := by
  rw [← prysmScDesc_serialize_checker]; exact psc_serialize g

theorem psc_toValue_fits_checker (g : PSc) : Value.fits scCheckerDesc g.toValue = true := by
  simp [scCheckerDesc, PSc.toValue, Value.fits, Value.fieldsFit, allFit_map_bv48]

theorem psc_toValue_surjective_checker (v : Value) (h : Value.fits scCheckerDesc v = true) :
    ∃ g : PSc, g.toValue = v := by
  have h' : Value.fits prysmScDesc v = true := by
    cases v <;> simp_all [prysmScDesc, scCheckerDesc, Value.fits]
  exact psc_toValue_surjective v h'

/-- **Codec equality on the accepted inputs.** -/
theorem prysmScDesc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize prysmScDesc bs = .ok v ↔ deserialize scCheckerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := psc_accepted_is_enc h
    rw [hb]
    exact deserialize_enc (G := PSc) (toV := PSc.toValue) (enc := pscEnc) scChecker_wellFormed
      psc_serialize_checker psc_toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := PSc) (toV := PSc.toValue) (enc := pscEnc) scChecker_wellFormed
      psc_serialize_checker psc_toValue_surjective_checker h
    rw [hb]; exact psc_roundtrip g

end E2eList
