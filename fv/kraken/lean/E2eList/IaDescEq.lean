import E2eList.IaSpec
import E2eList.IaSpecChecker

/-!
# The hand `Desc` of IndexedAttestation and the Desc checker's `Desc`

`iaCheckerDesc` (`IaSpecChecker.lean`, generated by `gen/e2e/lvdescterm.py` from the producer file whose sha256 is the
checker record) has the same kinds in the same order as `prysmIaDesc`; only the field names differ, also in the nested
AttestationData and Checkpoint containers. EthLib's codec ignores the names (`E2e.prysmAdDesc_serialize_checker` for
the nested part), so the two `Desc`s accept the same inputs with the same values. The text of `ScDescEq.lean` and of
the checker section of `E2eAd/Spec.lean`.
-/

namespace E2eList
open EthLib.Serialization.Ssz Fv1

theorem prysmIaDesc_checker :
    prysmIaDesc = .container ["attesting_indices", "data", "signature"]
      [.list (.uint 8) 2048, E2e.prysmAdDesc, .byteVector 96]
    ∧ iaCheckerDesc = .container ["AttestingIndices", "Data", "Signature"]
      [.list (.uint 8) 2048, E2e.adCheckerDesc, .byteVector 96] :=
  ⟨rfl, rfl⟩

theorem iaChecker_wellFormed : iaCheckerDesc.wellFormed = .ok () := by rfl

/-- EthLib's `serialize` ignores container names, also the nested ones. -/
theorem prysmIaDesc_serialize_checker (v : Value) : serialize prysmIaDesc v = serialize iaCheckerDesc v := by
  rw [prysmIaDesc_checker.1, prysmIaDesc_checker.2]
  cases v <;> simp only [serialize]
  rename_i vs
  simp only [serializeStruct]
  rw [E2e.serializeFields_congr _ [.list (.uint 8) 2048, E2e.adCheckerDesc, .byteVector 96] vs
    (.cons (fun _ => rfl) (.cons E2e.prysmAdDesc_serialize_checker (.cons (fun _ => rfl) .nil)))]
  rfl

theorem pia_serialize_checker (g : PIa) : serialize iaCheckerDesc g.toValue = .ok (piaEnc g) := by
  rw [← prysmIaDesc_serialize_checker]; exact pia_serialize g

theorem pia_toValue_fits_checker (g : PIa) : Value.fits iaCheckerDesc g.toValue = true := by
  have h1 := E2e.pad_toValue_fits_checker g.data
  have h2 := g.hidx
  rw [prysmIaDesc_checker.2]
  simp only [PIa.toValue, Value.fits, Value.fieldsFit]
  simp [h1, allFit_u64, h2]

theorem pia_toValue_surjective_checker (v : Value) (h : Value.fits iaCheckerDesc v = true) :
    ∃ g : PIa, g.toValue = v := by
  rw [prysmIaDesc_checker.2] at h
  obtain ⟨vs, rfl, hf⟩ := fits_container h
  have hl := fieldsFit_length hf
  match vs, hl with
  | [v0, v1, v2], _ =>
    simp only [fieldsFit_cons] at hf
    obtain ⟨h0, h1, h2, -⟩ := hf
    obtain ⟨es, rfl, hlen, hall⟩ : ∃ es, v0 = .seq es ∧ es.length ≤ 2048 ∧ Value.allFit (.uint 8) es = true := by
      cases v0 <;> simp [Value.fits] at h0 ⊢; exact h0
    obtain ⟨l, rfl⟩ := allFit_u64_inv es hall
    obtain ⟨d, rfl⟩ := E2e.pad_toValue_surjective_checker v1 h1
    obtain ⟨z, rfl, hz⟩ : ∃ d, v2 = .bytes d ∧ d.size = 96 := by
      cases v2 <;> simp [Value.fits] at h2 ⊢; exact h2
    exact ⟨⟨l, by simpa using hlen, d, ⟨z, hz⟩⟩, rfl⟩

/-- **Codec equality on the accepted inputs.** -/
theorem prysmIaDesc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize prysmIaDesc bs = .ok v ↔ deserialize iaCheckerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := pia_accepted_is_enc h
    rw [hb]
    exact deserialize_enc (G := PIa) (toV := PIa.toValue) (enc := piaEnc) iaChecker_wellFormed
      pia_serialize_checker pia_toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := PIa) (toV := PIa.toValue) (enc := piaEnc) iaChecker_wellFormed
      pia_serialize_checker pia_toValue_surjective_checker h
    rw [hb]; exact pia_roundtrip g

end E2eList
