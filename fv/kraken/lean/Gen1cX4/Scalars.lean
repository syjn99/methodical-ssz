theorem compose [Host] : compose_stmt := by
  intro kd hkd km hkm hfm s ra ra2 guard slot b0 b1 b2 b3 b4 c0 c1 c2 c3 c4 fp sp1 d0 d1 d2 d3 d4 pre hsl h0l h1l h2l h3l h4l g0 g1 g2 g3 g4 hfp hs1 hd0 hd1 hd2 hd3 hd4 dptr dlen cap hpre hcap2 hcap2' R0 h_mem hL37f hL3bf hlen hb4 hguard
  refine eventually_trans _ _ _ _ (accept kd hkd s ra slot b0 b1 b2 b3 b4 c0 c1 c2 c3 c4 hsl h0l h1l h2l h3l h4l
    g0 g1 g2 g3 g4 _ h_mem hL37f hL3bf hlen hb4) ?_
  rintro ⟨d', pc⟩ ⟨hpc, hrax, -, -, hr14, hm⟩
  refine Eventually.done _ ⟨hpc, hrax, fun m2 zm fl hupd => ?_⟩
  have hm2 := hupd _ (by ecancel)
  have hb' : b4 = [0] ∨ b4 = [1] := hb4
  refine eventually_trans _ _ _ _ (marshal km hkm hfm _ ra2 guard fp sp1 (Int.toBytes 8 s.regs.rbx.toBitVec.toInt)
    b0 b1 b2 b3 b4 d0 d1 d2 d3 d4 pre hfp hs1 (Int.toBytes_length 8 _) h0l h1l h2l h3l hd0 hd1 hd2 hd3 hd4 _
    (by dsimp only; rw [hr14]; ecancel)
    (by dsimp only; exact hguard) (by dsimp only; omega) (by dsimp only; exact hcap2') hb') ?_
  intro st' hh
  obtain ⟨e1, e2, e3, -, -, -, -, -, -, hm'⟩ := hh
  dsimp only at e2 e3 hm'
  exact Eventually.done _ ⟨e1, e2, e3, sep_true (by ecancel)⟩

