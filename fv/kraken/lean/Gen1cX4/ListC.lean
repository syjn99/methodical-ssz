  rdi : b.rdi = a.rdi
  rsp : b.rsp = a.rsp
  rbp : b.rbp = a.rbp
  r14 : b.r14 = a.r14

theorem Keep2.trans {a b c : Reg64s} (h1 : Keep2 a b) (h2 : Keep2 b c) : Keep2 a c :=
  ⟨h2.rax.trans h1.rax, h2.rbx.trans h1.rbx, h2.rdi.trans h1.rdi, h2.rsp.trans h1.rsp, h2.rbp.trans h1.rbp,
   h2.r14.trans h1.r14⟩

