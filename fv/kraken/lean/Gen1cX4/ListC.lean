  refine ⟨trivial, UInt64.toBitVec_inj.mp (by simp), UInt64.toBitVec_inj.mp (by simp),
    UInt64.toBitVec_inj.mp (by simp), trivial, ?_⟩
  refine sep_mono_right' (Q := ?Q) (fun _ _ => trivial) ?h
  case h => ecancel

end Gen1cX4.ListC
