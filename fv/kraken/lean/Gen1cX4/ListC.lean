    apply BitVec.eq_of_toNat_eq; simp [BitVec.toNat_add]; omega
  rw [hL4] at H4
  refine eventually_trans _ _ _ _ (lcm3_loop k hk hf (u64Bytes (gs[i]'hi).l).toList
