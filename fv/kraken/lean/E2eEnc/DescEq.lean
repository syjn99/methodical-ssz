import E2eEnc.SpecD
import E2eEnc.DcSpecChecker

/-!
# The hand `Desc` of DataColumnsByRootIdentifier and the Desc checker's `Desc`

`E2eList.dcCheckerDesc` (`DcSpecChecker.lean`, generated by `gen/e2e/lvdescterm.py` from the producer file whose sha256
`832fc183…` is the checker record in `gen/desc/results/main.result.json`) has the same kinds in the same order as
`prysmDcDesc`; only the field names differ. EthLib's codec ignores the names, so the two `Desc`s serialize every value
alike and accept the same inputs with the same values. The text of `E2eList/IaDescEq.lean`.
-/

namespace E2eEnc
open EthLib.Serialization.Ssz Fv1

theorem prysmDcDesc_checker :
    prysmDcDesc = .container ["block_root", "columns"] [.byteVector 32, .list (.uint 8) 128]
    ∧ E2eList.dcCheckerDesc = .container ["BlockRoot", "Columns"] [.byteVector 32, .list (.uint 8) 128] :=
  ⟨rfl, rfl⟩

theorem dcChecker_wellFormed : E2eList.dcCheckerDesc.wellFormed = .ok () := by rfl

/-- EthLib's `serialize` ignores container names. -/
theorem prysmDcDesc_serialize_checker (v : Value) : serialize prysmDcDesc v = serialize E2eList.dcCheckerDesc v := by
  rw [prysmDcDesc_checker.1, prysmDcDesc_checker.2]
  cases v <;> simp only [serialize]

theorem pdc_serialize_checker (g : PDc) : serialize E2eList.dcCheckerDesc g.toValue = .ok (pdcEnc g) := by
  rw [← prysmDcDesc_serialize_checker]; exact pdc_serialize g

theorem pdc_toValue_fits_checker (g : PDc) : Value.fits E2eList.dcCheckerDesc g.toValue = true := by
  have h2 := g.hcols
  rw [prysmDcDesc_checker.2]
  simp only [PDc.toValue, dcValue, Value.fits, Value.fieldsFit]
  simp [allFit_u64, h2]

theorem pdc_toValue_surjective_checker (v : Value) (h : Value.fits E2eList.dcCheckerDesc v = true) :
    ∃ g : PDc, g.toValue = v := by
  apply pdc_toValue_surjective
  rw [prysmDcDesc_checker.1]; rw [prysmDcDesc_checker.2] at h
  cases v <;> simp_all [Value.fits]

/-- **Codec equality on the accepted inputs.** -/
theorem prysmDcDesc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize prysmDcDesc bs = .ok v ↔ deserialize E2eList.dcCheckerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := pdc_accepted_is_enc h
    rw [hb]
    exact deserialize_enc (G := PDc) (toV := PDc.toValue) (enc := pdcEnc) dcChecker_wellFormed
      pdc_serialize_checker pdc_toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := PDc) (toV := PDc.toValue) (enc := pdcEnc) dcChecker_wellFormed
      pdc_serialize_checker pdc_toValue_surjective_checker h
    rw [hb]; exact pdc_roundtrip g

end E2eEnc
