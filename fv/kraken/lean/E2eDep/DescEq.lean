import E2eDep.Spec
import E2eDep.SpecChecker

/-!
# The hand `Desc` of Deposit and the Desc checker's `Desc`

The text of `E2eHb.HbDescEq`. `E2eList.depCheckerDesc` (`SpecChecker.lean`, generated by `gen/e2e/lvdescterm.py` from
the producer file whose sha256 `cd4b71f0…` is the checker record) has the same kinds in the same order as
`prysmDepDesc`; only the field names differ (also in the nested Deposit_Data container). EthLib's codec ignores the
names, so the two `Desc`s accept the same inputs with the same values.
-/

namespace E2eDep
open EthLib.Serialization.Ssz Spec TestTarget E2e E2eList E2eHb Codec.Segment

theorem prysmDepDesc_checker :
    prysmDepDesc = .container ["proof", "data"] [.vector (.byteVector 32) 33, .container
      ["pubkey", "withdrawal_credentials", "amount", "signature"] [.byteVector 48, .byteVector 32, .uint 8, .byteVector 96]]
    ∧ depCheckerDesc = .container ["Proof", "Data"] [.vector (.byteVector 32) 33, .container
      ["PublicKey", "WithdrawalCredentials", "Amount", "Signature"] [.byteVector 48, .byteVector 32, .uint 8, .byteVector 96]] :=
  ⟨rfl, rfl⟩

theorem depChecker_wellFormed : depCheckerDesc.wellFormed = .ok () := by rfl

theorem dep_serialize_checker (g : PDep) : serialize depCheckerDesc g.toValue = .ok (depEnc g) := by
  obtain ⟨pr, d⟩ := g
  have hl1 := vN_flatten_length 33 pr
  have hs1 := vN_serialize 33 (by decide) pr
  have hs2 := pdd_serialize_checker d
  have hl2 := pdd_enc_size d
  simp only [ddCheckerDesc] at hs2
  simp only [depCheckerDesc, PDep.toValue, serialize, serializeStruct, serializeFields] at hs1 ⊢
  simp only [List.length_map, Vector.length_toList, beq_self_eq_true, ↓reduceIte] at hs1 ⊢
  rw [hs1, hs2]
  simp (config := {decide := true}) [bind, Except.bind, pure, Except.pure, assemble, headWidth, bodyWidth,
    headOf, bodiesOf, Desc.isFixed, Desc.fixedSize, bytesPerOffset, depEnc, PDep.proofs, Desc.fieldsFixedSize,
    Array.append_assoc, hl1, hl2]

theorem dep_toValue_fits_checker (g : PDep) : Value.fits depCheckerDesc g.toValue = true := by
  have h := pdd_toValue_fits_checker g.data
  simp only [ddCheckerDesc] at h
  simp [depCheckerDesc, PDep.toValue, Value.fits, Value.fieldsFit, allFit_map_bv32, h]

theorem dep_toValue_surjective_checker (v : Value) (h : Value.fits depCheckerDesc v = true) :
    ∃ g : PDep, g.toValue = v := by
  have hr : ∀ w : Value, Value.fits (.container ["PublicKey", "WithdrawalCredentials", "Amount", "Signature"]
      [.byteVector 48, .byteVector 32, .uint 8, .byteVector 96]) w = Value.fits (.container
      ["pubkey", "withdrawal_credentials", "amount", "signature"] [.byteVector 48, .byteVector 32, .uint 8,
      .byteVector 96]) w := by
    intro w; cases w <;> simp [Value.fits]
  have h' : Value.fits prysmDepDesc v = true := by
    cases v <;> simp_all [prysmDepDesc, depCheckerDesc, prysmDdDesc, Value.fits]
    rename_i es
    rcases es with _ | ⟨e0, _ | ⟨e1, _ | _⟩⟩ <;> simp_all [Value.fieldsFit]
  exact dep_toValue_surjective v h'

/-- **Codec equality on the accepted inputs.** -/
theorem prysmDepDesc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize prysmDepDesc bs = .ok v ↔ deserialize depCheckerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := dep_accepted_is_enc h
    rw [hb]
    exact deserialize_enc (G := PDep) (toV := PDep.toValue) (enc := depEnc) depChecker_wellFormed
      dep_serialize_checker dep_toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := PDep) (toV := PDep.toValue) (enc := depEnc) depChecker_wellFormed
      dep_serialize_checker dep_toValue_surjective_checker h
    rw [hb]; exact dep_roundtrip g

end E2eDep
