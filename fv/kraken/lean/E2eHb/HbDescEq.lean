import E2eHb.HbSpec
import E2eHb.HbSpecChecker

/-!
# The hand `Desc` of HistoricalBatch and the Desc checker's `Desc`

The text of `E2eList.ScDescEq`. `E2eList.hbCheckerDesc` (`HbSpecChecker.lean`, generated by
`gen/e2e/lvdescterm.py` from the producer file whose sha256 is the checker record) has the same kinds in the same
order as `prysmHbDesc`; only the field names differ. EthLib's codec ignores the names, so the two `Desc`s accept the
same inputs with the same values.
-/

namespace E2eHb
open EthLib.Serialization.Ssz Spec TestTarget E2eList

theorem prysmHbDesc_checker :
    prysmHbDesc = .container ["block_roots", "state_roots"] [.vector (.byteVector 32) 8192, .vector (.byteVector 32) 8192]
    ∧ hbCheckerDesc = .container ["BlockRoots", "StateRoots"]
      [.vector (.byteVector 32) 8192, .vector (.byteVector 32) 8192] :=
  ⟨rfl, rfl⟩

theorem hbChecker_wellFormed : hbCheckerDesc.wellFormed = .ok () := by rfl

/-- EthLib's `serialize` ignores container names. -/
theorem prysmHbDesc_serialize_checker (v : Value) : serialize prysmHbDesc v = serialize hbCheckerDesc v := by
  unfold prysmHbDesc hbCheckerDesc
  cases v <;> (try simp only [serialize, serializeStruct]) <;> rfl

theorem phb_serialize_checker (g : PHb) : serialize hbCheckerDesc g.toValue = .ok (phbEnc g) := by
  rw [← prysmHbDesc_serialize_checker]; exact phb_serialize g

theorem phb_toValue_fits_checker (g : PHb) : Value.fits hbCheckerDesc g.toValue = true := by
  simp [hbCheckerDesc, PHb.toValue, Value.fits, Value.fieldsFit, allFit_map_bv32]

theorem phb_toValue_surjective_checker (v : Value) (h : Value.fits hbCheckerDesc v = true) :
    ∃ g : PHb, g.toValue = v := by
  have h' : Value.fits prysmHbDesc v = true := by
    cases v <;> simp_all [prysmHbDesc, hbCheckerDesc, Value.fits]
  exact phb_toValue_surjective v h'

/-- **Codec equality on the accepted inputs.** -/
theorem prysmHbDesc_deserialize_checker (bs : Array UInt8) (v : Value) :
    deserialize prysmHbDesc bs = .ok v ↔ deserialize hbCheckerDesc bs = .ok v := by
  constructor
  · intro h
    obtain ⟨g, rfl, hb⟩ := phb_accepted_is_enc h
    rw [hb]
    exact deserialize_enc (G := PHb) (toV := PHb.toValue) (enc := phbEnc) hbChecker_wellFormed
      phb_serialize_checker phb_toValue_fits_checker g
  · intro h
    obtain ⟨g, rfl, hb⟩ := accepted_is_enc (G := PHb) (toV := PHb.toValue) (enc := phbEnc) hbChecker_wellFormed
      phb_serialize_checker phb_toValue_surjective_checker h
    rw [hb]; exact phb_roundtrip g

end E2eHb
