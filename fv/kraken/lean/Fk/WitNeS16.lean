import Fk.NeSize
import Fk.RtCopy
import Fk.WHost

/-!
# Premise witness of `ne_size_main`, L with 16 elements

Nested.SizeSSZ. The receiver is a full Go Nested object (A, S = nil, L) and
L a full ListU64 object (data pointer, 16, 16) with its data. Generated by
`tools/wit/wnes.py 16`.
-/

open Fk Fk.Code Fk.W

namespace Fk.WitNeS16

set_option maxRecDepth 100000

def dataLabels : Program :=
  [.label "runtime.writeBarrier", .label "pad1", .label "pad2", .label "pad3", .label "runtime.fvBump"]

def P : Program := dataLabels ++ NestedSizeSSZ

theorem P_len : P.length = 44 := by rfl

instance host : Host := mkHost P (by rw [P_len]; decide)

theorem prog_eq : Host.prog = P := rfl

theorem hk_target : NestedSizeSSZ.IsInfixAt Host.prog 5 :=
  infixAt_of dataLabels ([]) (by simp only [prog_eq, P, List.append_assoc, List.append_nil]) (rfl)

theorem hf_target : LabelsFresh NestedSizeSSZ 5 := labelsFresh_of (by rw [prog_eq]; decide)

abbrev z (k : Nat) : List UInt8 := List.replicate k 0

def block  : List UInt8 :=
  (Int.toBytes 8 (0 : UInt64).toBitVec.toInt) ++ ((z 8) ++ ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt) ++ ((z 8) ++ ((z 8) ++ ((Int.toBytes 8 (0x10030 : BitVec 64).toInt) ++ ((Int.toBytes 8 (0x10048 : BitVec 64).toInt) ++ ((Int.toBytes 8 (BitVec.ofNat 64 16).toInt) ++ ((Int.toBytes 8 (BitVec.ofNat 64 16).toInt) ++ ((z 128))))))))))

def mem  : DataMem := (block ).At (0x10000 : BitVec 64)

def s0  (zmms : RegZmms) (flags : StatusFlags) : MachineData :=
  ⟨⟨0x10018, 0, 0, 0, 0, 0, 0x10010, 0, 0, 0, 0, 0, 0, 0, 0xfff0, 0⟩, zmms, flags, mem ⟩

set_option maxHeartbeats 4000000 in
theorem s_mem   (zmms : RegZmms) (flags : StatusFlags) :
    let s := s0  zmms flags
    s.dmem =⋆ Eq ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt).At s.regs.rsp.toBitVec) ⋆ Eq ((z 8).At (s.regs.rsp.toBitVec - 8))
      ⋆ Eq ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt).At (s.regs.r14.toBitVec + 16))
      ⋆ Eq ((Int.toBytes 8 (0x10030 : BitVec 64).toInt).At (s.regs.rax.toBitVec + 16))
      ⋆ Eq ((Int.toBytes 8 (BitVec.ofNat 64 16).toInt).At ((0x10030 : BitVec 64) + 8)) ⋆ fun _ => True := by
  intro s
  have H : Eq ((block ).At (0x10000 : BitVec 64)) (mem ) := rfl
  wit_split
  simp only [s, s0, UInt64.toBitVec_ofNat, BitVec.ofNat_eq_ofNat, BitVec.reduceAdd, BitVec.reduceSub,
    Int64.toBitVec_ofNat, nil_At_emp, Std.ExtHashMap.sep_emp]
  apply sep_true (F := Eq (α := Std.ExtHashMap (BitVec 64) UInt8) ((z 8).At 65560#64) ⋆ Eq (α := Std.ExtHashMap (BitVec 64) UInt8) ((z 8).At 65568#64) ⋆ Eq (α := Std.ExtHashMap (BitVec 64) UInt8) ((Int.toBytes 8 (0x10048 : BitVec 64).toInt).At 65584#64) ⋆ Eq (α := Std.ExtHashMap (BitVec 64) UInt8) ((Int.toBytes 8 (BitVec.ofNat 64 16).toInt).At 65600#64) ⋆ Eq (α := Std.ExtHashMap (BitVec 64) UInt8) ((z 128).At 65608#64))
  simp only [u64_toBitVec_zero, u64_toBitVec_ofNat] at H ⊢
  try simp only [BitVec.ofNat_eq_ofNat, BitVec.reduceAdd] at H ⊢
  first | (refine Eq.mp ?_ H; exact congrFun (by ac_rfl) _) | ecancel

/-- **Non-vacuity of `ne_size_main`** (L with 16 elements). -/
theorem ne_size_runs (zmms : RegZmms) (flags : StatusFlags) :
    Eventually (step1 Host.exe)
      (fun st => st.pc = Int64.ofBitVec (0 : UInt64).toBitVec ∧ st.data.regs.rax.toNat = 32 + 8 * 16)
      ⟨s0 zmms flags, Host.addrOf 5⟩ :=
  eventually_mono (ne_size_main 5 hk_target hf_target (s0 zmms flags) 0 0 (z 8) rfl (0x10030 : BitVec 64) (by decide)
    16 (by decide) (fun _ => True) (s_mem zmms flags) (by simp [s0]))
    (fun _ h => ⟨h.1, h.2.1⟩)

end Fk.WitNeS16
