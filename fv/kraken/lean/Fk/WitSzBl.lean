import Fk.BlSpec
import Fk.RtCopy
import Fk.WHost

/-!
# Premise witness of `bl_size_main`

Host: data labels and the real target.BitL.SizeSSZ (index 5). Generated by `tools/wit/wsize.py`.
-/

open Fk Fk.Code Fk.W

namespace Fk.WitSzBl

set_option maxRecDepth 100000

def dataLabels : Program :=
  [.label "runtime.writeBarrier", .label "pad1", .label "pad2", .label "pad3", .label "runtime.fvBump"]

def P : Program := dataLabels ++ BitLSizeSSZ

theorem P_len : P.length = 9 := by rfl

instance host : Host := mkHost P (by rw [P_len]; decide)

theorem prog_eq : Host.prog = P := rfl

theorem hk_target : BitLSizeSSZ.IsInfixAt Host.prog 5 :=
  infixAt_of dataLabels ([]) (by simp only [prog_eq, P, List.append_assoc, List.append_nil]) (rfl)

theorem hf_target : LabelsFresh BitLSizeSSZ 5 := labelsFresh_of (by rw [prog_eq]; decide)

abbrev z (k : Nat) : List UInt8 := List.replicate k 0

def block  : List UInt8 :=
  (Int.toBytes 8 (0 : UInt64).toBitVec.toInt) ++ ((Int.toBytes 8 (0x10020 : BitVec 64).toInt) ++ ((Int.toBytes 8 (BitVec.ofNat 64 3).toInt) ++ ((Int.toBytes 8 (BitVec.ofNat 64 3).toInt) ++ ((z 3)))))

def mem  : DataMem := (block ).At (0x10000 : BitVec 64)

def s0  (zmms : RegZmms) (flags : StatusFlags) : MachineData :=
  ⟨⟨0x10008, 0, 0, 0, 0, 0, 0x10000, 0, 0, 0, 0, 0, 0, 0, 0, 0⟩, zmms, flags, mem ⟩

set_option maxHeartbeats 4000000 in
theorem s_mem   (zmms : RegZmms) (flags : StatusFlags) :
    let s := s0  zmms flags
    s.dmem =⋆ Eq ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt).At s.regs.rsp.toBitVec)
      ⋆ Eq ((Int.toBytes 8 (BitVec.ofNat 64 3).toInt).At (s.regs.rax.toBitVec + 8)) ⋆ fun _ => True := by
  intro s
  have H : Eq ((block ).At (0x10000 : BitVec 64)) (mem ) := rfl
  wit_split
  simp only [s, s0, UInt64.toBitVec_ofNat, BitVec.ofNat_eq_ofNat, BitVec.reduceAdd, BitVec.reduceSub,
    Int64.toBitVec_ofNat, nil_At_emp, Std.ExtHashMap.sep_emp]
  apply sep_true (F := Eq (α := Std.ExtHashMap (BitVec 64) UInt8) ((Int.toBytes 8 (0x10020 : BitVec 64).toInt).At 65544#64) ⋆ Eq (α := Std.ExtHashMap (BitVec 64) UInt8) ((Int.toBytes 8 (BitVec.ofNat 64 3).toInt).At 65560#64) ⋆ Eq (α := Std.ExtHashMap (BitVec 64) UInt8) ((z 3).At 65568#64))
  simp only [u64_toBitVec_zero, u64_toBitVec_ofNat] at H ⊢
  try simp only [BitVec.ofNat_eq_ofNat, BitVec.reduceAdd] at H ⊢
  first | (refine Eq.mp ?_ H; exact congrFun (by ac_rfl) _) | ecancel

/-- **Non-vacuity of `bl_size_main`.** -/
theorem bl_size_runs (zmms : RegZmms) (flags : StatusFlags) :
    Eventually (step1 Host.exe)
      (fun st => st.pc = Int64.ofBitVec (0 : UInt64).toBitVec ∧ st.data.regs.rax.toNat = 4 + 3)
      ⟨s0 zmms flags, Host.addrOf 5⟩ :=
  eventually_mono (bl_size_main 5 hk_target (s0 zmms flags) 0 3 (by decide) (fun _ => True) (s_mem zmms flags))
    (fun _ h => ⟨h.1, h.2.1⟩)

end Fk.WitSzBl
