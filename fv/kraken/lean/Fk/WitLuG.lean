set_option maxHeartbeats 8000000 in
/-- **Non-vacuity of `lum_grow_site`.** From a call-site state with cap < len + 4,
the code calls growslice (`rt_growslice`) and reaches directive 25 with a
capacity of at least 6 and `dst[:2]` copied. -/
theorem lum_grow_runs (zmms : RegZmms) (flags : StatusFlags) :
    Eventually (step1 Host.exe)
      (fun st => st.pc = Host.addrOf (5 + 25) ∧ 6 ≤ st.data.regs.rdi.toNat)
      ⟨s0 zmms flags, Host.addrOf (5 + 13)⟩ :=
  eventually_mono (lum_grow_site 5 hk_target hf_target [7, 7] (s0 zmms flags) (by simp [s0]) (by simp [s0])
    (z 8) (z 8) rfl rfl (by simp [s0]) (by simp [s0])
    (Eq ([0, 0, 0, 0].At (label "runtime.writeBarrier").toBitVec) ⋆ fun _ => True) 0 [] (z 40) rfl rfl bumpHeap 8216
    (by simp [s0]; decide) (by unfold maxAlloc; omega)
    (by have h := s_mem zmms flags; simp only [Std.ExtHashMap.sep_assoc] at h ⊢; exact h)
    (rt_growslice 96 hk_rtcopy hf_rtcopy _ 0))
    (fun _ h => ⟨h.1, by have := h.2.2.2.1; simpa [s0] using this⟩)

