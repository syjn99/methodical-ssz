import Fk.Vbv
import Fk.RtCopy
import Fk.WHost

/-!
# Direct premise witness of `vbv_accept_main`

Host: data labels and the real ssz.ValidateBitvector (index 5). One byte b
with b >>> 4 = 0, bits = 4. Generated by `tools/wit/wacc.py vbv`.
-/

open Fk Fk.Code Fk.W

namespace Fk.WitVbv

set_option maxRecDepth 100000

def dataLabels : Program :=
  [.label "runtime.writeBarrier", .label "pad1", .label "pad2", .label "pad3", .label "runtime.fvBump"]

def P : Program := dataLabels ++ ValidateBitvector

theorem P_len : P.length = 78 := by rfl

instance host : Host := mkHost P (by rw [P_len]; decide)

theorem prog_eq : Host.prog = P := rfl

theorem hk_target : ValidateBitvector.IsInfixAt Host.prog 5 :=
  infixAt_of dataLabels ([]) (by simp only [prog_eq, P, List.append_assoc, List.append_nil]) (rfl)

theorem hf_target : LabelsFresh ValidateBitvector 5 := labelsFresh_of (by rw [prog_eq]; decide)

abbrev z (k : Nat) : List UInt8 := List.replicate k 0

def block (b : UInt8) : List UInt8 :=
  (Int.toBytes 8 (0 : UInt64).toBitVec.toInt) ++ ((z 8) ++ ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt) ++ ((z 8) ++ ([b]))))

def mem (b : UInt8) : DataMem := (block b).At (0x10000 : BitVec 64)

def s0 (b : UInt8) (zmms : RegZmms) (flags : StatusFlags) : MachineData :=
  ⟨⟨0x10020, 1, 1, 0, 0, 4, 0x10010, 0, 0, 0, 0, 0, 0, 0, 0xfff0, 0⟩, zmms, flags, mem b⟩

set_option maxHeartbeats 32000000 in
theorem s_mem (b : UInt8)  (zmms : RegZmms) (flags : StatusFlags) :
    let s := s0 b zmms flags
    s.dmem =⋆ Eq ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt).At s.regs.rsp.toBitVec)
      ⋆ Eq ((z 8).At (s.regs.rsp.toBitVec - 8)) ⋆ Eq ((z 8).At (s.regs.rsp.toBitVec + 8))
      ⋆ Eq ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt).At (s.regs.r14.toBitVec + 16))
      ⋆ Eq ((([] : List UInt8) ++ [b]).At s.regs.rax.toBitVec) ⋆ fun _ => True := by
  intro s
  have H : Eq ((block b).At (0x10000 : BitVec 64)) (mem b) := rfl
  wit_split
  simp only [s, s0, UInt64.toBitVec_ofNat, BitVec.ofNat_eq_ofNat, BitVec.reduceAdd, BitVec.reduceSub,
    Int64.toBitVec_ofNat, nil_At_emp, Std.ExtHashMap.sep_emp]
  apply sep_true (F := Std.ExtHashMap.emp)
  simp only [Std.ExtHashMap.sep_emp]
  simp only [u64_toBitVec_zero, u64_toBitVec_ofNat] at H ⊢
  try simp only [BitVec.ofNat_eq_ofNat, BitVec.reduceAdd] at H ⊢
  refine Eq.mp ?_ H
  exact congrFun (by ac_rfl) _

/-- **Non-vacuity of `vbv_accept_main`** (direct, bits = 4). The function returns nil. -/
theorem vbv_accept_runs (b : UInt8) (hb : b.toNat >>> 4 = 0) (zmms : RegZmms) (flags : StatusFlags) :
    Eventually (step1 Host.exe)
      (fun st => st.pc = Int64.ofBitVec (0 : UInt64).toBitVec ∧ st.data.regs.rax = 0)
      ⟨s0 b zmms flags, Host.addrOf 5⟩ :=
  eventually_mono (vbv_accept_main 5 hk_target hf_target (s0 b zmms flags) 0 0 (z 8) (z 8) rfl rfl [] b
    (fun _ => True) (s_mem b zmms flags) (by simp [s0]) (by simp [s0]) (by simp [s0]) (by simp [s0])
    (by simp [s0]) (by simpa [s0] using hb))
    (fun _ h => ⟨h.1, h.2.1⟩)

end Fk.WitVbv
