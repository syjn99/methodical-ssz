    (fun _ => True) 8 (z 8) (z 24) rfl (by decide) rfl bumpHeap 8 (s_mem b zmms flags)
    (by simp [s0]) (by simp [s0]) rfl (by omega) (vbv_acc_holds 105 hk_fnVbv hf_fnVbv)
    (bump_makeslice1 178 hk_makeslice hf_makeslice _))
