/-!
# Premise witness of `bv_reject_size_main` (re-proof R6)

Host: data label 0 renamed to `ssz.ErrSize` (the error global at 0x10000), the real
target.BitVec.UnmarshalSSZ (index 5). Generated by `tools/wit/wrej.py`.
-/

open Fk Fk.Code Fk.W

namespace Fk.WitRjBvSz

def dataLabels : Program :=
  [.label "ssz.ErrSize", .label "pad1", .label "pad2", .label "pad3", .label "runtime.fvBump"]

def P : Program := dataLabels ++ BitVecUnmarshalSSZ

set_option maxRecDepth 100000 in
theorem P_len : P.length = 105 := by rfl

instance host : Host := mkHost P (by rw [P_len]; decide)

theorem prog_eq : Host.prog = P := rfl

theorem hk_target : BitVecUnmarshalSSZ.IsInfixAt Host.prog 5 := by
  rw [prog_eq]; exact ⟨[], by simp [P, dataLabels]⟩

set_option maxRecDepth 100000 in
theorem hf_target : LabelsFresh BitVecUnmarshalSSZ 5 := labelsFresh_of (by rw [prog_eq]; decide)

set_option maxRecDepth 100000 in
theorem label_err : label "ssz.ErrSize" = 0x10000 :=
  mk_label P _ 0 _ (by simp [P, dataLabels]) (by simp [labs])

abbrev z (k : Nat) : List UInt8 := List.replicate k 0

def block  : List UInt8 :=
  (Int.toBytes 8 (0 : UInt64).toBitVec.toInt) ++ ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt) ++ ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt) ++ ((z 8) ++ ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt) ++ ((z 8) ++ ((z 8)))))))

def mem  : DataMem := (block ).At (0x10000 : BitVec 64)

def s0  (zmms : RegZmms) (flags : StatusFlags) : MachineData :=
  ⟨⟨0, 0, 0, 0, 0, 0, 0x10020, 0, 0, 0, 0, 0, 0, 0, 0x10000, 0⟩, zmms, flags, mem ⟩

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 100000 in
theorem s_mem   (zmms : RegZmms) (flags : StatusFlags) :
    let s := s0  zmms flags
    s.dmem =⋆ Eq ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt).At s.regs.rsp.toBitVec)
      ⋆ Eq ((z 8).At (s.regs.rsp.toBitVec - 8)) ⋆ Eq ((z 8).At (s.regs.rsp.toBitVec + 16))
      ⋆ Eq ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt).At (s.regs.r14.toBitVec + 16))
      ⋆ Eq ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt).At (label "ssz.ErrSize").toBitVec)
      ⋆ Eq ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt).At (label "ssz.ErrSize" + 8).toBitVec)
      ⋆ Eq ((z 8).At (s.regs.rsp.toBitVec + 8)) ⋆ fun _ => True := by
  intro s
  have H : Eq ((block ).At (0x10000 : BitVec 64)) (mem ) := rfl
  conv at H => lhs; unfold block
  repeat rw [Mem.At_append_sep _ _ _ (by simp only [List.length_append, List.length_replicate, Int.toBytes_length, List.length_cons, List.length_nil]; omega)] at H
  simp only [List.length_replicate, Int.toBytes_length, List.length_cons, List.length_nil, Nat.reduceAdd,
    BitVec.ofNat_eq_ofNat, BitVec.reduceAdd] at H
  rw [label_err]
  simp only [Int64.toBitVec_add, Int64.toBitVec_ofNat, BitVec.reduceAdd]
  simp only [s, s0, UInt64.toBitVec_ofNat, BitVec.ofNat_eq_ofNat, BitVec.reduceAdd, BitVec.reduceSub,
    Int64.toBitVec_ofNat, nil_At_emp, Std.ExtHashMap.sep_emp]
  apply sep_true (F := Std.ExtHashMap.emp)
  simp only [Std.ExtHashMap.sep_emp]
  have hu0 : (UInt64.toBitVec 0) = 0#64 := rfl
  have huN : ∀ n : Nat, (UInt64.ofNat n).toBitVec = BitVec.ofNat 64 n := fun _ => rfl
  simp only [hu0, huN] at H ⊢
  refine Eq.mp ?_ H
  exact congrFun (by ac_rfl) _

/-- **Non-vacuity of `bv_reject_size_main`.** The decoder returns the error global. -/
theorem bv_reject_size_runs (zmms : RegZmms) (flags : StatusFlags) :
    Eventually (step1 Host.exe)
      (fun st => st.pc = Int64.ofBitVec (0 : UInt64).toBitVec ∧ st.data.regs.rax = 0)
      ⟨s0 zmms flags, Host.addrOf 5⟩ :=
  eventually_mono (bv_reject_size_main 5 hk_target hf_target (s0 zmms flags) 0 0 0 0 (z 8) (z 8) rfl rfl (Eq ((z 8).At ((s0 zmms flags).regs.rsp.toBitVec + 8)) ⋆ fun _ => True) (by have h := s_mem zmms flags; simp only [Std.ExtHashMap.sep_assoc] at h ⊢; exact h) (by simp [s0]) (by simp [s0]))
    (fun _ h => ⟨h.1, h.2.1⟩)

end Fk.WitRjBvSz
