/-- **Non-vacuity of `lc_size_main`** (4 elements, lengths [0, 1, 2, 16]). -/
theorem lc_size_runs (zmms : RegZmms) (flags : StatusFlags) :
    Eventually (step1 Host.exe)
      (fun st => st.pc = Int64.ofBitVec (0 : UInt64).toBitVec ∧ st.data.regs.rax.toNat = lcAcc [0, 1, 2, 16] 4)
      ⟨s0 zmms flags, Host.addrOf 5⟩ :=
  eventually_mono (lc_size_main 5 hk_target hf_target (0x10020 : BitVec 64) [(0x10040 : BitVec 64), (0x10058 : BitVec 64), (0x10070 : BitVec 64), (0x10088 : BitVec 64)] [0, 1, 2, 16] rfl (by decide) (by decide)
    (s0 zmms flags) 0 (fun _ => True) (s_mem zmms flags) (by intro i hi; simp only [List.length_cons, List.length_nil] at hi; match i, hi with | 0, _ => exact hall_0 zmms flags | 1, _ => exact hall_1 zmms flags | 2, _ => exact hall_2 zmms flags | 3, _ => exact hall_3 zmms flags | _ + 4, h => omega))
    (fun _ h => ⟨h.1, h.2.1⟩)

