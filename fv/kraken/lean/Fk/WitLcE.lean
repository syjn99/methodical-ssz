import Fk.LcAcceptEmpty
import Fk.RtCopy
import Fk.WHost

/-!
# Premise witness of `lc_accept_empty_main`

ListC.UnmarshalSSZ on the empty list (`buf = 4,0,0,0`). Host: data labels and
the real ListC.UnmarshalSSZ (index 5). X15 = 0 (Go ABIInternal): the default
vector registers satisfy it (`zmms0`). The holes go to the frame with
register-relative addresses. Generated by `tools/wit/wlce.py`.
-/

open Fk Fk.Code Fk.W

namespace Fk.WitLcE

set_option maxRecDepth 100000

def dataLabels : Program :=
  [.label "runtime.writeBarrier", .label "pad1", .label "pad2", .label "pad3", .label "runtime.fvBump"]

def P : Program := dataLabels ++ ListCUnmarshalSSZ

theorem P_len : P.length = 437 := by rfl

instance host : Host := mkHost P (by rw [P_len]; decide)

theorem prog_eq : Host.prog = P := rfl

theorem hk_target : ListCUnmarshalSSZ.IsInfixAt Host.prog 5 :=
  infixAt_of dataLabels ([]) (by simp only [prog_eq, P, List.append_assoc, List.append_nil]) (rfl)

theorem hf_target : LabelsFresh ListCUnmarshalSSZ 5 := labelsFresh_of (by rw [prog_eq]; decide)

theorem label_wb : label "runtime.writeBarrier" = 0x10000 :=
  mk_label P _ 0 _ (by simp [P, dataLabels]) (by simp [labs])

abbrev z (k : Nat) : List UInt8 := List.replicate k 0

def block  : List UInt8 :=
  [0, 0, 0, 0] ++ ((z 4) ++ ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt) ++ ((z 8) ++ ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt) ++ ((z 8) ++ ((z 8) ++ ([4, 0, 0, 0] ++ ((z 4) ++ ((z 8) ++ ((z 16)))))))))))

def mem  : DataMem := (block ).At (0x10000 : BitVec 64)

def s0  (zmms : RegZmms) (flags : StatusFlags) : MachineData :=
  ⟨⟨0x10038, 0x10030, 4, 0, 0, 4, 0x10018, 0, 0, 0, 0, 0, 0, 0, 0xfff8, 0⟩, zmms, flags, mem ⟩

set_option maxHeartbeats 32000000 in
theorem s_mem   (zmms : RegZmms) (flags : StatusFlags) :
    let s := s0  zmms flags
    s.dmem =⋆ Eq ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt).At s.regs.rsp.toBitVec)
      ⋆ Eq ((z 8).At (s.regs.rsp.toBitVec - 8)) ⋆ Eq ((z 8).At (s.regs.rsp.toBitVec + 16))
      ⋆ Eq ((Int.toBytes 8 (0 : UInt64).toBitVec.toInt).At (s.regs.r14.toBitVec + 16))
      ⋆ Eq ([4, 0, 0, 0].At s.regs.rbx.toBitVec)
      ⋆ Eq ((z 8).At s.regs.rax.toBitVec) ⋆ Eq ((z 16).At (s.regs.rax.toBitVec + 8))
      ⋆ Eq ([0, 0, 0, 0].At (label "runtime.writeBarrier").toBitVec) ⋆ Eq ((z 8).At (s.regs.rsp.toBitVec + 8)) ⋆ fun _ => True := by
  intro s
  have H : Eq ((block ).At (0x10000 : BitVec 64)) (mem ) := rfl
  wit_split
  rw [label_wb]
  simp only [s, s0, UInt64.toBitVec_ofNat, BitVec.ofNat_eq_ofNat, BitVec.reduceAdd, BitVec.reduceSub,
    Int64.toBitVec_ofNat, nil_At_emp, Std.ExtHashMap.sep_emp]
  apply sep_true (F := Eq (α := Std.ExtHashMap (BitVec 64) UInt8) ((z 4).At 65540#64) ⋆ Eq (α := Std.ExtHashMap (BitVec 64) UInt8) ((z 4).At 65588#64))
  simp only [u64_toBitVec_zero, u64_toBitVec_ofNat] at H ⊢
  try simp only [BitVec.ofNat_eq_ofNat, BitVec.reduceAdd] at H ⊢
  refine Eq.mp ?_ H
  exact congrFun (by ac_rfl) _

/-- **Non-vacuity of `lc_accept_empty_main`.** The decoder returns nil with
`c.Items = (zerobase, 0, 0)`. -/
theorem lc_accept_empty_runs (zmms : RegZmms) (flags : StatusFlags) (hz : zmms.get (AvxReg.xmm RegMm.mm15) = 0) :
    Eventually (step1 Host.exe)
      (fun st => st.pc = Int64.ofBitVec (0 : UInt64).toBitVec ∧ st.data.regs.rax = 0)
      ⟨s0 zmms flags, Host.addrOf 5⟩ :=
  eventually_mono (lc_accept_empty_main 5 hk_target hf_target (s0 zmms flags) 0 0 (z 8) (z 8) (z 8) (z 16) rfl rfl rfl rfl
    (Eq ((z 8).At ((s0 zmms flags).regs.rsp.toBitVec + 8)) ⋆ fun _ => True)
    (by have h := s_mem zmms flags; simp only [Std.ExtHashMap.sep_assoc] at h ⊢; exact h)
    (by simp [s0]) (by simp [s0]) (by simp [s0]) (by simp [s0]) (by simp [s0]) hz)
    (fun _ h => ⟨h.1, h.2.1⟩)

/-- The default vector registers (all zero) meet the X15 = 0 premise. -/
def zmms0 : RegZmms := {}
theorem zmms0_x15 : zmms0.get (AvxReg.xmm RegMm.mm15) = 0 := by
  simp [zmms0, RegZmms.get, RegZmms.get512, zmmZero, AvxReg.base, BitVec.take]

example (f : StatusFlags) := lc_accept_empty_runs zmms0 f zmms0_x15

end Fk.WitLcE
